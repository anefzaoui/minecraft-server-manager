---
import Site from '../../layouts/Site.astro';
import Section from '../../components/Section.astro';
import { localePaths, localeFromParams } from '../../lib/paths.js';
import { getCopy } from '../../i18n/index.js';
import { REPO_URL } from '../../lib/routes.js';
import { Content as Changelog } from '../../generated/changelog.md';

export function getStaticPaths() {
  return localePaths();
}
const locale = localeFromParams(Astro.params);
const copy = getCopy(locale);
---

<Site locale={locale} path="/changelog/" pageKey="changelog">
  <div class="hero">
    <Section title={copy.changelog.title} intro={copy.changelog.intro} class="pb-6">
      <p class="mt-6"><a class="btn" href={`${REPO_URL}/releases`} rel="noopener">{copy.changelog.releases}</a></p>
    </Section>
  </div>
  <Section class="pt-4">
    <article class="changelog prose-soft max-w-3xl" lang="en" dir="ltr">
      <Changelog />
    </article>
  </Section>
</Site>

<style is:global>
  .changelog h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
  }
  .changelog h3 {
    font-weight: 600;
    margin-top: 1.25rem;
    color: var(--color-ink);
  }
  .changelog p,
  .changelog ul {
    margin-top: 0.75rem;
  }
  .changelog ul {
    list-style: disc;
    padding-inline-start: 1.5rem;
  }
  .changelog li + li {
    margin-top: 0.4rem;
  }
</style>
