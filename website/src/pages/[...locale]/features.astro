---
import Site from '../../layouts/Site.astro';
import Section from '../../components/Section.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import Community from '../../components/Community.astro';
import Icon from '../../components/Icon.astro';
import { localePaths, localeFromParams } from '../../lib/paths.js';
import { getCopy } from '../../i18n/index.js';
import { href, SITE_URL } from '../../lib/routes.js';

export function getStaticPaths() {
  return localePaths();
}
const locale = localeFromParams(Astro.params);
const copy = getCopy(locale);
const tones = ['grass', 'sky', 'gold', 'stone'] as const;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.nav.home, item: new URL(href(locale, '/'), SITE_URL).href },
    { '@type': 'ListItem', position: 2, name: copy.nav.features, item: new URL(href(locale, '/features/'), SITE_URL).href },
  ],
};
---

<Site locale={locale} path="/features/" pageKey="features" jsonLd={[breadcrumb]}>
  <div class="hero">
    <Section title={copy.features.title} intro={copy.features.intro} class="pb-4" />
  </div>
  <Section class="pt-4">
    {copy.features.groups.map((g, gi) => (
      <div class="mt-10 first:mt-0">
        <h3 class="display text-2xl text-ink">{g.title}</h3>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {g.items.map((f) => <FeatureCard title={f.title} body={f.body} icon={f.icon} tone={tones[gi % 4]} />)}
        </ul>
      </div>
    ))}
    <p class="mt-12"><a class="btn btn-primary btn-lg" href={href(locale, '/docs/')}>{copy.features.cta}<Icon name="arrow" size={18} /></a></p>
  </Section>
  <Community copy={copy} />
</Site>
