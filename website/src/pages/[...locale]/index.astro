---
import { Image } from 'astro:assets';
import Site from '../../layouts/Site.astro';
import Section from '../../components/Section.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import Community from '../../components/Community.astro';
import InstallTutorial from '../../components/InstallTutorial.astro';
import Clouds from '../../components/Clouds.astro';
import XpDivider from '../../components/XpDivider.astro';
import Icon from '../../components/Icon.astro';
import { localePaths, localeFromParams } from '../../lib/paths.js';
import { getCopy } from '../../i18n/index.js';
import { href } from '../../lib/routes.js';
import { HERO, DESKTOP } from '../../data/screenshots.js';
import { art, cardFor } from '../../data/art.js';
const heroDay = art('hero-day');
const heroNight = art('hero-night');

export function getStaticPaths() {
  return localePaths();
}
const locale = localeFromParams(Astro.params);
const copy = getCopy(locale);
const highlights = copy.features.groups.flatMap((g) => g.items).filter((f) => ['wand', 'search', 'shield', 'archive', 'map', 'flame'].includes(f.icon));
const teaser = DESKTOP.slice(1, 4);
const pillarArt = [art('card-folder'), art('card-container'), art('card-pinned')];
---

<Site locale={locale} path="/" pageKey="home">
  <section class="sky relative overflow-hidden">
    <Clouds count={5} />
    {heroDay && <Image src={heroDay} alt="" widths={[800, 1584]} sizes="100vw" class="hero-panorama hero-day" loading="eager" fetchpriority="high" />}
    {heroNight && <Image src={heroNight} alt="" widths={[800, 1584]} sizes="100vw" class="hero-panorama hero-night" loading="lazy" />}
    <div class="relative mx-auto grid max-w-6xl items-start gap-8 px-4 pb-44 pt-10 sm:pb-52 lg:grid-cols-[1fr_1fr] lg:pb-56">
      <div>
        <p class="tag"><Icon name="sparkles" size={16} />{copy.hero.eyebrow}</p>
        <h1 class="mt-4 text-[2.5rem] leading-[1.05] sm:text-5xl">{copy.hero.title}</h1>
        <p class="lead mt-4 max-w-xl text-on-sky">{copy.hero.subtitle}</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a class="btn btn-primary btn-lg" href="#tutorial"><Icon name="play" size={18} />{copy.hero.primary}</a>
          <a class="btn btn-lg" href={href(locale, '/features/')}>{copy.hero.secondary}</a>
        </div>
        <ul class="mt-5 flex flex-wrap gap-2" role="list">
          {copy.hero.pills.map((pill) => <li class="tag text-[0.9rem]"><Icon name="check" size={14} />{pill}</li>)}
        </ul>
      </div>
      <div class="panel panel-tight">
        <div class="slot">
          <Image src={HERO} alt={copy.screenshots.items.dashboard} widths={[560, 900, 1300]} sizes="(min-width: 1024px) 560px, 100vw" loading="eager" fetchpriority="high" class="block" />
        </div>
      </div>
    </div>
    <div class="ground relative"></div>
  </section>

  <Section title={copy.pillars.title}>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3" role="list">
      {copy.pillars.items.map((p, i) => (
        <li class="panel">
          {pillarArt[i] && (
            <span class="slot mb-4 block"><Image src={pillarArt[i]} alt="" widths={[420, 840]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="block aspect-[16/9] w-full object-cover" /></span>
          )}
          <h3>{p.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-soft">{p.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <XpDivider />

  <Section id="tutorial" title={copy.tutorial.title} intro={copy.tutorial.intro} class="scroll-mt-20" banner={art('banner-tutorial')}>
    <div class="panel mt-6 sm:p-6">
      <InstallTutorial copy={copy} id="home-tutorial" />
    </div>
  </Section>

  <XpDivider />

  <Section title={copy.features.title} intro={copy.features.intro}>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {highlights.map((f) => <FeatureCard title={f.title} body={f.body} icon={f.icon} image={cardFor(f.icon)} />)}
    </ul>
    <p class="mt-6"><a class="btn" href={href(locale, '/features/')}>{copy.hero.secondary}<Icon name="arrow" size={18} /></a></p>
  </Section>

  <XpDivider />

  <Section title={copy.screenshots.title} intro={copy.screenshots.intro} banner={art('banner-screenshots')}>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3" role="list">
      {teaser.map((s) => (
        <li>
          <a href={href(locale, '/screenshots/')} class="panel panel-tight block">
            <span class="slot block"><Image src={s.image} alt={copy.screenshots.items[s.key]} widths={[400, 800]} sizes="(min-width: 640px) 33vw, 100vw" class="block aspect-[16/10] w-full object-cover object-top" /></span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Community copy={copy} />
</Site>

<style>
  .hero-panorama {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    max-height: 60%;
    object-fit: cover;
    object-position: center bottom;
    pointer-events: none;
  }
  .hero-night {
    display: none;
  }
  :global(:root[data-theme='dark']) .hero-day {
    display: none;
  }
  :global(:root[data-theme='dark']) .hero-night {
    display: block;
  }
</style>
