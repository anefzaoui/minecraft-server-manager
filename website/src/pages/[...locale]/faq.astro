---
import Site from '../../layouts/Site.astro';
import Section from '../../components/Section.astro';
import PageHeader from '../../components/PageHeader.astro';
import Community from '../../components/Community.astro';
import Pill from '../../components/Pill.astro';
import { localePaths, localeFromParams } from '../../lib/paths.js';
import { getCopy } from '../../i18n/index.js';
import { art } from '../../data/art.js';
const spriteShield = art('sprite-shield');

export function getStaticPaths() {
  return localePaths();
}
const locale = localeFromParams(Astro.params);
const copy = getCopy(locale);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Site locale={locale} path="/faq/" pageKey="faq" jsonLd={[faqLd]}>
  <PageHeader title={copy.faq.title} sprite={spriteShield} />
  <Section>
    <dl class="grid gap-4 md:grid-cols-2">
      {copy.faq.items.map((f) => (
        <div class="panel">
          <dt class="display text-[1.5rem] text-ink">{f.q}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-ink-soft">
            {f.a}
            {f.pills && (
              <ul class="mt-3 flex flex-wrap gap-2" role="list">
                {f.pills.map((id) => <Pill id={id} size="sm" />)}
              </ul>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </Section>
  <Community copy={copy} />
</Site>
