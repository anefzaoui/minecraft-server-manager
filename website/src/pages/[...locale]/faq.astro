---
import Site from '../../layouts/Site.astro';
import Section from '../../components/Section.astro';
import Community from '../../components/Community.astro';
import { localePaths, localeFromParams } from '../../lib/paths.js';
import { getCopy } from '../../i18n/index.js';

export function getStaticPaths() {
  return localePaths();
}
const locale = localeFromParams(Astro.params);
const copy = getCopy(locale);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Site locale={locale} path="/faq/" pageKey="faq" jsonLd={[faqLd]}>
  <div class="hero">
    <Section title={copy.faq.title} class="pb-4" />
  </div>
  <Section class="pt-4">
    <dl class="grid gap-4 md:grid-cols-2">
      {copy.faq.items.map((f) => (
        <div class="card card-hover">
          <dt class="display text-lg text-ink">{f.q}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-ink-soft">{f.a}</dd>
        </div>
      ))}
    </dl>
  </Section>
  <Community copy={copy} />
</Site>
