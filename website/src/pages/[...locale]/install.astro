---
import Site from '../../layouts/Site.astro';
import Section from '../../components/Section.astro';
import InstallSnippet from '../../components/InstallSnippet.astro';
import Community from '../../components/Community.astro';
import { localePaths, localeFromParams } from '../../lib/paths.js';
import { getCopy } from '../../i18n/index.js';
import { href, REPO_URL, SITE_URL } from '../../lib/routes.js';

export function getStaticPaths() {
  return localePaths();
}
const locale = localeFromParams(Astro.params);
const copy = getCopy(locale);
const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${copy.install.title}: ${copy.site.name}`,
  description: copy.install.docker.body,
  step: [
    { '@type': 'HowToStep', name: 'mkdir -p /opt/msm/data', text: 'Create the data folder on the host.' },
    { '@type': 'HowToStep', name: 'echo "DATA_DIR_HOST=/opt/msm/data" > .env', text: 'Point the panel at the absolute host path of that folder.' },
    { '@type': 'HowToStep', name: 'docker compose up -d', text: 'Start the panel with the compose file from the repository.' },
  ],
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.nav.home, item: new URL(href(locale, '/'), SITE_URL).href },
    { '@type': 'ListItem', position: 2, name: copy.nav.install, item: new URL(href(locale, '/install/'), SITE_URL).href },
  ],
};
---

<Site locale={locale} path="/install/" pageKey="install" jsonLd={[howTo, breadcrumb]}>
  <div class="grass-band"></div>
  <Section title={copy.install.title} intro={copy.install.intro}>
    <h3 class="mt-10 text-lg font-semibold text-ink">{copy.install.requirements}</h3>
    <ul class="prose-soft mt-3 list-disc space-y-1 ps-6" role="list">
      {copy.install.reqItems.map((r) => <li>{r}</li>)}
    </ul>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <article class="card">
        <h3 class="text-lg font-semibold text-ink">{copy.install.docker.title}</h3>
        <p class="mt-2 text-sm text-ink-soft">{copy.install.docker.body}</p>
        <div class="mt-4"><InstallSnippet /></div>
        <p class="mt-3 text-sm text-ink-soft">{copy.install.docker.after}</p>
        <p class="mt-3 rounded-sm border border-warn/40 bg-warn/10 px-3 py-2 text-sm text-ink-soft">{copy.install.docker.warning}</p>
        <p class="mt-4"><a class="btn" href={`${REPO_URL}/blob/main/docker-compose.yml`} rel="noopener">{copy.install.compose}</a></p>
      </article>
      <article class="card">
        <h3 class="text-lg font-semibold text-ink">{copy.install.source.title}</h3>
        <p class="mt-2 text-sm text-ink-soft">{copy.install.source.body}</p>
        <pre class="prose-soft mt-4 text-sm" tabindex="0"><code>git clone {REPO_URL}.git
cd minecraft-server-manager
pnpm install
pnpm run build
pnpm start</code></pre>
        <p class="mt-3 text-sm text-ink-soft">{copy.install.source.after}</p>
      </article>
    </div>

    <div class="card mt-10 bg-raised">
      <h3 class="text-lg font-semibold text-ink">{copy.install.next}</h3>
      <p class="mt-2 text-sm text-ink-soft">{copy.install.nextBody}</p>
      <p class="mt-4"><a class="btn btn-primary" href={href(locale, '/docs/getting-started/')}>{copy.install.nextCta}</a></p>
    </div>
  </Section>
  <Community copy={copy} />
</Site>
