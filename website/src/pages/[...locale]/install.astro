---
import Site from '../../layouts/Site.astro';
import Section from '../../components/Section.astro';
import PageHeader from '../../components/PageHeader.astro';
import InstallTutorial from '../../components/InstallTutorial.astro';
import Community from '../../components/Community.astro';
import Tip from '../../components/Tip.astro';
import XpDivider from '../../components/XpDivider.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import { localePaths, localeFromParams } from '../../lib/paths.js';
import { getCopy } from '../../i18n/index.js';
import { href, REPO_URL, SITE_URL } from '../../lib/routes.js';
import { art } from '../../data/art.js';
const spriteClock = art('sprite-clock');

export function getStaticPaths() {
  return localePaths();
}
const locale = localeFromParams(Astro.params);
const copy = getCopy(locale);
const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${copy.install.title}: ${copy.site.name}`,
  description: copy.install.docker.body,
  step: copy.tutorial.tabs.compose.steps.map((s) => ({ '@type': 'HowToStep', name: s.title, text: s.body })),
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.nav.home, item: new URL(href(locale, '/'), SITE_URL).href },
    { '@type': 'ListItem', position: 2, name: copy.nav.install, item: new URL(href(locale, '/install/'), SITE_URL).href },
  ],
};
---

<Site locale={locale} path="/install/" pageKey="install" jsonLd={[howTo, breadcrumb]}>
  <PageHeader title={copy.install.title} intro={copy.install.intro} sprite={spriteClock} />

  <Section title={copy.tutorial.title} intro={copy.tutorial.intro}>
    <div class="panel mt-6 sm:p-6">
      <InstallTutorial copy={copy} id="install-tutorial" />
    </div>
    <Tip class="mt-6" title={copy.install.docker.title}>{copy.install.docker.warning}</Tip>
    <p class="mt-6 flex flex-wrap gap-4">
      <a class="btn" href={`${REPO_URL}/blob/main/docker-compose.yml`} rel="noopener"><Icon name="docker" size={18} />{copy.install.compose}</a>
      <a class="btn btn-primary" href={href(locale, '/docs/getting-started/')}>{copy.install.nextCta}<Icon name="arrow" size={18} /></a>
    </p>
  </Section>

  <XpDivider />

  <Section title={copy.install.requirements}>
    <ul class="hearts mt-4 grid gap-4 text-ink-soft sm:grid-cols-3" role="list">
      {copy.install.reqItems.map((r, i) => (
        <li>
          {r}
          {copy.install.reqPills[i]?.length > 0 && (
            <ul class="mt-2 flex flex-wrap gap-2" role="list">
              {copy.install.reqPills[i].map((id) => <Pill id={id} size="sm" />)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </Section>


  <XpDivider />

  <Section title={copy.install.windows}>
    <ul class="hearts mt-4 max-w-2xl space-y-2 text-ink-soft" role="list">
      {copy.install.windowsItems.map((r) => <li>{r}</li>)}
    </ul>
  </Section>

  <Community copy={copy} />
</Site>
