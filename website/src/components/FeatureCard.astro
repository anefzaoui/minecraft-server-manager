---
import Icon from './Icon.astro';
interface Props {
  title: string;
  body: string;
  icon?: string;
  tone?: 'grass' | 'sky' | 'gold' | 'stone';
}
const { title, body, icon = 'sparkles', tone = 'grass' } = Astro.props;
---

<li class="card card-hover flex gap-4">
  <span class:list={['icon-tile', `icon-tile-${tone}`]}><Icon name={icon} /></span>
  <div>
    <h3 class="display text-[1.05rem] text-ink">{title}</h3>
    <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{body}</p>
  </div>
</li>
