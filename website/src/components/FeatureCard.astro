---
// A feature card: optional full-width illustration in an inset slot on top,
// then icon, title, body and, when the feature names things it works with, a
// row of brand pills (the rule: boast strengths, never bury them in prose).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Pill from './Pill.astro';
interface Props {
  title: string;
  body: string;
  icon?: string;
  image?: ImageMetadata;
  pills?: string[];
}
const { title, body, icon = 'sparkles', image, pills = [] } = Astro.props;
---

<li class="panel flex flex-col">
  {image && (
    <span class="slot mb-4 block">
      <Image src={image} alt="" widths={[420, 840]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="block aspect-[16/9] w-full object-cover" />
    </span>
  )}
  <div class="flex gap-4">
    <span class="slot slot-icon"><Icon name={icon} /></span>
    <div class="min-w-0 flex-1">
      <h3>{title}</h3>
      <p class="mt-1 text-sm leading-relaxed text-ink-soft">{body}</p>
      {pills.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2" role="list">
          {pills.map((id) => <Pill id={id} size="sm" />)}
        </ul>
      )}
    </div>
  </div>
</li>
