---
// The lightbox on every page, marketing and docs alike: screenshots open big over the page, a group at a
// time. It is Vitrine (https://github.com/anefzaoui/vitrine), vendored unmodified in public/vitrine/ at
// the commit vitrine.lock.json pins and checked by scripts/vitrine-vendor.mjs (in `check`); those files
// are GPL-3.0-or-later (docs/website.md). A picture with data-lightbox opens in its group, every docs
// picture (.sl-markdown-content) by itself; a link to a picture still opens it with no script. Words in
// the page's language (`lightbox` in the i18n copy); the look in src/styles/vitrine-theme.css.
import { getCopy } from '../i18n/index.js';
interface Props {
  locale: string;
}
const strings = getCopy(Astro.props.locale).lightbox;
---

<link rel="stylesheet" href="/vitrine/vitrine.css" />
<script is:inline src="/vitrine/vitrine-core.js" defer></script>
<script is:inline src="/vitrine/vitrine.js" defer></script>
<script is:inline define:vars={{ strings }}>
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.Vitrine || !window.Vitrine.lightbox) return;
    window.Vitrine.setStrings(strings);
    window.Vitrine.lightbox.init({ auto: '.sl-markdown-content', minWidth: 120 });
  });
</script>
