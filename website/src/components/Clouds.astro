---
// A few original pixel clouds drifting across a sky area. Pure CSS animation;
// off under prefers-reduced-motion (handled globally).
interface Props {
  count?: number;
}
const { count = 4 } = Astro.props;
const clouds = Array.from({ length: count }, (_, i) => ({
  top: `${8 + ((i * 37) % 55)}%`,
  duration: `${70 + i * 23}s`,
  delay: `${-i * 19}s`,
  scale: 1 + (i % 3) * 0.35,
}));
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  {clouds.map((c) => (
    <span class="cloud" style={`top:${c.top};animation-duration:${c.duration};animation-delay:${c.delay};scale:${c.scale}`}></span>
  ))}
</div>
