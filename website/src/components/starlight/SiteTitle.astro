---
// Replaces Starlight's default site title with the pixel lockup, linking back
// to the marketing home page of the current locale.
import { href } from '../../lib/routes.js';
import { getCopy } from '../../i18n/index.js';
import { localeCode } from '../../i18n/locales.js';
// Astro.currentLocale is the language tag here ('pt-BR'); links need the code ('pt-br').
const locale = localeCode(Astro.currentLocale);
const copy = getCopy(locale);
---

<a href={href(locale, '/')} class="site-title-pixel">
  <img src="/favicon.svg" alt="" width="26" height="26" style="border-radius:6px" />
  <span>{copy.site.name}</span>
</a>
