---
import { PAGES, REPO_URL, DISCORD_URL, href } from '../lib/routes.js';
interface Props {
  locale: string;
  copy: any;
}
const { locale, copy } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line bg-surface">
  <div class="grass-band grass-band-flip"></div>
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="pixel text-[0.6rem] text-ink">{copy.site.name}</p>
      <p class="mt-3 text-sm text-ink-soft">{copy.site.tagline}</p>
      <p class="mt-2 text-sm text-ink-faint">{copy.footer.tagline}</p>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-ink">{copy.footer.product}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {PAGES.filter((p) => p.key !== 'home').map((p) => (
          <li><a class="text-ink-soft hover:text-ink" href={href(locale, p.path)}>{copy.nav[p.key]}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-ink">{copy.footer.community}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-ink-soft hover:text-ink" href={DISCORD_URL} rel="noopener">{copy.nav.discord}</a></li>
        <li><a class="text-ink-soft hover:text-ink" href={REPO_URL} rel="noopener">{copy.nav.github}</a></li>
        <li><a class="text-ink-soft hover:text-ink" href={`${REPO_URL}/issues`} rel="noopener">{copy.footer.issues}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-ink">{copy.footer.resources}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-ink-soft hover:text-ink" href={`${REPO_URL}/releases`} rel="noopener">{copy.footer.releases}</a></li>
        <li><a class="text-ink-soft hover:text-ink" href={`${REPO_URL}/blob/main/CONTRIBUTING.md`} rel="noopener">{copy.footer.contributing}</a></li>
        <li><a class="text-ink-soft hover:text-ink" href={`${REPO_URL}/blob/main/LICENSE`} rel="noopener">{copy.footer.license}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-ink-faint">© {year} Minecraft Server Manager contributors. {copy.footer.notAffiliated}</p>
  </div>
</footer>
