---
import { PAGES, REPO_URL, DISCORD_URL, href } from '../lib/routes.js';
interface Props {
  locale: string;
  copy: any;
}
const { locale, copy } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="tex tex-dark-dirt border-t-[3px] border-outline text-[#e8e6df]">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="display flex items-center gap-2 text-xl text-white"><img src="/favicon.svg" alt="" width="26" height="26" class="pixelated" />{copy.site.name}</p>
      <p class="mt-3 text-sm">{copy.site.tagline}</p>
      <p class="mt-1 text-sm opacity-80">{copy.footer.tagline}</p>
    </div>
    <div>
      <h2 class="text-base text-white">{copy.footer.product}</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {PAGES.filter((p) => p.key !== 'home').map((p) => (
          <li><a class="hover:text-white hover:underline" href={href(locale, p.path)}>{copy.nav[p.key]}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-base text-white">{copy.footer.community}</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li><a class="hover:text-white hover:underline" href={DISCORD_URL} rel="noopener">{copy.nav.discord}</a></li>
        <li><a class="hover:text-white hover:underline" href={REPO_URL} rel="noopener">{copy.nav.github}</a></li>
        <li><a class="hover:text-white hover:underline" href={`${REPO_URL}/issues`} rel="noopener">{copy.footer.issues}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-base text-white">{copy.footer.resources}</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li><a class="hover:text-white hover:underline" href={`${REPO_URL}/releases`} rel="noopener">{copy.footer.releases}</a></li>
        <li><a class="hover:text-white hover:underline" href={`${REPO_URL}/blob/main/CONTRIBUTING.md`} rel="noopener">{copy.footer.contributing}</a></li>
        <li><a class="hover:text-white hover:underline" href={`${REPO_URL}/blob/main/LICENSE`} rel="noopener">{copy.footer.license}</a></li>
      </ul>
    </div>
  </div>
  <div class="tex tex-deep-stone border-t-[3px] border-outline">
    <p class="mx-auto max-w-6xl px-4 py-3 text-xs text-[#cfd3d8]">© {year} Minecraft Server Manager contributors. {copy.footer.notAffiliated}</p>
  </div>
</footer>
