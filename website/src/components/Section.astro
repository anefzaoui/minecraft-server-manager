---
interface Props {
  title?: string;
  intro?: string;
  id?: string;
  class?: string;
}
const { title, intro, id, class: cls } = Astro.props;
---

<section id={id} class:list={['mx-auto max-w-6xl px-4 py-12 sm:py-16', cls]}>
  {title && <h2 class="pixel text-base text-ink sm:text-lg">{title}</h2>}
  {intro && <p class="mt-3 max-w-2xl text-ink-soft">{intro}</p>}
  <slot />
</section>
