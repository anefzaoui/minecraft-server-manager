---
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { PAGES, REPO_URL, href } from '../lib/routes.js';
interface Props {
  locale: string;
  path: string;
  copy: any;
  active?: string;
}
const { locale, path, copy, active } = Astro.props;
const links = PAGES.filter((p) => p.key !== 'home');
---

<header class="sticky top-0 z-20 border-b border-line bg-surface/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-2.5">
    <a href={href(locale, '/')} class="display flex items-center gap-2.5 text-[1.05rem] text-ink no-underline" aria-label={copy.site.name}>
      <img src="/favicon.svg" alt="" width="30" height="30" class="rounded-lg" />
      <span class="hidden sm:inline">{copy.site.name}</span>
      <span class="sm:hidden">MSM</span>
    </a>

    <nav class="ms-auto hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {links.map((p) => (
        <a
          href={href(locale, p.path)}
          class:list={['btn btn-ghost px-3.5 text-[0.9rem]', active === p.key && 'bg-inset text-ok']}
          aria-current={active === p.key ? 'page' : undefined}
        >
          {copy.nav[p.key]}
        </a>
      ))}
    </nav>

    <div class="ms-auto flex items-center gap-0.5 lg:ms-1">
      <LangSwitcher locale={locale} path={path} label={copy.nav.language} />
      <ThemeToggle label={copy.nav.theme} />
      <a href={REPO_URL} class="btn btn-ghost hidden px-3 sm:inline-flex" rel="noopener" aria-label={copy.nav.github} title={copy.nav.github}>
        <Icon name="github" size={20} />
      </a>
      <details class="relative lg:hidden">
        <summary class="btn btn-ghost cursor-pointer list-none px-3" aria-label={copy.nav.menu}>
          <Icon name="menu" size={22} />
        </summary>
        <nav class="card absolute end-0 z-40 mt-2 flex w-60 flex-col p-2" aria-label="Primary">
          {links.map((p) => (
            <a href={href(locale, p.path)} class:list={['rounded-lg px-3 py-2.5 font-semibold hover:bg-inset', active === p.key && 'bg-inset text-ok']}>
              {copy.nav[p.key]}
            </a>
          ))}
          <a href={REPO_URL} class="rounded-lg px-3 py-2.5 font-semibold hover:bg-inset" rel="noopener">{copy.nav.github}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
