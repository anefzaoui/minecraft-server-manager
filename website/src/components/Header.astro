---
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { PAGES, REPO_URL, href } from '../lib/routes.js';
interface Props {
  locale: string;
  path: string;
  copy: any;
  active?: string;
}
const { locale, path, copy, active } = Astro.props;
const links = PAGES.filter((p) => p.key !== 'home');
---

<header class="sticky top-0 z-20 border-b border-line bg-surface/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-2">
    <a href={href(locale, '/')} class="pixel flex items-center gap-2 text-[0.65rem] text-ink no-underline sm:text-xs" aria-label={copy.site.name}>
      <img src="/favicon.svg" alt="" width="28" height="28" class="rounded-sm" />
      <span class="hidden sm:inline">{copy.site.name}</span>
      <span class="sm:hidden">MSM</span>
    </a>

    <nav class="ms-auto hidden items-center gap-1 lg:flex" aria-label="Primary">
      {links.map((p) => (
        <a
          href={href(locale, p.path)}
          class:list={['btn btn-ghost px-3 text-sm', active === p.key && 'bg-inset text-ok']}
          aria-current={active === p.key ? 'page' : undefined}
        >
          {copy.nav[p.key]}
        </a>
      ))}
    </nav>

    <div class="ms-auto flex items-center gap-1 lg:ms-0">
      <LangSwitcher locale={locale} path={path} label={copy.nav.language} />
      <ThemeToggle label={copy.nav.theme} />
      <a href={REPO_URL} class="btn btn-ghost hidden px-3 sm:inline-flex" rel="noopener" aria-label={copy.nav.github} title={copy.nav.github}>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
      </a>
      <details class="relative lg:hidden">
        <summary class="btn btn-ghost cursor-pointer list-none px-3" aria-label={copy.nav.menu}>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </summary>
        <nav class="card absolute end-0 z-40 mt-2 flex w-56 flex-col p-2 shadow-lg" aria-label="Primary">
          {links.map((p) => (
            <a href={href(locale, p.path)} class:list={['rounded-sm px-3 py-2 hover:bg-inset', active === p.key && 'bg-inset text-ok']}>
              {copy.nav[p.key]}
            </a>
          ))}
          <a href={REPO_URL} class="rounded-sm px-3 py-2 hover:bg-inset" rel="noopener">{copy.nav.github}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
