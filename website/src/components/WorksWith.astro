---
// The "works with" strip under the hero: registries, server types, platforms.
import PillRow from './PillRow.astro';
interface Props {
  copy: any;
}
const { copy } = Astro.props;
const t = copy.brands;
---

<section class="tex tex-stone border-b-[3px] border-outline" aria-label={t.worksWith}>
  <div class="mx-auto max-w-6xl px-4 py-6">
    <div class="panel">
      <h2 class="text-[1.75rem]">{t.worksWith}</h2>
      <div class="mt-4 grid gap-3">
        <PillRow label={t.registries} ids={['modrinth', 'curseforge', 'hangar', 'spigotmc', 'github-releases']} size="lg" />
        <PillRow label={t.loaders} ids={['vanilla', 'paper', 'purpur', 'fabric', 'forge', 'neoforge', 'quilt']} size="lg" />
        <PillRow label={t.packs} ids={['packs-curseforge', 'packs-modrinth', 'ftb', 'gtnh']} size="lg" />
        <PillRow label={t.runsOn} ids={['docker', 'portainer', 'dockge', 'pm2', 'linux', 'windows', 'macos', 'amd64', 'arm64']} size="lg" />
      </div>
    </div>
  </div>
</section>
