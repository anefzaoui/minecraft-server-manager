---
import Icon from './Icon.astro';
import { REPO_URL, DISCORD_URL } from '../lib/routes.js';
interface Props {
  copy: any;
}
const { copy } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-10">
  <div class="card flex flex-col items-start gap-5 bg-accent-soft/60 sm:flex-row sm:items-center sm:justify-between sm:p-8">
    <div>
      <h2 class="display text-2xl text-ink">{copy.community.title}</h2>
      <p class="mt-2 text-ink-soft">{copy.community.body}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a class="btn btn-primary" href={DISCORD_URL} rel="noopener"><Icon name="discord" size={18} />{copy.community.discord}</a>
      <a class="btn" href={REPO_URL} rel="noopener"><Icon name="github" size={18} />{copy.community.github}</a>
    </div>
  </div>
</section>
