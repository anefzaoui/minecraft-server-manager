---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { REPO_URL, DISCORD_URL } from '../lib/routes.js';
import { art } from '../data/art.js';
const banner = art('banner-community');
const mapSprite = art('sprite-map');
interface Props {
  copy: any;
}
const { copy } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-12">
  {banner && (
    <div class="panel panel-tight mb-6">
      <span class="slot block"><Image src={banner} alt="" widths={[720, 1200, 1584]} sizes="(min-width: 1152px) 1120px, 100vw" class="block aspect-[21/6] w-full object-cover object-bottom" /></span>
    </div>
  )}
  <div class="panel flex flex-col gap-5 sm:flex-row sm:items-center">
    {mapSprite && <Image src={mapSprite} alt="" width={160} class="pixelated hidden shrink-0 sm:block" style="width:160px;height:auto" />}
    <div class="flex-1">
      <h2>{copy.community.title}</h2>
      <p class="mt-2 text-ink-soft">{copy.community.body}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a class="btn btn-primary" href={DISCORD_URL} rel="noopener"><Icon name="discord" size={18} />{copy.community.discord}</a>
      <a class="btn" href={REPO_URL} rel="noopener"><Icon name="github" size={18} />{copy.community.github}</a>
    </div>
  </div>
</section>
