---
// The interactive install tutorial, in two modes (radio-driven tabs, so they
// work with JavaScript off). Simple, the default: pick Linux, Windows or macOS
// and paste the commands. Advanced: two inputs (data folder, host) that rewrite
// every command and the "open the panel" URL live, across four install methods.
// One small inline script handles the rewrite, the copy buttons, and
// remembering the inputs per browser.
import { Image } from 'astro:assets';
import CodeBox from './CodeBox.astro';
import Icon from './Icon.astro';
import { brand, simpleIcon, pixelIcon } from '../data/brands.js';
interface Props {
  copy: any;
  id?: string;
}
const { copy, id = 'tutorial' } = Astro.props;
const t = copy.tutorial;
const REPO = 'https://github.com/anefzaoui/minecraft-server-manager';
const RAW_COMPOSE = 'https://raw.githubusercontent.com/anefzaoui/minecraft-server-manager/main/docker-compose.yml';
const PANEL_URL = 'http://{{host}}:25564';
const INSTALLER = 'curl -fsSL https://raw.githubusercontent.com/anefzaoui/minecraft-server-manager/main/deploy/install.sh | sudo bash';
const FROM_SOURCE = [`git clone ${REPO}.git`, 'cd minecraft-server-manager', 'pnpm install', 'pnpm start'];

// Simple mode: one tab per platform, steps are [commands] in order; the last
// step is always "open the panel" with its URL.
const PLATFORMS = [
  { key: 'linux', steps: [[INSTALLER]], open: 'http://your-server-ip:25564' },
  {
    key: 'windows',
    steps: [
      ['winget install Docker.DockerDesktop', 'winget install OpenJS.NodeJS.LTS', 'winget install Git.Git', 'winget install pnpm.pnpm'],
      FROM_SOURCE,
    ],
    open: 'http://localhost:25564',
  },
  {
    key: 'macos',
    steps: [['brew install --cask docker-desktop', 'brew install node git pnpm'], FROM_SOURCE],
    open: 'http://localhost:25564',
  },
];
const logo = (id) => {
  const b = brand(id);
  return { si: simpleIcon(b), px: pixelIcon(b) };
};

const TABS = [
  {
    key: 'compose',
    icon: 'docker',
    steps: [
      ['mkdir -p {{dataDir}}'],
      [`curl -fsSLO ${RAW_COMPOSE}`, 'echo "DATA_DIR_HOST={{dataDir}}" > .env'],
      ['docker compose up -d'],
    ],
    open: PANEL_URL,
  },
  {
    key: 'portainer',
    icon: 'stack',
    steps: [['mkdir -p {{dataDir}}'], [{ url: RAW_COMPOSE }], ['DATA_DIR_HOST={{dataDir}}']],
    open: PANEL_URL,
  },
  {
    key: 'source',
    icon: 'code',
    steps: [['node --version   # 24 or newer', 'docker info      # daemon reachable'], [`git clone ${REPO}.git`, 'cd minecraft-server-manager', 'pnpm install'], ['pnpm start']],
    open: 'http://localhost:25564',
  },
  {
    key: 'pm2',
    icon: 'play',
    steps: [
      ['pm2 start src/server.js --name minecraft-server-manager --interpreter "$(nvm which 24)"'],
      ['pm2 save', 'pm2 startup'],
      [{ note: true }],
    ],
    open: PANEL_URL,
  },
];
---

<div class="tabs relative" data-tutorial id={id}>
  <input type="radio" name={`${id}-mode`} id={`${id}-mode-1`} checked />
  <input type="radio" name={`${id}-mode`} id={`${id}-mode-2`} />
  <div class="hotbar" role="tablist">
    <label class="tab-label" for={`${id}-mode-1`}><Icon name="sparkles" size={18} />{t.modes.simple}</label>
    <label class="tab-label" for={`${id}-mode-2`}><Icon name="blueprint" size={18} />{t.modes.advanced}</label>
  </div>

  <div class="tab-panels mt-6 border-t-2 border-panel-lo pt-6">
    <section class="tab-panel" aria-label={t.modes.simple}>
      <div class="tabs relative">
        {PLATFORMS.map((p, i) => <input type="radio" name={`${id}-os`} id={`${id}-os-${i + 1}`} checked={i === 0} />)}
        <div class="hotbar hotbar-sm" role="tablist">
          {PLATFORMS.map((p, i) => {
            const { si, px } = logo(p.key);
            return (
              <label class="tab-label" for={`${id}-os-${i + 1}`}>
                {si && <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d={si.path} fill="currentColor" /></svg>}
                {!si && px && <Image src={px} alt="" width={36} class="pixelated" style="width:18px;height:18px" />}
                {t.simple[p.key].label}
              </label>
            );
          })}
        </div>
        <div class="tab-panels mt-6">
          {PLATFORMS.map((p) => (
            <section class="tab-panel" aria-label={t.simple[p.key].label}>
              <ol class="grid gap-5">
                {p.steps.map((cmds, i) => (
                  <li class="flex gap-4">
                    <span class="step-badge">{i + 1}</span>
                    <div class="min-w-0 flex-1">
                      <h3>{t.simple[p.key].steps[i].title}</h3>
                      <p class="mt-1 text-sm text-ink-soft">{t.simple[p.key].steps[i].body}</p>
                      <div class="mt-3"><CodeBox code={cmds.join('\n')} copy={t.copy} copied={t.copied} /></div>
                    </div>
                  </li>
                ))}
                <li class="flex gap-4">
                  <span class="step-badge">{p.steps.length + 1}</span>
                  <div class="min-w-0 flex-1">
                    <h3>{t.simple[p.key].steps[p.steps.length].title}</h3>
                    <p class="mt-1 text-sm text-ink-soft">{t.simple[p.key].steps[p.steps.length].body}</p>
                    <div class="mt-3"><CodeBox code={p.open} kind="url" copy={t.copy} copied={t.copied} /></div>
                  </div>
                </li>
              </ol>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="tab-panel" aria-label={t.modes.advanced}>
      <div class="tabs relative">
        {TABS.map((tab, i) => (
          <input type="radio" name={`${id}-tab`} id={`${id}-tab-${i + 1}`} checked={i === 0} />
        ))}

        <p class="mb-4 text-sm text-ink-soft">{t.advancedIntro}</p>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="display block text-[1.25rem] text-ink">{t.dataDir}</span>
            <input class="field mt-1.5" type="text" data-input="dataDir" value="/opt/msm/data" spellcheck="false" autocomplete="off" />
            <span class="mt-1 block text-xs text-ink-faint">{t.dataDirHint}</span>
          </label>
          <label class="block">
            <span class="display block text-[1.25rem] text-ink">{t.host}</span>
            <input class="field mt-1.5" type="text" data-input="host" value="your-host" spellcheck="false" autocomplete="off" />
            <span class="mt-1 block text-xs text-ink-faint">{t.hostHint}</span>
          </label>
        </div>

        <div class="hotbar hotbar-sm mt-6" role="tablist">
          {TABS.map((tab, i) => (
            <label class="tab-label" for={`${id}-tab-${i + 1}`}>
              <Icon name={tab.icon} size={18} />
              {t.tabs[tab.key].label}
            </label>
          ))}
        </div>

        <div class="tab-panels mt-6">
          {TABS.map((tab) => (
            <section class="tab-panel" aria-label={t.tabs[tab.key].label}>
              <ol class="grid gap-5">
                {tab.steps.map((cmds, i) => (
                  <li class="flex gap-4">
                    <span class="step-badge">{i + 1}</span>
                    <div class="min-w-0 flex-1">
                      <h3>{t.tabs[tab.key].steps[i].title}</h3>
                      <p class="mt-1 text-sm text-ink-soft">{t.tabs[tab.key].steps[i].body}</p>
                      {cmds.some((c) => typeof c === 'string') && (
                        <div class="mt-3">
                          <CodeBox code={cmds.filter((c) => typeof c === 'string').join('\n')} copy={t.copy} copied={t.copied} />
                        </div>
                      )}
                      {cmds.map((c) => typeof c === 'object' && 'url' in c && (
                        <div class="mt-3">
                          <CodeBox code={c.url} kind="url" copy={t.copy} copied={t.copied} />
                        </div>
                      ))}
                    </div>
                  </li>
                ))}
                <li class="flex gap-4">
                  <span class="step-badge">
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <h3>{t.then}</h3>
                    <div class="mt-3"><CodeBox code={tab.open} kind="url" copy={t.copy} copied={t.copied} /></div>
                    <p class="mt-2 text-sm text-ink-soft">{t.firstRun}</p>
                  </div>
                </li>
              </ol>
            </section>
          ))}
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  // Personalise commands from the two inputs, copy buttons, and remember the
  // inputs per browser. Everything degrades: without JS the defaults show and
  // the tabs still switch (they are radios).
  const roots = document.querySelectorAll<HTMLElement>('[data-tutorial]');
  const KEY = 'msm-tutorial-inputs';
  const clean = (v: string, fallback: string) => v.trim().replace(/\s+/g, '') || fallback;

  for (const root of roots) {
    const inputs = root.querySelectorAll<HTMLInputElement>('[data-input]');
    const values: Record<string, string> = { dataDir: '/opt/msm/data', host: 'your-host' };
    try {
      Object.assign(values, JSON.parse(localStorage.getItem(KEY) || '{}'));
    } catch {
      /* no storage, keep defaults */
    }
    for (const i of inputs) if (values[i.dataset.input!]) i.value = values[i.dataset.input!];

    const render = () => {
      for (const i of inputs) values[i.dataset.input!] = clean(i.value, i.dataset.input === 'host' ? 'your-host' : '/opt/msm/data');
      for (const code of root.querySelectorAll<HTMLElement>('[data-template]')) {
        code.textContent = code.dataset.template!.replace(/\{\{(\w+)\}\}/g, (_m, k) => values[k] ?? '');
      }
      try {
        localStorage.setItem(KEY, JSON.stringify(values));
      } catch {
        /* fine */
      }
    };
    for (const i of inputs) i.addEventListener('input', render);
    render();

    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      btn.addEventListener('click', async () => {
        const code = btn.parentElement?.querySelector('code');
        const text = code?.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        const label = btn.querySelector('span')!;
        label.textContent = btn.dataset.copiedLabel!;
        btn.dataset.copied = 'true';
        setTimeout(() => {
          label.textContent = btn.dataset.copyLabel!;
          delete btn.dataset.copied;
        }, 1600);
      });
    }
  }
</script>
