{
  "name": "minecraft-server-manager",
  "version": "0.14.1",
  "description": "Minecraft Server Manager: a complete control panel for itzg/docker-minecraft-server",
  "private": true,
  "license": "MIT",
  "author": "anefzaoui",
  "type": "commonjs",
  "main": "src/server.js",
  "homepage": "https://github.com/anefzaoui/minecraft-server-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anefzaoui/minecraft-server-manager.git"
  },
  "bugs": {
    "url": "https://github.com/anefzaoui/minecraft-server-manager/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node src/server.js",
    "build": "pnpm run build:css && pnpm run build:js",
    "build:css": "tailwindcss -i assets/css/input.css -o public/css/app.css --minify",
    "build:js": "node scripts/build-js.js",
    "watch:css": "tailwindcss -i assets/css/input.css -o public/css/app.css --watch",
    "postinstall": "node scripts/postinstall.js",
    "lint": "eslint src scripts public/js test eslint.config.js",
    "lint:fix": "eslint src scripts public/js test eslint.config.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/**/*.test.js\"",
    "test:prose": "node --test test/copy-prose-standards.test.js",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "test:smoke": "node scripts/qa-sweep.js",
    "db:migrate": "node scripts/migrate.js",
    "seed:servers": "node scripts/seed-fake-servers.js",
    "seed:players": "node scripts/seed-players.js",
    "contributors": "node scripts/contributors-svg.js",
    "test:deploy": "docker run --rm -v \"$PWD:/repo\" -w /repo ubuntu:24.04 bash test/deploy/install-scenarios.sh",
    "test:deploy:real": "bash test/deploy/e2e-real.sh"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-signature": "^1.2.2",
    "croner": "^10.0.1",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "js-yaml": "^5.4.2",
    "lucide-static": "^1.48.0",
    "marked": "^18.0.14",
    "minecraft-data": "^3.117.0",
    "multer": "^2.4.0",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prismarine-nbt": "^2.8.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.7",
    "tar": "^7.5.22",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "espree": "11.2.0",
    "globals": "^17.12.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
