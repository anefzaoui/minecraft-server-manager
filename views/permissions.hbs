{{> page-header headingKey="permissions_page.heading" subKey="permissions_page.sub"}}

<div class="space-y-5" id="permissions-page">
  <section class="card p-4 sm:p-5">
    <h3 class="text-sm font-semibold text-ink">{{t 'permissions_page.how_it_works'}}</h3>
    <ul class="mt-2 grid gap-1.5 text-xs leading-relaxed text-ink-faint sm:grid-cols-2">
      <li><b class="text-ink-soft">{{t 'permissions_page.bullet_admin'}}</b></li>
      <li>{{t 'permissions_page.bullet_roles'}}</li>
      <li>{{t 'permissions_page.bullet_cells'}}</li>
      <li>{{t 'permissions_page.bullet_hide'}}</li>
    </ul>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {{#each matrix.capabilities}}
        <span class="chip" data-tip="{{help}}">{{label}}</span>
      {{/each}}
    </div>
  </section>

  {{#if matrix.users.length}}
    {{#if matrix.servers.length}}
      <div class="card overflow-x-auto p-0">
        <table class="table-base table-stack" id="permissions-table">
          <thead>
            <tr>
              <th>{{t 'permissions_page.th_user'}}</th>
              {{#each matrix.servers}}
                <th>
                  <span class="inline-flex items-center gap-2">
                    <img src="{{iconSrc icon}}" alt="" class="size-5 rounded-sm" style="background: {{accent}}" data-fallback-icon="/icons/servers/grass.svg">
                    <span class="truncate" title="{{name}}">{{name}}</span>
                  </span>
                </th>
              {{/each}}
            </tr>
          </thead>
          <tbody>
            {{#each matrix.rows}}
              <tr data-user-id="{{user.id}}" data-username="{{user.username}}" data-role="{{user.role}}">
                <td data-th="{{t 'permissions_page.th_user'}}" class="whitespace-nowrap font-medium">
                  {{user.username}}
                  <span class="badge ml-1">{{t (concat 'roles.' user.role)}}</span>
                </td>
                {{#each servers}}
                  <td data-th="{{lookup (lookup ../../matrix.servers @index) 'name'}}">
                    <button type="button" class="chip" data-perm-cell data-server-id="{{serverId}}" data-server-name="{{lookup (lookup ../../matrix.servers @index) 'name'}}" data-grant="{{jsonAttr grant}}" data-effective="{{jsonAttr effective}}" aria-label="{{t 'permissions_page.cell_aria' user=../user.username server=(lookup (lookup ../../matrix.servers @index) 'name')}}">
                      <span data-perm-summary></span>
                    </button>
                  </td>
                {{/each}}
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      {{> empty-state iconName='server' titleKey='permissions_page.no_servers_title' messageKey='permissions_page.no_servers_message' ctaHref='/servers/new' ctaLabelKey='permissions_page.create_server'}}
    {{/if}}
  {{else}}
    {{> empty-state iconName='users' titleKey='permissions_page.no_users_title' messageKey='permissions_page.no_users_message' ctaHref='/settings' ctaLabelKey='permissions_page.manage_users'}}
  {{/if}}

  <section class="card p-4 sm:p-5" id="permissions-reference">
    <h3 class="text-sm font-semibold text-ink">{{t 'permissions_page.reference_title'}}</h3>
    <p class="mt-1 max-w-prose text-xs leading-relaxed text-ink-faint">{{t 'permissions_page.reference_desc'}}</p>
    <div class="mt-4 divide-y divide-line">
      {{#each matrix.capabilities}}
        <details class="group py-3" id="permission-{{key}}">
          <summary class="flex cursor-pointer list-none items-start gap-3 [&::-webkit-details-marker]:hidden">
            <span class="mt-0.5 shrink-0 text-ink-faint transition group-open:rotate-90">{{{icon 'chevron-right' 'size-4'}}}</span>
            <span class="min-w-0">
              <span class="block text-sm font-medium text-ink">{{label}}</span>
              <span class="mt-0.5 block max-w-prose text-xs leading-relaxed text-ink-faint">{{help}}</span>
            </span>
          </summary>
          <div class="mt-3 grid gap-4 pl-7 lg:grid-cols-2">
            <div>
              <h4 class="eyebrow">{{t 'permissions_page.you_can'}}</h4>
              <ul class="mt-1.5 list-disc space-y-1 pl-4 text-xs leading-relaxed text-ink-soft">
                {{#each covers}}<li>{{this}}</li>{{/each}}
              </ul>
              <h4 class="eyebrow mt-3">{{t 'permissions_page.not_included'}}</h4>
              <p class="mt-1.5 max-w-prose text-xs leading-relaxed text-ink-soft">{{excludes}}</p>
            </div>
            <div>
              <h4 class="eyebrow">{{t 'permissions_page.technical_reach'}}</h4>
              <ul class="mt-1.5 space-y-0.5 font-mono text-[11px] leading-relaxed text-ink-faint">
                {{#each reach}}<li>{{this}}</li>{{/each}}
              </ul>
            </div>
          </div>
        </details>
      {{/each}}
    </div>
    <p class="help mt-3 max-w-prose">{{t 'permissions_page.admin_only_footer'}}</p>
  </section>
</div>
<script type="application/json" id="permissions-capabilities">{{jsonScript matrix.capabilities}}</script>
<script type="module" src="/js/pages/permissions.js"></script>
