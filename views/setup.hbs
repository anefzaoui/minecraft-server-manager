<div class="w-full max-w-lg" id="setup-wizard">
  <div class="mb-5 flex items-center justify-center gap-2.5">
    {{> brand-lockup}}
  </div>

  {{! Progress dots - one per step, driven by setup.js }}
  <div class="mb-4 flex items-center justify-center gap-2" id="setup-dots" aria-hidden="true">
    <span class="h-1.5 w-6 rounded-full bg-grass-500 transition-colors" data-dot></span>
    <span class="h-1.5 w-6 rounded-full bg-line transition-colors" data-dot></span>
    <span class="h-1.5 w-6 rounded-full bg-line transition-colors" data-dot></span>
    <span class="h-1.5 w-6 rounded-full bg-line transition-colors" data-dot></span>
    <span class="h-1.5 w-6 rounded-full bg-line transition-colors" data-dot></span>
  </div>

  <div class="card p-6">
    {{! ---- Step 0: Welcome ---- }}
    <section data-step="0">
      <h2 class="text-center text-lg font-semibold">{{t 'setup_wizard.welcome_title'}}</h2>
      <p class="mx-auto mt-2 max-w-sm text-center text-sm text-ink-faint">
        {{t 'setup_wizard.welcome_desc'}}
      </p>
      <button class="btn btn-primary mt-6 w-full" data-next>{{t 'setup_wizard.get_started'}} {{{icon 'arrow-right' 'size-4'}}}</button>
    </section>

    {{! ---- Step 1: System checks ---- }}
    <section data-step="1" hidden>
      <h2 class="text-lg font-semibold">{{t 'setup_wizard.check_title'}}</h2>
      <p class="mt-1 text-sm text-ink-faint">{{t 'setup_wizard.check_desc'}}</p>
      <div class="mt-4 space-y-2" id="checks-list">
        <div class="flex items-center gap-2 py-6 text-sm text-ink-faint">
          <span class="size-4 animate-spin rounded-full border-2 border-line border-t-grass-500"></span> {{t 'setup_wizard.running_checks'}}
        </div>
      </div>
      <div class="mt-6 flex items-center gap-2">
        <button class="btn btn-ghost" data-back>{{{icon 'arrow-left' 'size-4'}}} {{t 'setup_wizard.back'}}</button>
        <button class="btn btn-ghost" data-recheck>{{{icon 'rotate-cw' 'size-4'}}} {{t 'setup_wizard.recheck'}}</button>
        <button class="btn btn-primary ml-auto" data-next>{{t 'setup_wizard.continue'}} {{{icon 'arrow-right' 'size-4'}}}</button>
      </div>
    </section>

    {{! ---- Step 2: Create admin ---- }}
    <section data-step="2" hidden>
      <h2 class="text-lg font-semibold">{{t 'setup_wizard.admin_title'}}</h2>
      <p class="mt-1 text-sm text-ink-faint">{{t 'setup_wizard.admin_desc'}}</p>
      <div class="notice notice-danger mt-4 hidden" id="admin-error"></div>
      <form id="setup-admin" class="mt-4 space-y-4">
        <div>
          <label class="label" for="su-user">{{t 'setup_wizard.username'}}</label>
          <input class="input" id="su-user" name="username" autocomplete="username" required minlength="2" maxlength="32">
        </div>
        <div>
          <label class="label" for="su-pass">{{t 'setup_wizard.password'}}</label>
          <input class="input" id="su-pass" name="password" type="password" autocomplete="new-password" required minlength="8">
          <p class="help">{{t 'setup_wizard.password_help'}}</p>
        </div>
        {{#if needsPin}}
        <div>
          <label class="label" for="su-pin">{{t 'setup_wizard.pin_label'}}</label>
          <input class="input" id="su-pin" name="pin" inputmode="numeric" autocomplete="off" required maxlength="12" placeholder="{{t 'setup_wizard.pin_placeholder'}}">
          <p class="help">{{t 'setup_wizard.pin_help'}}</p>
        </div>
        {{/if}}
        <div class="flex items-center gap-2">
          <button class="btn btn-ghost" type="button" data-back>{{{icon 'arrow-left' 'size-4'}}} {{t 'setup_wizard.back'}}</button>
          <button class="btn btn-primary ml-auto" type="submit">{{{icon 'shield' 'size-4'}}} {{t 'setup_wizard.create_admin'}}</button>
        </div>
      </form>
    </section>

    {{! ---- Step 3: Panel configuration (optional) ---- }}
    <section data-step="3" hidden>
      <div class="flex items-center gap-2">
        <h2 class="text-lg font-semibold">{{t 'setup_wizard.panel_config_title'}}</h2>
        <span class="badge">{{t 'setup_wizard.optional'}}</span>
      </div>
      <p class="mt-1 text-sm text-ink-faint">{{t 'setup_wizard.panel_config_desc'}}</p>

      <div class="mt-5">
        <label class="label" for="su-domain">{{t 'setup_wizard.public_domain'}} <span class="text-ink-faint">({{t 'setup_wizard.optional'}})</span></label>
        <div class="flex flex-wrap gap-2">
          <input class="input min-w-0 flex-1" id="su-domain" placeholder="mc.example.com" autocomplete="off" spellcheck="false">
          <button class="btn shrink-0" type="button" id="su-domain-save">{{t 'setup_wizard.save_domain'}}</button>
        </div>
        <p class="help">{{t 'setup_wizard.domain_help'}}</p>
      </div>

      <div class="mt-5">
        <label class="label" for="su-cf">{{t 'setup_wizard.cf_key'}} <span class="text-ink-faint">({{t 'setup_wizard.optional'}})</span></label>
        <div class="flex flex-wrap gap-2">
          <input class="input min-w-0 flex-1" id="su-cf" type="password" placeholder="$2a$10$…" autocomplete="off" spellcheck="false">
          <button class="btn shrink-0" type="button" id="su-cf-save">{{t 'setup_wizard.cf_save'}}</button>
        </div>
        <p class="help">{{t 'setup_wizard.cf_help'}}</p>
      </div>

      <div class="mt-5">
        <span class="label">{{t 'setup_wizard.tz_region'}}</span>
        {{! data-native only until tzPicker fills them - it enhances post-fill. }}
        <div class="grid gap-2 sm:grid-cols-2">
          <select class="input" id="su-tz" data-native aria-label="{{t 'settings.time_zone'}}" data-label="{{t 'settings.time_zone'}}"></select>
          <select class="input" id="su-country" data-native aria-label="{{t 'settings.country'}}" data-label="{{t 'settings.country'}}"></select>
        </div>
        <p class="help">{{t 'setup_wizard.tz_help'}}</p>
        <button class="btn mt-2" type="button" id="su-loc-save">{{t 'setup_wizard.save_tz'}}</button>
      </div>

      <div class="mt-6 flex items-center">
        <button class="btn btn-primary ml-auto" data-next>{{t 'setup_wizard.continue'}} {{{icon 'arrow-right' 'size-4'}}}</button>
      </div>
    </section>

    {{! ---- Step 4: Done ---- }}
    <section data-step="4" hidden>
      <div class="grid place-items-center py-2 text-center">
        <span class="grid size-12 place-items-center rounded-full bg-grass-600/15 text-ok">{{{icon 'party-popper' 'size-6'}}}</span>
        <h2 class="mt-3 text-lg font-semibold">{{t 'setup_wizard.all_set_title'}}</h2>
        <p class="mt-1 max-w-sm text-sm text-ink-faint">{{t 'setup_wizard.all_set_desc'}}</p>
      </div>
      <div class="mt-4 flex flex-col gap-2">
        <a class="btn btn-primary w-full" href="/servers/new">{{{icon 'plus' 'size-4'}}} {{t 'setup_wizard.create_server'}}</a>
        <a class="btn btn-ghost w-full" href="/">{{t 'setup_wizard.go_to_dashboard'}}</a>
      </div>
    </section>
  </div>
</div>
<script type="module" src="/js/pages/setup.js"></script>
