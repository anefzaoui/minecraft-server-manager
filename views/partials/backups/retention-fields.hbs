{{!-- Backup retention fields, shared by the Settings page card and a server's
    Backups tab so the two can't drift. public/js/lib/retention.js reads every
    [data-retention-key] input. Params: prefix (id prefix), values (the six
    numbers). Bounds match the API's retentionPatchSchema. --}}
<div class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
  <div>
    <label class="label" for="{{prefix}}-scheduled">Scheduled backups to keep</label>
    <input class="input" id="{{prefix}}-scheduled" type="number" inputmode="numeric" min="1" max="500" value="{{values.keepScheduled}}" data-retention-key="keepScheduled" data-min="1" data-max="500">
  </div>
  <div>
    <label class="label" for="{{prefix}}-manual">Manual backups to keep</label>
    <input class="input" id="{{prefix}}-manual" type="number" inputmode="numeric" min="1" max="500" value="{{values.keepManual}}" data-retention-key="keepManual" data-min="1" data-max="500">
  </div>
  <div>
    <label class="label" for="{{prefix}}-preupdate">Pre-update backups to keep</label>
    <input class="input" id="{{prefix}}-preupdate" type="number" inputmode="numeric" min="1" max="500" value="{{values.keepPreUpdate}}" data-retention-key="keepPreUpdate" data-min="1" data-max="500">
    <p class="help">Taken automatically before an update is applied.</p>
  </div>
  <div>
    <label class="label" for="{{prefix}}-prerestore">Safety backups to keep</label>
    <input class="input" id="{{prefix}}-prerestore" type="number" inputmode="numeric" min="1" max="500" value="{{values.keepPreRestore}}" data-retention-key="keepPreRestore" data-min="1" data-max="500">
    <p class="help">Taken automatically before a restore or a world reset.</p>
  </div>
  <div>
    <label class="label" for="{{prefix}}-age">Remove backups older than (days)</label>
    <input class="input" id="{{prefix}}-age" type="number" inputmode="numeric" min="0" max="3650" value="{{values.maxAgeDays}}" data-retention-key="maxAgeDays" data-min="0" data-max="3650">
    <p class="help">0 means no age limit.</p>
  </div>
  <div>
    <label class="label" for="{{prefix}}-size">Total size per server (GB)</label>
    <input class="input" id="{{prefix}}-size" type="number" inputmode="numeric" min="0" max="100000" value="{{values.maxTotalGb}}" data-retention-key="maxTotalGb" data-min="0" data-max="100000">
    <p class="help">0 means no size limit. Over it, the oldest go first, safety backups before any others.</p>
  </div>
</div>
<p class="help">The newest backup of each server is never removed by the age or size limits.</p>
