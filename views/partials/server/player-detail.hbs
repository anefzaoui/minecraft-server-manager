<div data-player-detail data-server-id="{{server.id}}" data-player-name="{{player.name}}" data-player-uuid="{{player.uuid}}"
     data-running="{{#if (or (eq server.status 'running') (eq server.status 'unhealthy'))}}1{{else}}0{{/if}}">

  <a href="/servers/{{server.id}}/players" class="mb-3 inline-flex items-center gap-1 text-sm text-ink-faint transition hover:text-ink">{{{icon 'arrow-left' 'size-4'}}} {{t 'player_detail.all_players'}}</a>

  <div class="card mb-4 p-4">
    <div class="flex flex-wrap items-center gap-4">
      <span class="grid size-14 shrink-0 place-items-center rounded-lg bg-inset text-xl font-bold">
        {{#if player.bedrock}}{{{icon 'gamepad-2' 'size-6'}}}{{else}}{{player.name.[0]}}{{/if}}
      </span>
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-lg font-bold">{{player.name}}</h2>
          {{#if player.bedrock}}<span class="chip shrink-0" data-tip="{{t 'player_detail.bedrock_tip'}}">{{{icon 'gamepad-2' 'size-3'}}} Bedrock</span>{{/if}}
          <span data-player-status>
            {{#if player.online}}
              <span class="flex items-center gap-1.5 text-xs font-medium text-ok"><span class="status-dot relative bg-grass-500 pulse"></span> {{t 'player_detail.online'}}</span>
            {{else}}
              <span class="flex items-center gap-1.5 text-xs font-medium text-ink-faint"><span class="status-dot bg-stone-500"></span> {{t 'player_detail.offline'}}</span>
            {{/if}}
          </span>
        </div>
        {{#if player.uuid}}<div class="mt-0.5 font-mono text-xs text-ink-faint">{{player.uuid}}</div>{{/if}}
        {{#if player.lastSeen}}<div class="text-xs text-ink-faint">{{t 'players_page.seen_prefix'}} ~{{player.lastSeen}}</div>{{/if}}
      </div>
      <div class="flex flex-wrap items-center gap-1.5">
        <button class="chip {{#if player.whitelisted}}border-grass-700 bg-grass-500/15 text-ok{{/if}}"
                data-role-toggle="whitelist" data-on="{{#if player.whitelisted}}1{{else}}0{{/if}}"
                data-tip="{{#if player.whitelisted}}{{t 'players_page.remove_whitelist_tip'}}{{else}}{{t 'players_page.add_whitelist_tip'}}{{/if}}">{{{icon 'shield-check' 'size-3.5'}}} <span data-chip-label>{{t 'player_detail.whitelist'}}</span></button>
        <button class="chip {{#if player.op}}border-diamond-700 bg-diamond-400/15 text-link{{/if}}"
                data-role-toggle="op" data-on="{{#if player.op}}1{{else}}0{{/if}}"
                data-tip="{{#if player.op}}{{t 'players_page.remove_op_tip'}}{{else}}{{t 'players_page.make_op_tip'}}{{/if}}">{{{icon 'shield' 'size-3.5'}}} <span data-chip-label>{{t 'player_detail.op'}}{{#if player.op}} {{t 'player_detail.op_level' level=player.opLevel}}{{/if}}</span></button>
        <button class="chip {{#if player.banned}}border-danger/40 bg-redstone-500/15 text-danger{{/if}}"
                data-role-toggle="ban" data-on="{{#if player.banned}}1{{else}}0{{/if}}"
                data-tip="{{#if player.banned}}{{t 'players_page.pardon_player_tip'}}{{else}}{{t 'players_page.ban_player_tip'}}{{/if}}">{{{icon 'ban' 'size-3.5'}}} <span data-chip-label>{{#if player.banned}}{{t 'player_detail.banned'}}{{else}}{{t 'player_detail.ban'}}{{/if}}</span></button>
        {{#if player.online}}<button class="btn btn-ghost btn-sm" data-act="kick" data-tip="{{t 'players_page.kick_tip'}}">{{{icon 'log-out' 'size-3.5'}}} {{t 'player_detail.kick'}}</button>{{/if}}
        {{#if (or (eq server.status 'running') (eq server.status 'unhealthy'))}}
          <button class="btn btn-ghost btn-sm" data-act="teleport" data-tip="{{t 'players_page.teleport_tip'}}">{{{icon 'compass' 'size-3.5'}}} {{t 'player_detail.teleport'}}</button>
        {{/if}}
        {{! Labeled like its siblings - a lone glyph in a row of labeled actions reads as noise. }}
        {{#if player.uuid}}<button class="btn btn-ghost btn-sm" data-act="copy-uuid" data-copy="{{player.uuid}}">{{{icon 'clipboard-copy' 'size-3.5'}}} {{t 'player_detail.copy_uuid'}}</button>{{/if}}
        {{#if player.uuid}}{{#unless player.online}}<button class="btn btn-ghost btn-sm text-danger" data-act="delete-player" data-tip="{{t 'player_detail.delete_player_tip'}}">{{{icon 'trash-2' 'size-3.5'}}} {{t 'player_detail.delete_player'}}</button>{{/unless}}{{/if}}
      </div>
    </div>
    {{#if player.banned}}
      <div class="notice notice-danger mt-3 text-xs" data-ban-banner>{{{icon 'ban' 'size-4 mt-0.5 shrink-0 text-danger'}}}<div><b class="text-danger">{{t 'player_detail.banned_prefix'}}</b> {{default player.banReason (t 'players_page.no_reason_recorded')}}{{#if player.banDate}} · {{player.banDate}}{{/if}}{{#if player.banExpires}} · {{t 'players_page.expires_label' date=player.banExpires}}{{/if}}</div></div>
    {{/if}}
  </div>

  <div class="card mb-4 p-4" data-notes-card>
    <div class="mb-3 flex items-center justify-between">
      <h3 class="font-semibold">{{t 'player_detail.notes_heading'}}</h3>
      <button class="btn btn-ghost btn-sm" data-notes-add>{{{icon 'plus' 'size-3.5'}}} {{t 'player_detail.add_note'}}</button>
    </div>
    <div class="space-y-2" data-notes-list></div>
    <p class="text-sm text-ink-faint" data-notes-empty>{{t 'player_detail.no_notes'}}</p>
  </div>

  {{! The player's inventory - reuses the inventory editor, pinned to this player
      (no picker, no server-wide search). }}
  {{> server/inventory fixedPlayer=player}}
</div>
<script type="module" src="/js/pages/player-detail.js"></script>
