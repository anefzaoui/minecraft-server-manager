<div data-mods-server="{{server.id}}" data-mods-type="{{server.type}}" data-mods-loader="{{server.loader}}" data-mods-mc="{{server.mcVersion}}" data-mods-cf="{{#if curseforgeEnabled}}true{{else}}false{{/if}}">
  <div class="mb-4 flex flex-wrap items-center gap-2">
    {{#if mods.length}}
    <input class="input max-w-xs" placeholder="{{t 'mods_page.search_placeholder'}}" id="mods-filter">
    <select class="input w-auto" data-label="{{t 'mods_page.filter_source'}}" id="mods-source">
      <option value="">{{t 'mods_page.source_all'}}</option><option value="pack">{{t 'mods_page.source_pack'}}</option><option value="overlay">{{t 'mods_page.source_custom'}}</option>
    </select>
    {{/if}}
    <div class="ml-auto flex flex-wrap gap-2{{#unless perms.content}} hidden{{/unless}}">
      {{#if hasModUpdates}}
      <button class="btn btn-ghost btn-sm text-warn" id="mods-update-all" data-tip="{{t 'mods_page.update_all_tip'}}">{{{icon 'circle-arrow-up' 'size-3.5'}}} {{t 'mods_page.update_all'}}</button>
      {{/if}}
      <button class="btn btn-sm" id="mods-search">{{{icon 'search' 'size-3.5'}}} {{t 'mods_page.search_mods'}}</button>
      <button class="btn btn-sm" id="mods-import-zip" data-tip="{{t 'mods_page.import_zip_tip'}}">{{{icon 'archive' 'size-3.5'}}} {{t 'mods_page.import_zip'}}</button>
      <button class="btn btn-primary btn-sm" id="mods-add-url">{{{icon 'plus' 'size-3.5'}}} {{t 'mods_page.add_by_url'}}</button>
      {{! button labels kept in sync with the modal titles in mods.js }}
    </div>
  </div>

  {{! Populated by JS when the pack has mods that need manual action (MODS_NEED_DOWNLOAD.txt). }}
  <div id="mods-pending" class="mb-4 hidden"></div>

  {{#if server.pack}}
    <div class="notice notice-info mb-4 max-w-prose text-xs">
      {{{icon 'info' 'size-4 mt-0.5 shrink-0'}}}
      <div><b class="text-link">{{t 'mods_page.pack_managed'}}</b> {{t 'mods_page.pack_mods_desc_1'}} {{platformName server.pack.platform}} ({{server.pack.name}} {{server.pack.version}}).
      {{t 'mods_page.pack_mods_desc_2'}} <b class="text-ok">{{t 'mods_page.custom'}}</b> {{t 'mods_page.pack_mods_desc_3'}}</div>
    </div>
  {{/if}}

  {{#if mods.length}}
  <div class="card overflow-x-auto">
    <table class="table-base table-stack" id="mods-table">
      <thead><tr>
        <th>{{t 'mods_page.th_mod'}}</th><th>{{t 'mods_page.th_source'}}</th><th>{{t 'mods_page.th_version'}}</th><th class="text-right">{{t 'mods_page.th_size'}}</th><th>{{t 'mods_page.th_status'}}</th><th class="text-right">{{t 'mods_page.th_actions'}}</th>
      </tr></thead>
      <tbody>
        {{#each mods}}
          <tr class="{{#unless enabled}}opacity-60{{/unless}}" data-mod-row data-file="{{file}}" data-name="{{name}}" data-source="{{source}}" data-enabled="{{enabled}}">
            {{! w-full + max-w-0 (sm+ only) so `truncate` actually engages - long mod file
                names were widening the table into horizontal scroll. }}
            <td data-th="" class="sm:w-full sm:max-w-0">
              <div class="flex items-center gap-2.5">
                {{#if iconUrl}}
                  <img src="{{iconUrl}}" alt="" loading="lazy" data-mod-icon class="size-8 shrink-0 rounded bg-inset object-cover">
                {{else}}
                  <span class="grid size-8 shrink-0 place-items-center rounded bg-inset text-ink-faint">{{{icon 'puzzle' 'size-4'}}}</span>
                {{/if}}
                <div class="min-w-0">
                  <div class="truncate font-medium" title="{{name}}">{{name}}</div>
                  <div class="truncate font-mono text-xs text-ink-faint" title="{{file}}">{{file}}</div>
                </div>
              </div>
            </td>
            <td data-th="{{t 'mods_page.th_source'}}">
              {{#if (eq source 'pack')}}
                <span class="badge badge-info">{{t 'mods_page.badge_pack'}}</span>
              {{else if (eq source 'overlay')}}
                <span class="badge badge-ok">{{t 'mods_page.badge_custom'}}</span>
                {{#if sharedWith}}<div class="mt-1 text-[11px] text-ink-faint">{{t 'mods_page.shared_with_count' count=sharedWith}}</div>{{/if}}
              {{else}}
                <span class="badge">{{t 'mods_page.badge_file'}}</span>
              {{/if}}
              {{#if (eq kind 'datapack')}}<div class="mt-1"><span class="badge">{{t 'mods_page.badge_datapack'}}</span></div>{{/if}}
            </td>
            <td data-th="{{t 'mods_page.th_version'}}">
              {{default version '-'}}
              {{#if updateAvailable}}<span class="badge badge-warn ml-1" data-tip="{{t 'mods_page.update_available_tip'}}">→ {{updateAvailable}}</span>{{/if}}
              {{#if updateIgnored}}<span class="badge ml-1 text-ink-faint" data-tip="{{t 'mods_page.update_ignored_tip'}}">{{t 'mods_page.ignored_arrow' version=updateIgnored}}</span>{{/if}}
              {{#if revertTo}}<div class="mt-1 text-[11px] text-ink-faint">{{t 'mods_page.updated_from' version=revertTo}}</div>{{/if}}
            </td>
            <td data-th="{{t 'mods_page.th_size'}}" class="text-right text-ink-faint">{{bytes size}}</td>
            <td data-th="{{t 'mods_page.th_status'}}">
              {{#if missing}}
                <span class="text-xs font-medium text-danger" data-tip="{{t 'mods_page.missing_file_tip'}}">{{t 'mods_page.status_missing'}}</span>
              {{else if enabled}}
                <span class="text-xs font-medium text-ok">{{t 'mods_page.status_enabled'}}</span>
              {{else}}
                <span class="text-xs font-medium text-ink-faint">{{t 'mods_page.status_disabled'}}</span>
              {{/if}}
            </td>
            <td data-th="" class="text-right">
              <div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
                {{#if updateAvailable}}
                  <button class="btn btn-ghost btn-sm text-warn" data-mod-update data-tip="{{t 'mods_page.update_to_tip' version=updateAvailable}}">{{{icon 'circle-arrow-up' 'size-3.5'}}} {{t 'mods_page.btn_update'}}</button>
                  <button class="btn btn-ghost btn-sm" data-mod-ignore-update data-tip="{{t 'mods_page.stop_offering_tip' version=updateAvailable}}">{{{icon 'bell-off' 'size-3.5'}}} {{t 'mods_page.btn_ignore'}}</button>
                {{/if}}
                {{#if updateIgnored}}
                  <button class="btn btn-ghost btn-sm" data-mod-unignore-update data-tip="{{t 'mods_page.offer_again_tip' version=updateIgnored}}">{{{icon 'bell' 'size-3.5'}}} {{t 'mods_page.btn_unignore'}}</button>
                {{/if}}
                {{#if revertTo}}
                  <button class="btn btn-ghost btn-sm" data-mod-revert data-revert-to="{{revertTo}}" data-tip="{{t 'mods_page.revert_to_tip' version=revertTo}}">{{{icon 'undo-2' 'size-3.5'}}} {{t 'mods_page.btn_revert'}}</button>
                {{/if}}
                {{#unless missing}}
                  <button class="btn btn-ghost btn-sm" data-mod-toggle data-tip="{{#if (eq source 'pack')}}{{t 'mods_page.pack_mods_restart_tip'}}{{else}}{{t 'mods_page.takes_effect_instantly_tip'}}{{/if}}">{{#if enabled}}{{t 'mods_page.btn_disable'}}{{else}}{{t 'mods_page.btn_enable'}}{{/if}}</button>
                {{/unless}}
                {{#if (ne source 'pack')}}
                  <button class="btn btn-ghost btn-sm text-danger" data-mod-delete aria-label="{{t 'mods_page.aria_delete' name=name}}">{{{icon 'x' 'size-3.5'}}}</button>
                {{/if}}
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{! Cloned in by the global image-error handler (app.js) when a /library/icons
      request 404s, so a stale icon path degrades to this exact placeholder
      instead of a broken-image glyph. }}
  <template id="mod-icon-fallback"><span class="grid size-8 shrink-0 place-items-center rounded bg-inset text-ink-faint">{{{icon 'puzzle' 'size-4'}}}</span></template>
  {{else}}
    {{> empty-state iconName='puzzle' title=(t 'mods_page.empty_title') message=(t 'mods_page.empty_message')}}
  {{/if}}
</div>
<script type="module" src="/js/pages/mods.js"></script>
