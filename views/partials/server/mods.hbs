<div data-mods-server="{{server.id}}" data-mods-type="{{server.type}}" data-mods-loader="{{server.loader}}" data-mods-mc="{{server.mcVersion}}" data-mods-cf="{{#if curseforgeEnabled}}true{{else}}false{{/if}}" data-mods-can-install="{{#if perms.content}}1{{/if}}">
  <div class="mb-4 flex flex-wrap items-center gap-2">
    {{#if mods.length}}
    <input class="input max-w-xs" placeholder="Search installed mods…" id="mods-filter">
    <select class="input w-auto" data-label="Filter by source" id="mods-source">
      <option value="">All sources</option><option value="pack">Pack-managed</option><option value="overlay">Custom</option>
    </select>
    {{/if}}
    <div class="ml-auto flex flex-wrap gap-2{{#unless perms.content}} hidden{{/unless}}">
      {{#if hasModUpdates}}
      <button class="btn btn-ghost btn-sm text-warn" id="mods-update-all" data-tip="Apply every available update, then restart the server once">{{{icon 'circle-arrow-up' 'size-3.5'}}} Update All</button>
      {{/if}}
      <button class="btn btn-sm" id="mods-search">{{{icon 'search' 'size-3.5'}}} Search Mods</button>
      <button class="btn btn-sm" id="mods-import-zip" data-tip="Modrinth .mrpack, CurseForge modpack export, or any zip of mod jars">{{{icon 'archive' 'size-3.5'}}} Import Zip</button>
      <button class="btn btn-primary btn-sm" id="mods-add-url">{{{icon 'plus' 'size-3.5'}}} Add by URL</button>
      {{! button labels kept in sync with the modal titles in mods.js }}
    </div>
  </div>

  {{! Populated by JS when the pack has mods that need manual action (MODS_NEED_DOWNLOAD.txt). }}
  <div id="mods-pending" class="mb-4 hidden"></div>

  {{#if server.pack}}
    <div class="notice notice-info mb-4 max-w-prose text-xs">
      {{{icon 'info' 'size-4 mt-0.5 shrink-0'}}}
      <div><b class="text-link">Pack-managed</b> mods are installed by {{platformName server.pack.platform}} ({{server.pack.name}} {{server.pack.version}}).
      Disabling one takes effect on the next restart. <b class="text-ok">Custom</b> mods are ones you added yourself.
      They live in the shared library, survive pack updates, and can be turned on or off instantly.</div>
    </div>
  {{/if}}

  {{#if mods.length}}
  <div class="card overflow-x-auto">
    <table class="table-base table-stack" id="mods-table">
      <thead><tr>
        <th>Mod</th><th>Source</th><th>Version</th><th class="text-right">Size</th><th>Status</th><th class="text-center">Actions</th>
      </tr></thead>
      <tbody>
        {{#each mods}}
          <tr class="{{#unless enabled}}opacity-60{{/unless}}" data-mod-row data-file="{{file}}" data-name="{{name}}" data-source="{{source}}" data-enabled="{{enabled}}">
            {{! w-full + max-w-0 (sm+ only) so `truncate` actually engages - long mod file
                names were widening the table into horizontal scroll. }}
            <td data-th="" class="sm:w-full sm:max-w-0">
              <div class="flex items-center gap-2.5">
                {{#if iconUrl}}
                  <img src="{{iconUrl}}" alt="" loading="lazy" data-mod-icon class="size-8 shrink-0 rounded bg-inset object-cover">
                {{else}}
                  <span class="grid size-8 shrink-0 place-items-center rounded bg-inset text-ink-faint">{{{icon 'puzzle' 'size-4'}}}</span>
                {{/if}}
                <div class="min-w-0">
                  <div class="truncate font-medium" title="{{name}}">{{name}}</div>
                  <div class="truncate font-mono text-xs text-ink-faint" title="{{file}}">{{file}}</div>
                </div>
              </div>
            </td>
            <td data-th="Source">
              {{#if (eq source 'pack')}}
                <span class="badge badge-info">pack</span>
              {{else if (eq source 'overlay')}}
                {{! Origin, not management: a registry install names its registry,
                    a hand-added jar is manual. The filter still groups by overlay. }}
                {{#if platform}}
                  <span class="badge badge-ok">{{platformName platform}}</span>
                {{else}}
                  <span class="badge badge-ok">manual</span>
                {{/if}}
                {{#if sharedWith}}<div class="mt-1 whitespace-nowrap text-[11px] text-ink-faint">on {{sharedWith}} server{{#if (gt sharedWith 1)}}s{{/if}}</div>{{/if}}
              {{else}}
                <span class="badge">file</span>
              {{/if}}
              {{#if (eq kind 'datapack')}}<div class="mt-1"><span class="badge">datapack</span></div>{{/if}}
            </td>
            <td data-th="Version" class="font-mono text-xs text-ink-faint sm:max-w-40" title="{{default version '-'}}">
              <span class="block truncate">{{default version '-'}}</span>
              {{#if updateAvailable}}<span class="badge badge-warn ml-1" data-tip="Update available">→ {{updateAvailable}}</span>{{/if}}
              {{#if updateIgnored}}<span class="badge ml-1 text-ink-faint" data-tip="This update is ignored and won't be applied">ignored → {{updateIgnored}}</span>{{/if}}
              {{#if revertTo}}<div class="mt-1 whitespace-nowrap text-[11px] text-ink-faint">updated from {{revertTo}}</div>{{/if}}
            </td>
            <td data-th="Size" class="whitespace-nowrap text-right text-ink-faint">{{bytes size}}</td>
            <td data-th="Status">
              {{#if missing}}
                <span class="text-xs font-medium text-danger" data-tip="File missing on disk. Reinstall it from the library.">Missing</span>
              {{else}}
                {{! Toggle switch carrying the enable state; the click handler
                    in mods.js sends the opposite of the last confirmed value. }}
                <span class="msm-toggle">
                  <input type="checkbox" data-mod-toggle {{#if enabled}}checked{{/if}} data-label="Enable {{name}}"
                    data-tip="{{#if enabled}}{{#if (eq source 'pack')}}On - pack mods take effect on the next restart.{{else}}On - click to disable.{{/if}}{{else}}Off - click to enable.{{/if}}">
                  <span></span>
                </span>
              {{/if}}
            </td>
            {{! Centered (not right-aligned): with a single icon action the
                right-aligned group read as drifting off-column. }}
            <td data-th="" class="text-center whitespace-nowrap">
              <div class="flex flex-wrap items-center justify-center gap-1 sm:inline-flex sm:flex-nowrap">
                {{#if updateAvailable}}
                  <button class="btn btn-ghost btn-sm text-warn" data-mod-update data-tip="Update to {{updateAvailable}}, then restart the server">{{{icon 'circle-arrow-up' 'size-3.5'}}} Update</button>
                  <button class="btn btn-ghost btn-sm" data-mod-ignore-update data-tip="Stop offering {{updateAvailable}}">{{{icon 'bell-off' 'size-3.5'}}} Ignore</button>
                {{/if}}
                {{#if updateIgnored}}
                  <button class="btn btn-ghost btn-sm" data-mod-unignore-update data-tip="Offer {{updateIgnored}} again">{{{icon 'bell' 'size-3.5'}}} Un-ignore</button>
                {{/if}}
                {{#if revertTo}}
                  <button class="btn btn-ghost btn-sm" data-mod-revert data-revert-to="{{revertTo}}" data-tip="Put this mod back on {{revertTo}}, then restart the server">{{{icon 'undo-2' 'size-3.5'}}} Revert</button>
                {{/if}}
                {{#if (ne source 'pack')}}
                  <button class="btn btn-ghost btn-sm text-danger" data-mod-delete aria-label="Delete {{name}}" data-tip="Delete {{name}}">{{{icon 'trash-2' 'size-3.5'}}}</button>
                {{/if}}
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{! Cloned in by the global image-error handler (app.js) when a /library/icons
      request 404s, so a stale icon path degrades to this exact placeholder
      instead of a broken-image glyph. }}
  <template id="mod-icon-fallback"><span class="grid size-8 shrink-0 place-items-center rounded bg-inset text-ink-faint">{{{icon 'puzzle' 'size-4'}}}</span></template>
  {{else}}
    {{> empty-state iconName='puzzle' title='No Mods Installed Yet' message='Search Modrinth or CurseForge; add a mod, plugin, or datapack by URL; or import a zip with the buttons above. Custom content lives in the shared library and survives pack updates.'}}
  {{/if}}
  {{! Trending projects for this server's loader and version, from the
      registry's own discover feed - every recommendation is installable here.
      Always shown, not just on the empty state. Filled in by mods.js;
      CurseForge needs the stored API key. }}
  <div class="mt-6" data-mods-discover>
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <h3 class="eyebrow">Recommended</h3>
      <div class="seg" role="group" aria-label="Recommendation source">
        <button type="button" class="seg-btn" aria-pressed="true" data-discover-platform="modrinth">Modrinth</button>
        {{#if curseforgeEnabled}}<button type="button" class="seg-btn" aria-pressed="false" data-discover-platform="curseforge">CurseForge</button>{{/if}}
      </div>
      <span class="ml-auto text-xs text-ink-faint">Popular with this loader and version.</span>
    </div>
    <div class="grid gap-3 md:grid-cols-2" data-discover-results></div>
  </div>
</div>
<script type="module" src="/js/pages/mods.js"></script>
