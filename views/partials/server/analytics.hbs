<div data-analytics-server="{{server.id}}">
  <div class="grid items-start gap-4 xl:grid-cols-5">

    <div class="card xl:col-span-2">
      <div class="flex flex-wrap items-center gap-2 border-b border-line p-3">
        <h3 class="flex items-center gap-1.5 font-semibold">{{{icon 'trophy' 'size-4'}}} {{t 'analytics_tab.scoreboard'}}</h3>
        <button class="btn btn-ghost btn-sm ml-auto" id="an-refresh" data-tip="{{t 'analytics_tab.refresh_tip'}}">{{{icon 'refresh-cw' 'size-3.5'}}} {{t 'analytics_tab.refresh'}}</button>
      </div>
      <div class="flex flex-wrap gap-2 border-b border-line p-3">
        <select class="input w-auto flex-1" id="an-metric" data-label="{{t 'analytics_tab.rank_by'}}">
          <option value="playtimeTicks">{{t 'analytics_tab.playtime'}}</option>
          <option value="deaths">{{t 'analytics_tab.deaths'}}</option>
          <option value="mobKills">{{t 'analytics_tab.mob_kills'}}</option>
          <option value="playerKills">{{t 'analytics_tab.player_kills'}}</option>
          <option value="blocksMinedTotal">{{t 'analytics_tab.blocks_mined'}}</option>
          <option value="diamondsMined">{{t 'analytics_tab.diamonds_mined'}}</option>
          <option value="distanceCm">{{t 'analytics_tab.distance'}}</option>
        </select>
        <select class="input w-auto" id="an-window" data-label="{{t 'analytics_tab.time_window'}}">
          <option value="all">{{t 'analytics_tab.all_time'}}</option>
          <option value="7d">{{t 'analytics_tab.last_7_days'}}</option>
          <option value="24h">{{t 'analytics_tab.last_24_hours'}}</option>
        </select>
      </div>
      <div class="overflow-x-auto">
        <table class="table-base">
          <thead><tr><th class="w-10">{{t 'analytics_tab.th_num'}}</th><th>{{t 'analytics_tab.th_player'}}</th><th class="text-right">{{t 'analytics_tab.th_value'}}</th></tr></thead>
          <tbody id="an-scoreboard">
            <tr><td colspan="3" class="p-6 text-center text-ink-faint">{{t 'common.loading'}}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="help border-t border-line p-3">{{t 'analytics_tab.stats_help'}}</p>
    </div>

    <div class="card xl:col-span-3">
      <div class="flex flex-wrap items-center gap-2 border-b border-line p-3">
        <h3 class="flex items-center gap-1.5 font-semibold">{{{icon 'activity' 'size-4'}}} {{t 'analytics_tab.timeline'}}</h3>
        <input class="input ml-auto w-full max-w-xs" id="an-search" placeholder="{{t 'analytics_tab.search_timeline'}}" autocomplete="off">
      </div>
      <div class="flex flex-wrap gap-2 border-b border-line p-3">
        <label class="chip cursor-pointer gap-1.5"><input type="checkbox" class="msm-check" data-an-type="chat" checked> {{t 'analytics_tab.chat'}}</label>
        <label class="chip cursor-pointer gap-1.5"><input type="checkbox" class="msm-check" data-an-type="join" checked> {{t 'analytics_tab.joins'}}</label>
        <label class="chip cursor-pointer gap-1.5"><input type="checkbox" data-an-type="leave" class="msm-check" checked> {{t 'analytics_tab.leaves'}}</label>
        <label class="chip cursor-pointer gap-1.5"><input type="checkbox" class="msm-check" data-an-type="death" checked> {{t 'analytics_tab.deaths'}}</label>
        <label class="chip cursor-pointer gap-1.5"><input type="checkbox" class="msm-check" data-an-type="advancement" checked> {{t 'analytics_tab.advancements'}}</label>
      </div>
      <ol class="divide-y divide-line" id="an-timeline">
        <li class="p-6 text-center text-ink-faint">{{t 'common.loading'}}</li>
      </ol>
      <div class="border-t border-line p-3">
        {{! hidden until the first response proves there IS anything older. }}
        <button class="btn btn-sm w-full hidden" id="an-older">{{t 'analytics_tab.load_older'}}</button>
      </div>
      <p class="help px-3 pb-3">{{t 'analytics_tab.privacy_note'}}</p>
    </div>

  </div>
</div>
<script type="module" src="/js/pages/analytics.js"></script>

<div class="card mt-4" data-investigation-server="{{server.id}}">
  <div class="flex flex-wrap items-center gap-2 border-b border-line p-3">
    <h3 class="flex items-center gap-1.5 font-semibold">{{{icon 'shield' 'size-4'}}} {{t 'analytics_tab.investigation'}}</h3>
    <span class="text-xs text-ink-faint">{{t 'analytics_tab.investigation_sub'}}</span>
    <button class="btn btn-sm ml-auto" id="inv-run">{{{icon 'search' 'size-3.5'}}} {{t 'analytics_tab.analyze_mining'}}</button>
  </div>
  <div id="inv-results" class="p-4 text-sm text-ink-faint">{{t 'analytics_tab.run_analysis'}}</div>
</div>
<script type="module" src="/js/pages/investigation.js"></script>
