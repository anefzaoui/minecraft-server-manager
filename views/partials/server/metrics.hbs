{{#if (or (eq server.status 'stopped') (eq server.status 'crashed'))}}
  <div class="notice mb-4">{{t 'metrics_tab.stopped_notice'}}</div>
{{else if (or (eq server.status 'starting') (eq server.status 'updating'))}}
  <div class="notice mb-4">{{t 'metrics_tab.starting_notice'}}</div>
{{/if}}

<div data-metrics-server="{{server.id}}"
     data-metrics-running="{{#if (or (eq server.status 'running') (eq server.status 'unhealthy') (eq server.status 'stalled'))}}1{{else}}0{{/if}}"
     data-metrics-mem-limit="{{server.resources.containerMemoryMb}}"
     data-metrics-cpu-limit="{{server.resources.cpus}}"
     data-metrics-perf-supported="{{#if server.stats.perfSupported}}1{{else}}0{{/if}}"
     {{#if server.stats.startedAt}}data-metrics-started-at="{{server.stats.startedAt}}"{{/if}}>

  {{! ---- Top stat strip ---- }}
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
    <div class="card p-3">
      <div class="eyebrow">{{t 'metrics_tab.status'}}</div>
      <div class="mt-1 flex items-center gap-1.5 text-sm font-bold {{statusText server.status}}">
        <span class="status-dot relative {{statusDot server.status}} {{#if (statusPulse server.status)}}pulse{{/if}}"></span>
        {{statusLabel server.status}}
      </div>
      <div class="text-xs text-ink-faint">{{default server.statusDetail "-"}}</div>
    </div>
    <div class="card p-3">
      <div class="eyebrow">{{t 'metrics_tab.uptime'}}</div>
      <div class="mt-1 text-lg font-bold tabular-nums" data-metric="uptime">{{default server.stats.uptime "-"}}</div>
    </div>
    <div class="card p-3">
      <div class="eyebrow">{{t 'metrics_tab.players'}}</div>
      <div class="mt-1 text-lg font-bold tabular-nums" data-metric="players">{{server.players.online}}/{{server.players.max}}</div>
    </div>
    {{#if server.stats.perfSupported}}
      <div class="card p-3">
        <div class="eyebrow">{{t 'metrics_tab.tps'}}</div>
        {{#if server.stats.perf}}
          <div class="mt-1 text-lg font-bold tabular-nums" data-metric="tps">{{server.stats.perf.tps1}}</div>
          <div class="text-xs text-ink-faint" data-metric="mspt">{{#if server.stats.perf.mspt}}{{server.stats.perf.mspt}} {{t 'metrics_tab.ms_per_tick'}}{{else}}{{t 'metrics_tab.last_1_min'}}{{/if}}</div>
        {{else}}
          <div class="mt-1 text-lg font-bold tabular-nums text-ink-faint" data-metric="tps">…</div>
          <div class="text-xs text-ink-faint">{{t 'metrics_tab.reading'}}</div>
        {{/if}}
      </div>
    {{/if}}
    <div class="card p-3">
      <div class="eyebrow">{{t 'metrics_tab.cpu'}}</div>
      <div class="mt-1 text-lg font-bold tabular-nums" data-metric="cpu">{{server.stats.cpuPct}}%</div>
      <div class="text-xs text-ink-faint">{{#if server.resources.cpus}}{{t 'metrics_tab.of_cores' count=server.resources.cpus}}{{else}}{{t 'metrics_tab.no_limit'}}{{/if}}</div>
    </div>
    <div class="card p-3">
      <div class="eyebrow">{{t 'metrics_tab.memory'}}</div>
      <div class="mt-1 text-lg font-bold tabular-nums" data-metric="mem">{{server.stats.memUsedMb}}</div>
      <div class="text-xs text-ink-faint">/ {{server.resources.containerMemoryMb}} MB{{#if server.memory.heapMb}} · {{t 'metrics_tab.heap_metric' mb=server.memory.heapMb}}{{/if}}</div>
    </div>
  </div>

  {{! ---- Charts ---- }}
  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div class="card p-4">
      <h3 class="mb-2 font-semibold">{{t 'metrics_tab.cpu'}} <span class="text-xs font-normal text-ink-faint">{{t 'metrics_tab.vs_limit'}}</span></h3>
      <canvas data-chart="cpu" height="140"></canvas>
    </div>
    <div class="card p-4">
      <h3 class="mb-2 font-semibold">{{t 'metrics_tab.memory'}} <span class="text-xs font-normal text-ink-faint">{{t 'metrics_tab.vs_container_limit'}}</span></h3>
      <canvas data-chart="memory" height="140"></canvas>
      {{#if server.memory.note}}<p class="mt-2 text-xs text-ink-faint">{{server.memory.note}}</p>{{/if}}
    </div>
    <div class="card p-4">
      <h3 class="mb-2 font-semibold">{{t 'metrics_tab.network'}}</h3>
      <canvas data-chart="network" height="140"></canvas>
    </div>
    {{#if server.stats.perfSupported}}
      <div class="card p-4" data-tps-card>
        <h3 class="mb-2 font-semibold">{{t 'metrics_tab.tick_rate'}} <span class="text-xs font-normal text-ink-faint">{{t 'metrics_tab.tps_sub'}}</span></h3>
        <canvas data-chart="tps" height="140"></canvas>
        <p class="help">{{t 'metrics_tab.tps_help'}}</p>
      </div>
    {{/if}}
  </div>

  {{! ---- Health & stability ---- }}
  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div class="card p-4">
      <h3 class="mb-3 font-semibold">{{t 'metrics_tab.health_and_stability'}}</h3>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
        <div><dt class="text-xs text-ink-faint">{{t 'metrics_tab.container_health'}}</dt><dd class="font-medium">{{#if health.health}}{{capitalize health.health}}{{else}}{{t 'common.unknown'}}{{/if}}</dd></div>
        <div><dt class="text-xs text-ink-faint">{{t 'metrics_tab.boot_phase'}}</dt><dd class="font-medium">{{#if server.statusDetail}}{{server.statusDetail}}{{else}}{{t 'status.running'}}{{/if}}</dd></div>
        <div><dt class="text-xs text-ink-faint">{{t 'metrics_tab.last_exit_code'}}</dt><dd class="font-medium">{{#if health}}{{#if health.exitCode}}{{health.exitCode}}{{else}}{{t 'metrics_tab.running_code'}}{{/if}}{{else}}{{t 'common.unknown'}}{{/if}}</dd></div>
        <div><dt class="text-xs text-ink-faint">{{t 'metrics_tab.oom_kills'}}</dt><dd class="font-medium">{{stability.oomKills}}{{#if stability.oomKills24h}} <span class="text-xs font-normal text-warn">· {{t 'metrics_tab.per_24h' count=stability.oomKills24h}}</span>{{/if}}</dd></div>
        <div><dt class="text-xs text-ink-faint">{{t 'metrics_tab.auto_restarts'}}</dt><dd class="font-medium">{{stability.autoRestarts}}{{#if stability.autoRestarts24h}} <span class="text-xs font-normal text-warn">· {{t 'metrics_tab.per_24h' count=stability.autoRestarts24h}}</span>{{/if}}</dd></div>
        <div><dt class="text-xs text-ink-faint">{{t 'metrics_tab.crashes_logged'}}</dt><dd class="font-medium">{{stability.crashes}}{{#if stability.crashes7d}} <span class="text-xs font-normal text-ink-faint">· {{t 'metrics_tab.crashes_stat' c24=stability.crashes24h c7d=stability.crashes7d}}</span>{{/if}}</dd></div>
      </dl>
      {{#if lastCrash}}
        <div class="mt-3 border-t border-line pt-3 text-sm">
          <span class="text-xs text-ink-faint">{{t 'metrics_tab.most_recent_crash'}}</span>
          <p class="mt-0.5"><a class="text-link hover:underline" href="/servers/{{server.id}}/history">{{default lastCrash.summary lastCrash.exception}}</a> <span class="text-xs text-ink-faint" data-ts="{{lastCrash.file_mtime}}">{{lastCrash.file_mtime}}</span></p>
        </div>
      {{/if}}
      {{#if health.containerId}}
        <p class="help">{{t 'metrics_tab.container_label'}} <span class="font-mono">{{short health.containerId 12}}</span> · {{t 'metrics_tab.image_label'}} <span class="font-mono">{{short health.imageId 12}}</span></p>
      {{/if}}
    </div>

    {{! ---- Recent activity ---- }}
    <div class="card p-4">
      <div class="mb-3 flex items-center justify-between gap-2">
        <h3 class="font-semibold">{{t 'metrics_tab.recent_activity'}}</h3>
        <a class="text-xs text-link hover:underline" href="/servers/{{server.id}}/history">{{t 'metrics_tab.full_history'}}</a>
      </div>
      {{#if recentEvents.length}}
        <ul class="space-y-2 text-sm">
          {{#each recentEvents}}
            <li class="flex items-baseline justify-between gap-3">
              <span class="min-w-0"><span class="truncate">{{summary}}</span> <span class="text-xs text-ink-faint">· {{actor}}</span></span>
              <span class="shrink-0 text-xs text-ink-faint" data-ts="{{ts}}">{{ts}}</span>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="text-sm text-ink-faint">{{t 'metrics_tab.no_activity'}}</p>
      {{/if}}
      {{#if server.crashesUnread}}
        <p class="mt-3 border-t border-line pt-3 text-sm text-danger">{{t 'metrics_tab.unread_crash_reports' count=server.crashesUnread}}</p>
      {{/if}}
    </div>
  </div>

  {{! ---- Storage ---- }}
  <div class="mt-4 card p-4">
    <h3 class="mb-3 font-semibold">{{t 'metrics_tab.storage'}}</h3>
    <div class="grid gap-6 lg:grid-cols-2">
      <div>
        {{#if breakdown}}
          <div class="space-y-2.5 text-xs">
            {{#each breakdown}}
              <div>
                <div class="mb-1 flex justify-between"><span>{{label}}</span><span class="text-ink-faint">{{bytes size}}</span></div>
                <div class="meter"><div class="{{default color 'bg-stone-500'}}" style="width: {{this.pct}}%"></div></div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="text-sm text-ink-faint">{{{t 'metrics_tab.no_storage_sizes'}}}</p>
        {{/if}}
        <div class="mt-4 border-t border-line pt-3">
          <div class="mb-1 flex justify-between text-xs"><span>{{t 'metrics_tab.quota'}}</span><span class="text-ink-faint">{{bytes server.disk.used}}{{#if server.disk.quota}} / {{bytes server.disk.quota}}{{else}} {{t 'metrics_tab.no_quota'}}{{/if}}</span></div>
          <div class="meter"><div class="{{meterColor server.disk.used server.disk.quota}}" style="width: {{pct server.disk.used server.disk.quota}}%"></div></div>
        </div>
        {{#if diskFree}}
          <p class="help">{{t 'metrics_tab.disk_free_help' free=(bytes diskFree)}}</p>
        {{/if}}
      </div>
      <div>
        <div class="mb-2 eyebrow">{{t 'metrics_tab.worlds'}}</div>
        {{#if worldSizes.length}}
          <ul class="space-y-1.5 text-sm">
            {{#each worldSizes}}
              <li class="flex items-baseline justify-between gap-3">
                <span class="min-w-0 truncate">{{name}}{{#if active}} <span class="badge badge-ok">{{t 'metrics_tab.active_badge'}}</span>{{/if}}</span>
                <span class="shrink-0 text-xs text-ink-faint">{{bytes sizeBytes}}</span>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="text-sm text-ink-faint">{{t 'metrics_tab.no_worlds_found'}}</p>
        {{/if}}
      </div>
    </div>
  </div>

  <p class="help mt-3">{{t 'metrics_tab.live_refresh_note'}}</p>
</div>
<script src="/vendor/chart.umd.js"></script>
<script type="module" src="/js/pages/metrics.js"></script>
