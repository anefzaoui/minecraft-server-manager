            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doTraderSpawning">
              <label class="cursor-pointer text-sm" for="wc-tg-traders">Wandering Traders</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-traders" data-wc-toggle="traders" data-rule="doTraderSpawning" data-label="Wandering Traders">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doWardenSpawning">
              <label class="cursor-pointer text-sm" for="wc-tg-wardens">Warden Spawning</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-wardens" data-wc-toggle="wardens" data-rule="doWardenSpawning" data-label="Warden Spawning">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="disableRaids">
              <label class="cursor-pointer text-sm" for="wc-tg-noraids">Disable Raids</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-noraids" data-wc-toggle="noraids" data-rule="disableRaids" data-label="Disable Raids">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="forgiveDeadPlayers">
