<div class="card p-4" data-world-controls="{{server.id}}" data-running="{{#if (or (eq server.status 'running') (eq server.status 'unhealthy'))}}1{{/if}}">
  <h3 class="mb-1 font-semibold">{{t 'world_controls.title'}}</h3>
  <p class="mb-3 text-xs text-ink-faint" data-wc-state>{{#if (eq server.status 'running')}}{{t 'world_controls.loading_state'}}{{else}}{{t 'world_controls.available_while_running'}}{{/if}}</p>
  <div class="mb-3 hidden items-center justify-between rounded-md border border-line bg-inset px-3 py-2" data-wc-clock-box>
    <div>
      <div class="text-lg font-bold tabular-nums leading-tight" data-wc-clock>--:--</div>
      <div class="text-[11px] text-ink-faint"><span data-wc-phase></span><span data-wc-day-wrap class="hidden"> {{t 'world_controls.day_prefix'}} <span data-wc-day></span></span></div>
    </div>
    {{{icon 'clock' 'size-5 text-ink-faint'}}}
  </div>
  {{! Real fieldset-level disable - pointer-events-none left the buttons in the
      tab order, and Enter/Space fired commands at a stopped server. }}
  <fieldset class="min-w-0 space-y-3" {{#unless (or (eq server.status 'running') (eq server.status 'unhealthy'))}}disabled{{/unless}}>
    <div>
      <div class="mb-1 eyebrow">{{t 'world_controls.time'}}</div>
      <div class="flex flex-wrap gap-1.5">
        <button class="chip" data-wc="time-day">{{{icon 'sun' 'size-3.5'}}} {{t 'world_controls.day'}}</button>
        <button class="chip" data-wc="time-noon">{{{icon 'sun' 'size-3.5'}}} {{t 'world_controls.noon'}}</button>
        <button class="chip" data-wc="time-night">{{{icon 'moon' 'size-3.5'}}} {{t 'world_controls.night'}}</button>
        <button class="chip" data-wc="time-midnight">{{{icon 'moon-star' 'size-3.5'}}} {{t 'world_controls.midnight'}}</button>
      </div>
    </div>
    <div>
      <div class="mb-1 eyebrow">{{t 'world_controls.weather'}}</div>
      <div class="flex flex-wrap gap-1.5">
        <button class="chip" data-wc="weather-clear">{{{icon 'sun' 'size-3.5'}}} {{t 'world_controls.clear'}}</button>
        <button class="chip" data-wc="weather-rain">{{{icon 'cloud-rain' 'size-3.5'}}} {{t 'world_controls.rain'}}</button>
        <button class="chip" data-wc="weather-thunder">{{{icon 'cloud-lightning' 'size-3.5'}}} {{t 'world_controls.thunder'}}</button>
      </div>
    </div>
    <div>
      <div class="mb-1 eyebrow">{{t 'world_controls.common_rules'}}</div>
      <div class="flex flex-wrap gap-1.5">
        <button class="chip" data-wc-toggle="keepinv" data-rule="keepInventory">{{t 'world_controls.keep_inventory'}}</button>
        <button class="chip" data-wc-toggle="instantrespawn" data-rule="doImmediateRespawn">{{t 'world_controls.instant_respawn'}}</button>
        <button class="chip" data-wc-toggle="daycycle" data-rule="doDaylightCycle">{{t 'world_controls.day_night_cycle'}}</button>
        <button class="chip" data-wc-toggle="weathercycle" data-rule="doWeatherCycle">{{t 'world_controls.weather_cycle'}}</button>
        <button class="chip" data-wc-toggle="mobspawn" data-rule="doMobSpawning">{{t 'world_controls.mob_spawning'}}</button>
        <button class="chip" data-wc-toggle="mobgrief" data-rule="mobGriefing">{{t 'world_controls.mob_griefing'}}</button>
        <button class="chip" data-wc-toggle="phantoms" data-rule="doInsomnia">{{t 'world_controls.phantoms'}}</button>
        <button class="chip" data-wc-toggle="naturalregen" data-rule="naturalRegeneration">{{t 'world_controls.natural_regeneration'}}</button>
        <button class="chip" data-wc-toggle="falldmg" data-rule="fallDamage">{{t 'world_controls.fall_damage'}}</button>
        <button class="chip" data-wc-toggle="firetick" data-rule="doFireTick">{{t 'world_controls.fire_spread'}}</button>
        <button class="chip" data-wc-toggle="tntexplodes" data-rule="tntExplodes">{{t 'world_controls.tnt_explosions'}}</button>
        <button class="chip" data-wc-toggle="deathmsg" data-rule="showDeathMessages">{{t 'world_controls.death_messages'}}</button>
        <button class="chip" data-wc-toggle="advancements" data-rule="announceAdvancements">{{t 'world_controls.advancements'}}</button>
        <button class="chip" data-wc-toggle="cmdfeedback" data-rule="sendCommandFeedback">{{t 'world_controls.command_feedback'}}</button>
      </div>
    </div>
    <div>
      <div class="mb-1 eyebrow">{{t 'world_controls.combat'}}</div>
      <div class="flex flex-wrap items-center gap-1.5">
        {{! Unlike every other chip here, PvP writes server.properties and only
            takes effect on the next start - the "on restart" tag and the pending
            badge keep it from reading as an instant toggle like its neighbours. }}
        <button class="chip" data-wc-toggle="pvp" data-rule="pvp">
          {{t 'world_controls.pvp'}} <span class="text-[10px] font-normal text-ink-faint">· {{t 'world_controls.on_restart'}}</span>
        </button>
        <span class="badge badge-warn hidden" data-wc-pvp-pending>{{t 'world_controls.restart_to_apply'}}</span>
      </div>
      <p class="mt-1 text-[11px] text-ink-faint">{{t 'world_controls.pvp_help'}}</p>
    </div>
    <div>
      <div class="mb-1 eyebrow">{{t 'world_controls.difficulty_and_saving'}}</div>
      <div class="flex flex-wrap gap-1.5">
        <button class="chip" data-wc="difficulty-peaceful">{{t 'world_controls.peaceful'}}</button>
        <button class="chip" data-wc="difficulty-easy">{{t 'world_controls.easy'}}</button>
        <button class="chip" data-wc="difficulty-normal">{{t 'world_controls.normal'}}</button>
        <button class="chip" data-wc="difficulty-hard">{{t 'world_controls.hard'}}</button>
        <button class="chip" data-wc="save-all">{{{icon 'save' 'size-3.5'}}} {{t 'world_controls.save_world'}}</button>
      </div>
    </div>

    {{! Everything else lives here so the common controls above stay uncluttered.
        The world state poll only reads the rules for chips that are visible, so
        these gamerules aren't queried until this section is opened. }}
    <details class="group rounded-md border border-line" data-wc-all>
      <summary class="flex cursor-pointer items-center gap-2 px-3 py-2 text-xs font-semibold text-ink-faint marker:content-none">
        {{{icon 'sliders-horizontal' 'size-3.5'}}} {{t 'world_controls.show_all_rules'}}
        <span class="ml-auto transition group-open:rotate-180">{{{icon 'chevron-down' 'size-4'}}}</span>
      </summary>
      <div class="space-y-3 border-t border-line p-3">
        <div>
          <div class="mb-1 eyebrow">{{t 'world_controls.world_rules'}}</div>
          <div class="flex flex-wrap gap-1.5">
            <button class="chip" data-wc-toggle="limitedcraft" data-rule="doLimitedCrafting">{{t 'world_controls.limited_crafting'}}</button>
            <button class="chip" data-wc-toggle="tiledrops" data-rule="doTileDrops">{{t 'world_controls.block_drops'}}</button>
            <button class="chip" data-wc-toggle="entitydrops" data-rule="doEntityDrops">{{t 'world_controls.entity_drops'}}</button>
            <button class="chip" data-wc-toggle="firetickaway" data-rule="allowFireTicksAwayFromPlayer">{{t 'world_controls.fire_ticks_away'}}</button>
            <button class="chip" data-wc-toggle="vinesspread" data-rule="doVinesSpread">{{t 'world_controls.vines_spread'}}</button>
            <button class="chip" data-wc-toggle="waterconv" data-rule="waterSourceConversion">{{t 'world_controls.water_conversion'}}</button>
            <button class="chip" data-wc-toggle="lavaconv" data-rule="lavaSourceConversion">{{t 'world_controls.lava_conversion'}}</button>
            <button class="chip" data-wc-toggle="projbreak" data-rule="projectilesCanBreakBlocks">{{t 'world_controls.projectiles_break_blocks'}}</button>
            <button class="chip" data-wc-toggle="blockdropdecay" data-rule="blockExplosionDropDecay">{{t 'world_controls.block_explosion_decay'}}</button>
            <button class="chip" data-wc-toggle="mobdropdecay" data-rule="mobExplosionDropDecay">{{t 'world_controls.mob_explosion_decay'}}</button>
            <button class="chip" data-wc-toggle="tntdropdecay" data-rule="tntExplosionDropDecay">{{t 'world_controls.tnt_explosion_decay'}}</button>
            <button class="chip" data-wc-toggle="pearlvanish" data-rule="enderPearlsVanishOnDeath">{{t 'world_controls.ender_pearls_vanish'}}</button>
            <button class="chip" data-wc-toggle="globalsound" data-rule="globalSoundEvents">{{t 'world_controls.global_sound_events'}}</button>
            <button class="chip" data-wc-toggle="specchunks" data-rule="spectatorsGenerateChunks">{{t 'world_controls.spectators_generate_chunks'}}</button>
            <button class="chip" data-wc-toggle="reduceddebug" data-rule="reducedDebugInfo">{{t 'world_controls.reduced_debug_info'}}</button>
            <button class="chip" data-wc-toggle="noelytracheck" data-rule="disableElytraMovementCheck">{{t 'world_controls.disable_elytra_check'}}</button>
          </div>
        </div>
        <div>
          <div class="mb-1 eyebrow">{{t 'world_controls.mobs_and_damage'}}</div>
          <div class="flex flex-wrap gap-1.5">
            <button class="chip" data-wc-toggle="mobloot" data-rule="doMobLoot">{{t 'world_controls.mob_loot'}}</button>
            <button class="chip" data-wc-toggle="patrols" data-rule="doPatrolSpawning">{{t 'world_controls.pillager_patrols'}}</button>
            <button class="chip" data-wc-toggle="traders" data-rule="doTraderSpawning">{{t 'world_controls.wandering_traders'}}</button>
            <button class="chip" data-wc-toggle="wardens" data-rule="doWardenSpawning">{{t 'world_controls.warden_spawning'}}</button>
            <button class="chip" data-wc-toggle="noraids" data-rule="disableRaids">{{t 'world_controls.disable_raids'}}</button>
            <button class="chip" data-wc-toggle="forgivedead" data-rule="forgiveDeadPlayers">{{t 'world_controls.forgive_dead_players'}}</button>
            <button class="chip" data-wc-toggle="universalanger" data-rule="universalAnger">{{t 'world_controls.universal_anger'}}</button>
            <button class="chip" data-wc-toggle="firedmg" data-rule="fireDamage">{{t 'world_controls.fire_damage'}}</button>
            <button class="chip" data-wc-toggle="drowndmg" data-rule="drowningDamage">{{t 'world_controls.drowning_damage'}}</button>
            <button class="chip" data-wc-toggle="freezedmg" data-rule="freezeDamage">{{t 'world_controls.freeze_damage'}}</button>
          </div>
        </div>
        <div>
          <div class="mb-1 eyebrow">{{t 'world_controls.chat_and_messages'}}</div>
          <div class="flex flex-wrap gap-1.5">
            <button class="chip" data-wc-toggle="cmdblockout" data-rule="commandBlockOutput">{{t 'world_controls.command_block_output'}}</button>
            <button class="chip" data-wc-toggle="logadmin" data-rule="logAdminCommands">{{t 'world_controls.admin_command_logging'}}</button>
          </div>
        </div>
      </div>
    </details>
  </fieldset>
</div>
<script type="module" src="/js/pages/world-controls.js"></script>
