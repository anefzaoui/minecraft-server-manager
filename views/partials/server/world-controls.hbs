        <div>
          <div class="mb-1 eyebrow">Mobs &amp; Damage</div>
          <div class="grid gap-x-6 sm:grid-cols-2">
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doMobLoot">
              <label class="cursor-pointer text-sm" for="wc-tg-mobloot">Mob Loot</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-mobloot" data-wc-toggle="mobloot" data-rule="doMobLoot" data-label="Mob Loot">
