<div class="card p-4" data-world-controls="{{server.id}}" data-running="{{#if (or (eq server.status 'running') (eq server.status 'unhealthy'))}}1{{/if}}">
  <h3 class="mb-1 font-semibold">World Controls</h3>
  <p class="mb-3 text-xs text-ink-faint" data-wc-state>{{#if (eq server.status 'running')}}Loading world state…{{else}}Available while the server runs.{{/if}}</p>
  <div class="mb-4 hidden max-w-xs items-center justify-between rounded-md border border-line bg-inset px-3 py-2" data-wc-clock-box>
    <div>
      <div class="text-lg font-bold tabular-nums leading-tight" data-wc-clock>--:--</div>
      <div class="text-[11px] text-ink-faint"><span data-wc-phase></span><span data-wc-day-wrap class="hidden"> · Day <span data-wc-day></span></span></div>
    </div>
    {{{icon 'clock' 'size-5 text-ink-faint'}}}
  </div>
  {{! Real fieldset-level disable - pointer-events-none left the buttons in the
      tab order, and Enter/Space fired commands at a stopped server. }}
  <fieldset class="min-w-0" {{#unless (or (eq server.status 'running') (eq server.status 'unhealthy'))}}disabled{{/unless}}>
    <div class="grid items-start gap-4 md:grid-cols-2">
      <div>
        <div class="mb-1 eyebrow">Time</div>
        <select class="input" data-wc-select="time" data-label="Time">
          <option value="">Set time…</option>
          <option value="time-day">Day</option>
          <option value="time-noon">Noon</option>
          <option value="time-night">Night</option>
          <option value="time-midnight">Midnight</option>
        </select>
        <div class="mt-2 flex flex-wrap items-end gap-2">
          <div>
            <label class="label" for="wc-ticks">Ticks (0–23999)</label>
            <input class="input w-28 font-mono" id="wc-ticks" data-wc-ticks inputmode="numeric" placeholder="6000" data-label="Time in ticks">
          </div>
          <button class="btn" data-wc-custom="time-set">Set Time</button>
        </div>
      </div>
      <div>
        <div class="mb-1 eyebrow">Weather</div>
        <select class="input" data-wc-select="weather" data-label="Weather">
          <option value="">Set weather…</option>
          <option value="weather-clear">Clear</option>
          <option value="weather-rain">Rain</option>
          <option value="weather-thunder">Thunder</option>
        </select>
      </div>
      <div>
        <div class="mb-1 eyebrow">Difficulty &amp; Saving</div>
        <select class="input" data-wc-select="difficulty" data-label="Difficulty">
          <option value="peaceful">Peaceful</option>
          <option value="easy">Easy</option>
          <option value="normal">Normal</option>
          <option value="hard">Hard</option>
        </select>
        <button class="btn mt-2" data-wc="save-all">{{{icon 'save' 'size-4'}}} Save World</button>
      </div>
      <div>
        <div class="mb-1 eyebrow">Combat</div>
        <div class="flex items-center justify-between gap-3 py-1" data-wc-row="pvp">
          <span class="text-sm" id="wc-label-pvp">PvP <span class="text-[11px] font-normal text-ink-faint">· on restart</span></span>
          <span class="msm-toggle shrink-0">
            <input type="checkbox" id="wc-tg-pvp" data-wc-toggle="pvp" data-rule="pvp" data-label="PvP" aria-labelledby="wc-label-pvp">
            <span></span>
          </span>
        </div>
        <div class="mt-1 flex flex-wrap items-center gap-1.5">
          <span class="badge badge-warn hidden" data-wc-pvp-pending>Restart to apply</span>
        </div>
        <p class="mt-1 text-[11px] text-ink-faint">Changes the PvP setting for the whole server. It takes effect on the next restart.</p>
      </div>
      <div>
        <div class="mb-1 eyebrow">World Border</div>
        <p class="mb-2 text-xs text-ink-faint">Now: <b class="font-mono" data-wc-border>unknown</b></p>
        <div class="space-y-3">
          <div class="flex flex-wrap items-end gap-2">
            <div>
              <label class="label" for="wc-border-diameter">Size (blocks)</label>
              <input class="input w-28 font-mono" id="wc-border-diameter" data-wc-border-diameter inputmode="numeric" placeholder="60000000" data-label="Border size in blocks">
            </div>
            <div>
              <label class="label" for="wc-border-seconds">Over (sec)</label>
              <input class="input w-20 font-mono" id="wc-border-seconds" data-wc-border-seconds inputmode="numeric" placeholder="0" data-label="Border resize time in seconds">
            </div>
            <button class="btn" data-wc-border-set>Set Size</button>
          </div>
          <div class="flex flex-wrap items-end gap-2">
            <div>
              <label class="label" for="wc-border-delta">Grow / shrink (blocks)</label>
              <input class="input w-28 font-mono" id="wc-border-delta" data-wc-border-delta inputmode="numeric" placeholder="+500" data-label="Blocks to grow or shrink">
            </div>
            <button class="btn" data-wc-border-add>Apply</button>
          </div>
          <div class="flex flex-wrap items-end gap-2">
            <div>
              <label class="label" for="wc-border-x">Center X</label>
              <input class="input w-24 font-mono" id="wc-border-x" data-wc-border-x inputmode="numeric" placeholder="0" data-label="Border center X">
            </div>
            <div>
              <label class="label" for="wc-border-z">Center Z</label>
              <input class="input w-24 font-mono" id="wc-border-z" data-wc-border-z inputmode="numeric" placeholder="0" data-label="Border center Z">
            </div>
            <button class="btn" data-wc-border-center>Set Center</button>
          </div>
        </div>
      </div>
      <div>
        <div class="mb-1 eyebrow">Numbers</div>
        <div class="space-y-3">
          <div class="flex flex-wrap items-end gap-2" data-wc-int-row="randomTickSpeed">
            <div>
              <label class="label" for="wc-int-randomTickSpeed">Random Tick Speed</label>
              <input class="input w-28 font-mono" id="wc-int-randomTickSpeed" data-wc-int="randomTickSpeed" inputmode="numeric" data-label="Random tick speed">
            </div>
            <button class="btn" data-wc-int-set="randomTickSpeed">Set</button>
          </div>
          <div class="flex flex-wrap items-end gap-2" data-wc-int-row="spawnRadius">
            <div>
              <label class="label" for="wc-int-spawnRadius">Spawn Radius</label>
              <input class="input w-28 font-mono" id="wc-int-spawnRadius" data-wc-int="spawnRadius" inputmode="numeric" data-label="Spawn radius">
            </div>
            <button class="btn" data-wc-int-set="spawnRadius">Set</button>
          </div>
          <div class="flex flex-wrap items-end gap-2" data-wc-int-row="playersSleepingPercentage">
            <div>
              <label class="label" for="wc-int-playersSleepingPercentage">Players Sleeping %</label>
              <input class="input w-28 font-mono" id="wc-int-playersSleepingPercentage" data-wc-int="playersSleepingPercentage" inputmode="numeric" data-label="Players sleeping percentage">
            </div>
            <button class="btn" data-wc-int-set="playersSleepingPercentage">Set</button>
          </div>
          <div class="flex flex-wrap items-end gap-2" data-wc-int-row="maxEntityCramming">
            <div>
              <label class="label" for="wc-int-maxEntityCramming">Max Entity Cramming</label>
              <input class="input w-28 font-mono" id="wc-int-maxEntityCramming" data-wc-int="maxEntityCramming" inputmode="numeric" data-label="Max entity cramming">
            </div>
            <button class="btn" data-wc-int-set="maxEntityCramming">Set</button>
          </div>
        </div>
      </div>
      <div class="md:col-span-2">
        <div class="mb-1 eyebrow">Common Rules</div>
        <div class="grid gap-x-6 sm:grid-cols-2">
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="keepInventory">
            <label class="cursor-pointer text-sm" for="wc-tg-keepinv">Keep Inventory</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-keepinv" data-wc-toggle="keepinv" data-rule="keepInventory" data-label="Keep Inventory">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doImmediateRespawn">
            <label class="cursor-pointer text-sm" for="wc-tg-instantrespawn">Instant Respawn</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-instantrespawn" data-wc-toggle="instantrespawn" data-rule="doImmediateRespawn" data-label="Instant Respawn">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doDaylightCycle">
            <label class="cursor-pointer text-sm" for="wc-tg-daycycle">Day/Night Cycle</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-daycycle" data-wc-toggle="daycycle" data-rule="doDaylightCycle" data-label="Day/Night Cycle">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doWeatherCycle">
            <label class="cursor-pointer text-sm" for="wc-tg-weathercycle">Weather Cycle</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-weathercycle" data-wc-toggle="weathercycle" data-rule="doWeatherCycle" data-label="Weather Cycle">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doMobSpawning">
            <label class="cursor-pointer text-sm" for="wc-tg-mobspawn">Mob Spawning</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-mobspawn" data-wc-toggle="mobspawn" data-rule="doMobSpawning" data-label="Mob Spawning">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="mobGriefing">
            <label class="cursor-pointer text-sm" for="wc-tg-mobgrief">Mob Griefing</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-mobgrief" data-wc-toggle="mobgrief" data-rule="mobGriefing" data-label="Mob Griefing">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doInsomnia">
            <label class="cursor-pointer text-sm" for="wc-tg-phantoms">Phantoms</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-phantoms" data-wc-toggle="phantoms" data-rule="doInsomnia" data-label="Phantoms">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="naturalRegeneration">
            <label class="cursor-pointer text-sm" for="wc-tg-naturalregen">Natural Regeneration</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-naturalregen" data-wc-toggle="naturalregen" data-rule="naturalRegeneration" data-label="Natural Regeneration">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="fallDamage">
            <label class="cursor-pointer text-sm" for="wc-tg-falldmg">Fall Damage</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-falldmg" data-wc-toggle="falldmg" data-rule="fallDamage" data-label="Fall Damage">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doFireTick">
            <label class="cursor-pointer text-sm" for="wc-tg-firetick">Fire Spread</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-firetick" data-wc-toggle="firetick" data-rule="doFireTick" data-label="Fire Spread">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="tntExplodes">
            <label class="cursor-pointer text-sm" for="wc-tg-tntexplodes">TNT Explosions</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-tntexplodes" data-wc-toggle="tntexplodes" data-rule="tntExplodes" data-label="TNT Explosions">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="showDeathMessages">
            <label class="cursor-pointer text-sm" for="wc-tg-deathmsg">Death Messages</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-deathmsg" data-wc-toggle="deathmsg" data-rule="showDeathMessages" data-label="Death Messages">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="announceAdvancements">
            <label class="cursor-pointer text-sm" for="wc-tg-advancements">Advancement Announcements</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-advancements" data-wc-toggle="advancements" data-rule="announceAdvancements" data-label="Advancement Announcements">
              <span></span>
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1" data-wc-row="sendCommandFeedback">
            <label class="cursor-pointer text-sm" for="wc-tg-cmdfeedback">Command Feedback</label>
            <span class="msm-toggle shrink-0">
              <input type="checkbox" id="wc-tg-cmdfeedback" data-wc-toggle="cmdfeedback" data-rule="sendCommandFeedback" data-label="Command Feedback">
              <span></span>
            </span>
          </div>
        </div>
      </div>
    </div>

    {{! Everything else lives here so the common controls above stay uncluttered.
        The world state poll only reads the rules for chips that are visible, so
        these gamerules aren't queried until this section is opened. }}
    <details class="group mt-4 rounded-md border border-line" data-wc-all>
      <summary class="flex cursor-pointer items-center gap-2 px-3 py-2 text-xs font-semibold text-ink-faint marker:content-none">
        {{{icon 'sliders-horizontal' 'size-3.5'}}} Show all world rules
        <span class="ml-auto transition group-open:rotate-180">{{{icon 'chevron-down' 'size-4'}}}</span>
      </summary>
      <div class="space-y-3 border-t border-line p-3">
        <div>
          <div class="mb-1 eyebrow">World Rules</div>
          <div class="grid gap-x-6 sm:grid-cols-2">
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doLimitedCrafting">
              <label class="cursor-pointer text-sm" for="wc-tg-limitedcraft">Limited Crafting</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-limitedcraft" data-wc-toggle="limitedcraft" data-rule="doLimitedCrafting" data-label="Limited Crafting">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doTileDrops">
              <label class="cursor-pointer text-sm" for="wc-tg-tiledrops">Block Drops</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-tiledrops" data-wc-toggle="tiledrops" data-rule="doTileDrops" data-label="Block Drops">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doEntityDrops">
              <label class="cursor-pointer text-sm" for="wc-tg-entitydrops">Entity Drops</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-entitydrops" data-wc-toggle="entitydrops" data-rule="doEntityDrops" data-label="Entity Drops">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="allowFireTicksAwayFromPlayer">
              <label class="cursor-pointer text-sm" for="wc-tg-firetickaway">Fire Ticks Away From Players</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-firetickaway" data-wc-toggle="firetickaway" data-rule="allowFireTicksAwayFromPlayer" data-label="Fire Ticks Away From Players">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="doVinesSpread">
              <label class="cursor-pointer text-sm" for="wc-tg-vinesspread">Vines Spread</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-vinesspread" data-wc-toggle="vinesspread" data-rule="doVinesSpread" data-label="Vines Spread">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="waterSourceConversion">
