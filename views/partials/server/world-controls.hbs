              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-waterconv" data-wc-toggle="waterconv" data-rule="waterSourceConversion" data-label="Water Source Conversion">
                <span></span>
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 py-1" data-wc-row="lavaSourceConversion">
              <label class="cursor-pointer text-sm" for="wc-tg-lavaconv">Lava Source Conversion</label>
              <span class="msm-toggle shrink-0">
                <input type="checkbox" id="wc-tg-lavaconv" data-wc-toggle="lavaconv" data-rule="lavaSourceConversion" data-label="Lava Source Conversion">
