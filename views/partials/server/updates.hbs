{{! Version compatibility (#52): what every installed mod supports, so a
    Minecraft version is only ever offered when the mods can follow. The
    per-version mod lists are deliberately NOT rendered here - a large pack
    across every future version is tens of thousands of rows - they are
    fetched one version at a time when a row is opened. }}
<div data-compat-server="{{server.id}}" data-compat-status="{{compat.status}}" data-compat-can-scan="{{#if perms.content}}true{{else}}false{{/if}}">

  <div class="card mb-4">
    <div class="flex flex-wrap items-start gap-4">
      <div class="min-w-0 grow">
        <h2 class="mb-1 text-base font-semibold">Minecraft Version Compatibility</h2>
        <p class="max-w-prose text-xs text-ink-soft">
          A version check asks Modrinth and CurseForge which Minecraft versions every mod on this server
          has a build for. Until it has run, no Minecraft version update is offered for this server.
        </p>
        <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <div>
            <dt class="text-xs text-ink-faint">Running now</dt>
            <dd class="font-mono">{{compat.mcVersion}}{{#if compat.loader}} · {{capitalize compat.loader}}{{/if}}</dd>
          </div>
          <div>
            <dt class="text-xs text-ink-faint">Mods enabled</dt>
            <dd class="font-mono">{{modCount}}</dd>
          </div>
          <div>
            <dt class="text-xs text-ink-faint">Highest version all mods support</dt>
            <dd class="font-mono" id="compat-ceiling">
              {{#if compat.report}}
                {{#if compat.report.highestCompatible}}<span class="text-ok">{{compat.report.highestCompatible}}</span>{{else}}<span class="text-ink-faint">none yet</span>{{/if}}
              {{else}}<span class="text-ink-faint">not checked</span>{{/if}}
            </dd>
          </div>
          <div>
            <dt class="text-xs text-ink-faint">Last checked</dt>
            <dd>{{#if compat.completedAt}}<span data-ts="{{compat.completedAt}}">{{compat.completedAt}}</span>{{else}}<span class="text-ink-faint">never</span>{{/if}}</dd>
          </div>
        </dl>
      </div>
      <div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto{{#unless perms.content}} hidden{{/unless}}">
        <button class="btn btn-primary" id="compat-scan" data-tip="Ask Modrinth and CurseForge about every installed mod.">
          {{{icon 'scan-search' 'size-4'}}} <span data-scan-label>{{#if (eq compat.status 'interrupted')}}Resume Version Check{{else}}Check Future Versions{{/if}}</span>
        </button>
      </div>
    </div>

    {{! Progress survives a refresh and a panel restart: it is read from the
        database, not from an open connection. }}
    <div id="compat-progress" class="mt-4 {{#unless (eq compat.status 'running')}}hidden{{/unless}}">
      <div class="mb-1 flex items-center justify-between text-xs">
        <span id="compat-phase">{{default compat.phaseLabel "Starting…"}}</span>
        <span id="compat-count" class="font-mono text-ink-faint">{{compat.done}}/{{compat.total}}</span>
      </div>
      <div class="h-2 overflow-hidden rounded-sm bg-inset">
        <div id="compat-bar" class="h-full bg-ok transition-[width]" style="width:0%"></div>
      </div>
    </div>
  </div>

  {{#if (eq compat.status 'interrupted')}}
    <div class="notice notice-warn mb-4 text-xs">
      {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0'}}}
      <div>The last version check stopped before it finished, most likely because the panel restarted. Everything it had already worked out was kept, so running it again does not redo that work.</div>
    </div>
  {{/if}}

  {{#if (eq compat.status 'failed')}}
    <div class="notice notice-danger mb-4 text-xs">
      {{{icon 'circle-alert' 'size-4 mt-0.5 shrink-0'}}}
      <div>The last version check could not finish. Run it again, and check that the panel can reach Modrinth and CurseForge.{{#if compat.error}}<pre class="mt-1 max-w-prose overflow-x-auto whitespace-pre-wrap rounded-sm bg-inset px-2 py-1.5 font-mono text-danger">{{compat.error}}</pre>{{/if}}</div>
    </div>
  {{/if}}

  {{#if compat.stale}}
    <div class="notice notice-warn mb-4 text-xs">
      {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0'}}}
      <div>The mods, the Minecraft version or the mod loader have changed since this report was made, so it no longer describes this server. Run the check again.</div>
    </div>
  {{/if}}

  {{#if compatUnknown.length}}
    <details class="card group mb-4">
      <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        <span class="shrink-0 text-ink-faint transition group-open:rotate-90">{{{icon 'chevron-right' 'size-4'}}}</span>
        <span class="badge badge-warn">{{compatUnknownTotal}}</span>
        Mods That Could Not Be Identified
      </summary>
      <p class="mt-2 max-w-prose text-xs text-ink-soft">
        Neither Modrinth nor CurseForge recognises these files, so there is no way to tell which Minecraft
        versions they support. While any of them are installed, this server is never offered a one-click
        Minecraft version update.
      </p>
      <ul class="mt-3 grid gap-1 text-xs sm:grid-cols-2">
        {{#each compatUnknown}}
          <li class="truncate font-mono text-ink-faint" title="{{file}}">{{file}}</li>
        {{/each}}
      </ul>
      {{#if compatUnknownMore}}<p class="mt-2 text-xs text-ink-faint">and {{compatUnknownMore}} more.</p>{{/if}}
    </details>
  {{/if}}

  {{#if compatUnchecked.length}}
    <details class="card group mb-4">
      <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        <span class="shrink-0 text-ink-faint transition group-open:rotate-90">{{{icon 'chevron-right' 'size-4'}}}</span>
        <span class="badge badge-warn">{{compatUncheckedTotal}}</span>
        Mods That Could Not Be Checked
      </summary>
      <p class="mt-2 max-w-prose text-xs text-ink-soft">
        These are recognised, but they come from a place that publishes no list of which Minecraft
        versions each build is for: GitHub Releases, Hangar, SpigotMC, or a project that has since been
        taken down. The panel will not guess on their behalf, so this server is not offered a one-click
        Minecraft version update while they are installed.
      </p>
      <ul class="mt-3 grid gap-1 text-xs sm:grid-cols-2">
        {{#each compatUnchecked}}
          <li class="truncate text-ink-faint" title="{{file}}">{{name}}</li>
        {{/each}}
      </ul>
      {{#if compatUncheckedMore}}<p class="mt-2 text-xs text-ink-faint">and {{compatUncheckedMore}} more.</p>{{/if}}
    </details>
  {{/if}}

  {{#if compatVersions.length}}
    <div class="mb-2 flex flex-wrap items-center gap-2">
      <h3 class="text-sm font-semibold">Future Versions</h3>
      {{#if compat.report.partial}}<span class="badge badge-warn">still checking</span>{{/if}}
      <span class="ml-auto text-xs text-ink-faint">Nearest first. Open one to see which mods are ready.</span>
    </div>
    <div class="grid gap-2" id="compat-versions">
      {{#each compatVersions}}
        <details class="card group" data-compat-version="{{version}}">
          <summary class="flex cursor-pointer list-none flex-wrap items-center gap-2 [&::-webkit-details-marker]:hidden">
            <span class="shrink-0 text-ink-faint transition group-open:rotate-90">{{{icon 'chevron-right' 'size-4'}}}</span>
            <span class="font-mono text-sm font-semibold">{{version}}</span>
            {{#if (eq status 'ready')}}
              <span class="badge badge-ok">All mods ready</span>
            {{else if (eq status 'unknown')}}
              <span class="badge badge-warn">Unknown</span>
            {{else}}
              <span class="badge badge-danger">{{missingCount}} without a build</span>
            {{/if}}
            <span class="ml-auto font-mono text-xs text-ink-faint">{{readyCount}}/{{../compat.report.knownCount}} ready</span>
          </summary>
          <div class="mt-3" data-compat-body>
            <p class="text-xs text-ink-faint">Loading…</p>
          </div>
        </details>
      {{/each}}
    </div>
  {{else if (eq compat.status 'running')}}
    {{> empty-state iconName='scan-search' title='Checking Versions' message='Results appear here as each mod is checked. You can leave this page, it keeps running.'}}
  {{else if compat.report}}
    {{> empty-state iconName='circle-check' title='Already On the Newest Version' message='There is no Minecraft version newer than the one this server runs, so there is nothing ahead to check.'}}
  {{else}}
    {{> empty-state iconName='scan-search' title='No Version Check Yet' message='Run a version check to find out which future Minecraft versions your mods have builds for. It reads every mod on this server, so it only ever runs when you ask it to.'}}
  {{/if}}
</div>
<script type="module" src="/js/pages/server-updates.js"></script>
