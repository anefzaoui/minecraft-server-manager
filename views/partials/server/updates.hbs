{{! Version compatibility (#52): what every installed mod supports, so a
    Minecraft version is only ever offered when the mods can follow. The
    per-version mod lists are deliberately NOT rendered here - a large pack
    across every future version is tens of thousands of rows - they are
    fetched one version at a time when a row is opened. }}
<div data-compat-server="{{server.id}}" data-compat-status="{{compat.status}}" data-compat-can-scan="{{#if perms.content}}true{{else}}false{{/if}}">

  <div class="card mb-4">
    <div class="flex flex-wrap items-start gap-4">
      <div class="min-w-0 grow">
        <h2 class="mb-1 text-base font-semibold">{{t 'updates_tab.title'}}</h2>
        <p class="max-w-prose text-xs text-ink-soft">
          {{t 'updates_tab.description'}}
        </p>
        <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <div>
            <dt class="text-xs text-ink-faint">{{t 'updates_tab.running_now'}}</dt>
            <dd class="font-mono">{{compat.mcVersion}}{{#if compat.loader}} · {{capitalize compat.loader}}{{/if}}</dd>
          </div>
          <div>
            <dt class="text-xs text-ink-faint">{{t 'updates_tab.mods_enabled'}}</dt>
            <dd class="font-mono">{{modCount}}</dd>
          </div>
          <div>
            <dt class="text-xs text-ink-faint">{{t 'updates_tab.highest_supported'}}</dt>
            <dd class="font-mono" id="compat-ceiling">
              {{#if compat.report}}
                {{#if compat.report.highestCompatible}}<span class="text-ok">{{compat.report.highestCompatible}}</span>{{else}}<span class="text-ink-faint">{{t 'updates_tab.none_yet'}}</span>{{/if}}
              {{else}}<span class="text-ink-faint">{{t 'updates_tab.not_checked'}}</span>{{/if}}
            </dd>
          </div>
          <div>
            <dt class="text-xs text-ink-faint">{{t 'updates_tab.last_checked'}}</dt>
            <dd>{{#if compat.completedAt}}<span data-ts="{{compat.completedAt}}">{{compat.completedAt}}</span>{{else}}<span class="text-ink-faint">{{t 'updates_tab.never'}}</span>{{/if}}</dd>
          </div>
        </dl>
      </div>
      <div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto{{#unless perms.content}} hidden{{/unless}}">
        <button class="btn btn-primary" id="compat-scan" data-tip="{{t 'updates_tab.scan_tooltip'}}">
          {{{icon 'scan-search' 'size-4'}}} <span data-scan-label>{{#if (eq compat.status 'interrupted')}}{{t 'updates_tab.resume_check'}}{{else}}{{t 'updates_tab.check_versions'}}{{/if}}</span>
        </button>
      </div>
    </div>

    {{! Progress survives a refresh and a panel restart: it is read from the
        database, not from an open connection. }}
    <div id="compat-progress" class="mt-4 {{#unless (eq compat.status 'running')}}hidden{{/unless}}">
      <div class="mb-1 flex items-center justify-between text-xs">
        <span id="compat-phase">{{default compat.phaseLabel (t 'updates_tab.starting')}}</span>
        <span id="compat-count" class="font-mono text-ink-faint">{{compat.done}}/{{compat.total}}</span>
      </div>
      <div class="h-2 overflow-hidden rounded-sm bg-inset">
        <div id="compat-bar" class="h-full bg-ok transition-[width]" style="width:0%"></div>
      </div>
    </div>
  </div>

  {{#if (eq compat.status 'interrupted')}}
    <div class="notice notice-warn mb-4 text-xs">
      {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0'}}}
      <div>{{t 'updates_tab.interrupted_notice'}}</div>
    </div>
  {{/if}}

  {{#if (eq compat.status 'failed')}}
    <div class="notice notice-danger mb-4 text-xs">
      {{{icon 'circle-alert' 'size-4 mt-0.5 shrink-0'}}}
      <div>{{t 'updates_tab.failed_notice'}}</div>
    </div>
  {{/if}}

  {{#if compat.stale}}
    <div class="notice notice-warn mb-4 text-xs">
      {{{icon 'triangle-alert' 'size-4 mt-0.5 shrink-0'}}}
      <div>{{t 'updates_tab.stale_notice'}}</div>
    </div>
  {{/if}}

  {{#if compatUnknown.length}}
    <details class="card group mb-4">
      <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        <span class="shrink-0 text-ink-faint transition group-open:rotate-90">{{{icon 'chevron-right' 'size-4'}}}</span>
        <span class="badge badge-warn">{{compatUnknownTotal}}</span>
        {{t 'updates_tab.unidentified_title'}}
      </summary>
      <p class="mt-2 max-w-prose text-xs text-ink-soft">
        {{t 'updates_tab.unidentified_desc'}}
      </p>
      <ul class="mt-3 grid gap-1 text-xs sm:grid-cols-2">
        {{#each compatUnknown}}
          <li class="truncate font-mono text-ink-faint" title="{{file}}">{{file}}</li>
        {{/each}}
      </ul>
      {{#if compatUnknownMore}}<p class="mt-2 text-xs text-ink-faint">{{t 'updates_tab.and_more' count=compatUnknownMore}}</p>{{/if}}
    </details>
  {{/if}}

  {{#if compatUnchecked.length}}
    <details class="card group mb-4">
      <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        <span class="shrink-0 text-ink-faint transition group-open:rotate-90">{{{icon 'chevron-right' 'size-4'}}}</span>
        <span class="badge badge-warn">{{compatUncheckedTotal}}</span>
        {{t 'updates_tab.unchecked_title'}}
      </summary>
      <p class="mt-2 max-w-prose text-xs text-ink-soft">
        {{t 'updates_tab.unchecked_desc'}}
      </p>
      <ul class="mt-3 grid gap-1 text-xs sm:grid-cols-2">
        {{#each compatUnchecked}}
          <li class="truncate text-ink-faint" title="{{file}}">{{name}}</li>
        {{/each}}
      </ul>
      {{#if compatUncheckedMore}}<p class="mt-2 text-xs text-ink-faint">{{t 'updates_tab.and_more' count=compatUncheckedMore}}</p>{{/if}}
    </details>
  {{/if}}

  {{#if compatVersions.length}}
    <div class="mb-2 flex flex-wrap items-center gap-2">
      <h3 class="text-sm font-semibold">{{t 'updates_tab.future_versions'}}</h3>
      {{#if compat.report.partial}}<span class="badge badge-warn">{{t 'updates_tab.still_checking'}}</span>{{/if}}
      <span class="ml-auto text-xs text-ink-faint">{{t 'updates_tab.nearest_first'}}</span>
    </div>
    <div class="grid gap-2" id="compat-versions">
      {{#each compatVersions}}
        <details class="card group" data-compat-version="{{version}}">
          <summary class="flex cursor-pointer list-none flex-wrap items-center gap-2 [&::-webkit-details-marker]:hidden">
            <span class="shrink-0 text-ink-faint transition group-open:rotate-90">{{{icon 'chevron-right' 'size-4'}}}</span>
            <span class="font-mono text-sm font-semibold">{{version}}</span>
            {{#if (eq status 'ready')}}
              <span class="badge badge-ok">{{../t 'updates_tab.all_mods_ready'}}</span>
            {{else if (eq status 'unknown')}}
              <span class="badge badge-warn">{{../t 'updates_tab.unknown'}}</span>
            {{else}}
              <span class="badge badge-danger">{{../t 'updates_tab.without_build' count=missingCount}}</span>
            {{/if}}
            <span class="ml-auto font-mono text-xs text-ink-faint">{{../t 'updates_tab.ready' ready=readyCount total=../compat.report.knownCount}}</span>
          </summary>
          <div class="mt-3" data-compat-body>
            <p class="text-xs text-ink-faint">{{../t 'updates_tab.loading'}}</p>
          </div>
        </details>
      {{/each}}
    </div>
  {{else if (eq compat.status 'running')}}
    {{> empty-state iconName='scan-search' title=(t 'updates_tab.empty_running_title') message=(t 'updates_tab.empty_running_message')}}
  {{else if compat.report}}
    {{> empty-state iconName='circle-check' title=(t 'updates_tab.empty_newest_title') message=(t 'updates_tab.empty_newest_message')}}
  {{else}}
    {{> empty-state iconName='scan-search' title=(t 'updates_tab.empty_none_title') message=(t 'updates_tab.empty_none_message')}}
  {{/if}}
</div>
<script type="module" src="/js/pages/server-updates.js"></script>
