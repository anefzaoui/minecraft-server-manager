<div class="grid gap-4 lg:grid-cols-2" data-settings-server="{{server.id}}" data-settings-icon="{{server.icon}}" data-settings-accent="{{server.accent}}" data-settings-tags="{{jsonAttr server.tags}}" data-settings-env="{{settingsEnv}}" data-settings-docker-name="{{server.containerName}}" data-settings-docker-network="{{server.networkName}}" data-settings-docker-ports="{{jsonAttr server.extraPorts}}" data-settings-docker-binds="{{jsonAttr server.extraBinds}}">
  <div class="card p-4">
    <h3 class="mb-4 font-semibold">{{t 'server_settings.identity'}}</h3>
    <div class="space-y-4">
      <div>
        <label class="label" for="st-name">{{t 'server_settings.display_name'}}</label>
        <input class="input" id="st-name" value="{{server.name}}">
        <p class="help">{{t 'server_settings.name_help'}}</p>
      </div>
      <div>
        <label class="label" for="st-desc">{{t 'server_settings.description'}}</label>
        <textarea class="input" id="st-desc" rows="3">{{server.description}}</textarea>
        <p class="help">{{t 'server_settings.desc_help'}}</p>
      </div>
      <div>
        <label class="label" for="st-motd">{{t 'server_settings.motd'}} <span class="text-xs font-normal text-ink-faint">{{t 'server_settings.motd_sub'}}</span></label>
        <input class="input font-mono" id="st-motd" value="{{motd}}" autocomplete="off">
        <div class="console mt-2 py-2 text-sm" id="st-motd-preview"></div>
        <p class="help">{{t 'server_settings.motd_help'}}</p>
      </div>
      {{! Both pickers use ONE selection language: aria-pressed + the theme-aware
          .swatch ring (the old white ring was invisible on the light theme, and
          the icon picker used a different green-border treatment one row over).
          The current stock icon is marked in place - no duplicate "current" tile. }}
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
          <span class="label">{{t 'server_settings.icon'}}</span>
          <div class="flex flex-wrap gap-1.5" id="st-icon-picker">
            {{#if (startsWith server.icon 'custom:')}}
              <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="{{server.icon}}" data-tip="{{t 'server_settings.custom_icon_tip'}}" aria-pressed="true"><img src="{{iconSrc server.icon}}" alt="" class="size-full rounded-sm" data-fallback-icon="/icons/servers/grass.svg"></button>
            {{/if}}
            <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="grass" aria-pressed="{{eq server.icon 'grass'}}"><img src="/icons/servers/grass.svg" alt="Grass block" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="creeper" aria-pressed="{{eq server.icon 'creeper'}}"><img src="/icons/servers/creeper.svg" alt="Creeper" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="diamond" aria-pressed="{{eq server.icon 'diamond'}}"><img src="/icons/servers/diamond.svg" alt="Diamond" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="portal" aria-pressed="{{eq server.icon 'portal'}}"><img src="/icons/servers/portal.svg" alt="Nether portal" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="chest" aria-pressed="{{eq server.icon 'chest'}}"><img src="/icons/servers/chest.svg" alt="Chest" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="sword" aria-pressed="{{eq server.icon 'sword'}}"><img src="/icons/servers/sword.svg" alt="Sword" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="potion" aria-pressed="{{eq server.icon 'potion'}}"><img src="/icons/servers/potion.svg" alt="Potion" class="size-full rounded-sm"></button>
            <button class="swatch grid size-9 place-items-center p-1" style="background: {{server.accent}}" data-pick-icon="tnt" aria-pressed="{{eq server.icon 'tnt'}}"><img src="/icons/servers/tnt.svg" alt="TNT" class="size-full rounded-sm"></button>
            <button class="grid size-9 place-items-center rounded-sm border border-dashed border-line-strong text-ink-faint transition hover:border-stone-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-diamond-400" id="st-icon-upload" data-tip="{{t 'server_settings.upload_icon_tip'}}">{{{icon 'upload' 'size-4'}}}</button>
          </div>
        </div>
        <div>
          <span class="label">{{t 'server_settings.accent_color'}}</span>
          {{! Amethyst is a deliberate off-ramp from the four semantic ramps -
              it's identity decoration from Minecraft source material, not meaning. }}
          <div class="flex flex-wrap items-center gap-1.5" id="st-accent-picker">
            <button class="swatch size-9" style="background: #3fa62b" data-pick-accent="#3fa62b" data-tip="{{t 'colors.grass'}}" aria-pressed="false"></button>
            <button class="swatch size-9" style="background: #21a7ab" data-pick-accent="#21a7ab" data-tip="{{t 'colors.diamond'}}" aria-pressed="false"></button>
            <button class="swatch size-9" style="background: #e5484d" data-pick-accent="#e5484d" data-tip="{{t 'colors.redstone'}}" aria-pressed="false"></button>
            <button class="swatch size-9" style="background: #e99417" data-pick-accent="#e99417" data-tip="{{t 'colors.gold'}}" aria-pressed="false"></button>
            <button class="swatch size-9" style="background: #9a5cc6" data-pick-accent="#9a5cc6" data-tip="{{t 'colors.amethyst'}}" aria-pressed="false"></button>
          </div>
        </div>
      </div>
      <div>
        <label class="label" for="st-tag-input">{{t 'server_settings.tags'}}</label>
        {{! Chips are rendered by server-settings.js from data-settings-tags - no server copy, or they double up. }}
        <div class="flex flex-wrap items-center gap-1.5" id="st-tags">
          <input class="input w-28" id="st-tag-input" placeholder="{{t 'server_settings.add_tag'}}">
        </div>
      </div>
      <div>
        <label class="label" for="st-notes">{{t 'server_settings.private_notes'}} <span class="badge ml-1">{{t 'server_settings.admin_only'}}</span></label>
        <textarea class="input font-mono text-xs" id="st-notes" rows="2" placeholder="{{t 'server_settings.notes_placeholder'}}">{{server.notes}}</textarea>
      </div>
      <div class="space-y-2.5 border-t border-line pt-3">
        <label class="flex items-center justify-between gap-3 text-sm">
          <span>{{t 'server_settings.autostart'}}</span>
          <span class="msm-toggle"><input type="checkbox" id="st-autostart" {{#if server.autoStart}}checked{{/if}}><span></span></span>
        </label>
        <label class="flex items-center justify-between gap-3 text-sm">
          <span>{{t 'server_settings.autorestart'}} <span class="block text-xs text-ink-faint">{{t 'server_settings.autorestart_help'}}</span></span>
          <span class="msm-toggle"><input type="checkbox" id="st-autorestart" {{#if server.autoRestart}}checked{{/if}}><span></span></span>
        </label>
      </div>
    </div>
  </div>

  <div class="space-y-4">
    <div class="card p-4">
      <h3 class="mb-4 font-semibold">{{t 'server_settings.resources'}}</h3>
      <div class="space-y-4">
        {{#unless (eq server.runtime 'bedrock')}}
        <div>
          <label class="label" for="st-heap">{{t 'server_settings.java_heap'}}</label>
          <div class="flex items-center gap-3">
            <input type="range" min="1024" max="16384" step="512" value="{{server.resources.heapMb}}" id="st-heap" class="msm-range flex-1" data-out="out-heap" data-unit=" MB">
            <span class="w-20 text-right font-mono text-sm" id="out-heap">{{server.resources.heapMb}} MB</span>
          </div>
          <p class="help">{{t 'server_settings.java_heap_help'}}</p>
        </div>
        {{/unless}}
        <div>
          <label class="label" for="st-cmem">{{t 'server_settings.container_memory'}}</label>
          <div class="flex items-center gap-3">
            <input type="range" min="1024" max="20480" step="512" value="{{server.resources.containerMemoryMb}}" id="st-cmem" class="msm-range msm-range-alt flex-1" data-out="out-cmem" data-unit=" MB">
            <span class="w-20 text-right font-mono text-sm" id="out-cmem">{{server.resources.containerMemoryMb}} MB</span>
          </div>
          <p class="help">{{t 'server_settings.container_memory_help'}}</p>
        </div>
        {{#unless (eq server.runtime 'bedrock')}}
        <div class="rounded-md border border-line p-2.5 text-xs" id="st-headroom" aria-live="polite"></div>
        {{/unless}}
        <div>
          <label class="label" for="st-cpu">{{t 'server_settings.cpu_limit'}}</label>
          <div class="flex items-center gap-3">
            <input type="range" min="0" max="16" step="0.5" value="{{server.resources.cpus}}" id="st-cpu" class="msm-range msm-range-alt flex-1" data-out="out-cpu" data-unit=" cores" data-zero="∞">
            <span class="w-20 text-right font-mono text-sm" id="out-cpu">{{#if server.resources.cpus}}{{server.resources.cpus}} {{t 'servers.of_cores' count=server.resources.cpus}}{{else}}∞{{/if}}</span>
          </div>
          <p class="help">{{t 'server_settings.cpu_limit_help'}}</p>
        </div>
        <div>
          <label class="label" for="st-quota">{{t 'server_settings.disk_quota'}} <span class="badge ml-1">{{t 'server_settings.panel_enforced'}}</span></label>
          <div class="flex items-center gap-3">
            <input type="range" min="0" max="200" step="5" value="{{quotaGb}}" id="st-quota" class="msm-range flex-1" data-out="out-quota" data-unit=" GB" data-zero="off">
            <span class="w-20 text-right font-mono text-sm" id="out-quota">{{quotaGb}} GB</span>
          </div>
          <p class="help">{{t 'server_settings.disk_quota_help'}}</p>
        </div>
      </div>
    </div>

    {{#if server.packUnpinned}}
    <div class="notice notice-warn max-w-prose text-sm">
      <b>{{t 'server_settings.unpinned_pack_title'}}</b> {{t 'server_settings.unpinned_pack_desc'}}
    </div>
    {{/if}}

    <div class="card p-4">
      <h3 class="mb-3 font-semibold">{{t 'server_settings.update_policy'}}</h3>
      <div class="space-y-2 text-sm">
        <label class="flex items-center gap-2.5"><input type="radio" name="up" value="manual" class="msm-radio" {{#if (eq server.updatePolicy 'manual')}}checked{{/if}}> {{t 'server_settings.update_policy_manual'}} <span class="text-xs text-ink-faint">{{t 'server_settings.update_policy_manual_desc'}}</span></label>
        <label class="flex items-center gap-2.5"><input type="radio" name="up" value="notify" class="msm-radio" {{#if (eq server.updatePolicy 'notify')}}checked{{/if}}> {{t 'server_settings.update_policy_notify'}} <span class="text-xs text-ink-faint">{{t 'server_settings.update_policy_notify_desc'}}</span></label>
        <label class="flex items-center gap-2.5"><input type="radio" name="up" value="auto" class="msm-radio" {{#if (eq server.updatePolicy 'auto')}}checked{{/if}}> {{t 'server_settings.update_policy_auto'}} <span class="text-xs text-ink-faint">{{t 'server_settings.update_policy_auto_desc'}}</span></label>
      </div>
    </div>

    {{! Admin-only: same gate as the wizard's Advanced Docker settings - the
        API 403s these fields for other roles. }}
    {{#if (eq user.role 'admin')}}
    <div class="card p-4">
      <h3 class="mb-4 font-semibold">{{t 'server_settings.advanced_docker'}}</h3>
      <div class="space-y-4">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="st-docker-name">{{t 'server_settings.container_name'}}</label>
            <input class="input font-mono" id="st-docker-name" value="{{server.containerName}}" placeholder="msm-{{server.id}}" autocomplete="off">
          </div>
          <div>
            <label class="label" for="st-docker-network">{{t 'server_settings.docker_network'}}</label>
            <select class="input" id="st-docker-network" data-label="{{t 'server_settings.docker_network'}}">
              <option value="">{{t 'server_settings.docker_network_default'}}</option>
            </select>
          </div>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-sm font-semibold">{{t 'server_settings.extra_port_mappings'}}</span>
            <button type="button" class="btn btn-sm" id="st-docker-port-add">{{{icon 'plus' 'size-3.5'}}} {{t 'server_settings.add_port'}}</button>
          </div>
          <div class="space-y-2" id="st-docker-ports"></div>
          <p class="help">{{t 'server_settings.port_mapping_help'}}</p>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-sm font-semibold">{{t 'server_settings.extra_volume_binds'}}</span>
            <button type="button" class="btn btn-sm" id="st-docker-bind-add">{{{icon 'plus' 'size-3.5'}}} {{t 'server_settings.add_bind'}}</button>
          </div>
          <div class="space-y-2" id="st-docker-binds"></div>
          <p class="help">{{t 'server_settings.volume_bind_help'}}</p>
        </div>

        <div class="flex items-center justify-between gap-3">
          <p class="help mt-0">{{t 'server_settings.rebuild_notice'}}</p>
          <button type="button" class="btn shrink-0" id="st-docker-preview">{{{icon 'file-code' 'size-4'}}} {{t 'server_settings.preview_yaml'}}</button>
        </div>
      </div>
    </div>
    {{/if}}

    <div class="card p-4">
      <h3 class="mb-3 font-semibold">{{t 'server_settings.blueprint_maintenance'}}</h3>
      <div class="flex flex-wrap gap-2">
        <button class="btn" id="st-export-bp">{{{icon 'drafting-compass' 'size-4'}}} {{t 'server_settings.export_blueprint'}}</button>
        <button class="btn" id="st-clone">{{{icon 'copy' 'size-4'}}} {{t 'server_settings.clone_server'}}</button>
        <button class="btn{{#unless perms.power}} hidden{{/unless}}" data-server-action="recreate" data-server-id="{{server.id}}" data-server-name="{{server.name}}" data-tip="{{t 'server_settings.rebuild_tip'}}">{{{icon 'wrench' 'size-4'}}} {{t 'server_settings.rebuild_container'}}</button>
      </div>
      {{! Destruction lives behind its own divider, never one accidental click
          from the safe maintenance actions above. }}
      <div class="mt-3 flex items-center justify-between gap-3 border-t border-line pt-3{{#unless perms.delete}} hidden{{/unless}}">
        <p class="text-xs text-ink-faint">{{t 'server_settings.delete_server_help'}}</p>
        <button class="btn btn-danger shrink-0" data-server-action="delete" data-server-id="{{server.id}}" data-server-name="{{server.name}}">{{{icon 'trash-2' 'size-4'}}} {{t 'server_settings.delete_server'}}</button>
      </div>
    </div>
  </div>

  {{#if advancedSections.length}}
  <div class="space-y-3 lg:col-span-2" id="st-advanced">
    <div class="notice notice-info text-xs">
      {{{icon 'info' 'size-3.5 mt-0.5 shrink-0'}}}
      <div>{{t 'server_settings.advanced_env_help'}}</div>
    </div>
    {{#each advancedSections}}
      <details class="card group">
        <summary class="flex cursor-pointer items-center gap-2.5 p-4 font-semibold marker:content-none">
          {{{icon icon 'size-4 text-ink-faint'}}} {{label}}
          <span class="badge ml-1">{{fields.length}}</span>
          <span class="ml-auto text-ink-faint transition group-open:rotate-180">{{{icon 'chevron-down' 'size-4'}}}</span>
        </summary>
        <div class="divide-y divide-line/60 border-t border-line px-4 pb-4">
          {{#each fields}}
            {{> catalog-field}}
          {{/each}}
        </div>
      </details>
    {{/each}}
  </div>
  {{/if}}
</div>

<div class="mt-4 flex justify-end gap-2">
  <button class="btn" id="st-discard">{{t 'common.cancel'}}</button>
  <button class="btn btn-primary" id="st-save">{{t 'common.save'}}</button>
</div>

<script type="module" src="/js/pages/server-settings.js"></script>
