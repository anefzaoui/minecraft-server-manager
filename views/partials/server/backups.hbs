<div data-backups-server="{{server.id}}" class="contents">
<div class="mb-4 flex flex-wrap items-center gap-2">
  <p class="text-sm text-ink-faint">
    Keeps the newest {{retention.keepScheduled}} scheduled, {{retention.keepManual}} manual, {{retention.keepPreUpdate}} pre-update
    and {{retention.keepPreRestore}} safety backups, and trims older ones after each new backup.{{#if retention.maxAgeDays}} Backups older than {{retention.maxAgeDays}} days are removed too.{{/if}}{{#if retention.maxTotalGb}} The total is capped at {{retention.maxTotalGb}} GB, oldest first.{{/if}}
    {{#if retentionOwnAll}}All of these limits are set for this server.{{else if retentionOverride}}Some of these limits are set for this server; the rest are panel-wide.{{else}}This server uses the panel-wide limits.{{/if}}
  </p>
  <div class="ml-auto flex flex-wrap items-center gap-3">
    <label class="flex items-center gap-2 text-xs text-ink-faint" data-tip="After the backup is saved, remove chunks no player has spent 30+ seconds in to shrink the world. Only runs while the server is stopped.">
      <input type="checkbox" class="msm-check" id="bk-shrink"> Also shrink the world afterwards.
    </label>
    <button class="btn btn-primary btn-sm{{#unless perms.backups}} hidden{{/unless}}" id="bk-now">{{{icon 'save' 'size-3.5'}}} Back Up Now</button>
  </div>
</div>
{{! Admin-only, like the API behind it. Per field: a blank one follows the
    panel-wide Backup Retention (its value is the placeholder). }}
{{#if (eq user.role 'admin')}}
<details class="card mb-4 p-4" id="bk-retention"{{#if retentionOverride}} open{{/if}}>
  <summary class="cursor-pointer text-sm font-semibold">Retention for This Server</summary>
  <div class="mt-3 space-y-3" data-retention-form>
    <p class="help mt-0">Set only what should differ for this server. Everything else follows the <a class="text-link hover:underline" href="/settings#retention-card">panel-wide policy</a>.</p>
    <div data-retention-fields>
      {{> backups/retention-fields prefix="bk-ret" values=retentionOwn placeholders=retentionGlobal inherit=true}}
    </div>
    <div class="flex justify-end">
      <button class="btn" data-retention-save>Save Retention</button>
    </div>
  </div>
</details>
{{/if}}
{{#if backups.length}}
<div class="card overflow-x-auto">
  <table class="table-base table-stack" id="bk-table">
    <thead><tr><th>Archive</th><th>Reason</th><th class="text-right">Size</th><th class="text-right">Created</th><th class="text-right">Actions</th></tr></thead>
    <tbody>
      {{#each backups}}
        <tr data-backup-row data-backup-id="{{id}}" data-file="{{file}}" data-size="{{size}}">
          {{! w-full + max-w-0 (sm+ only) so long archive names truncate instead of pushing
              the Actions column into horizontal scroll. }}
          <td data-th="Archive" class="sm:w-full sm:max-w-0"><span class="block truncate font-mono text-xs" title="{{file}}">{{file}}</span></td>
          <td data-th="Reason"><span class="badge {{#if (eq reason 'pre-update')}}badge-warn{{/if}}">{{reason}}</span></td>
          <td data-th="Size" class="whitespace-nowrap text-right text-ink-faint">{{bytes size}}</td>
          <td data-th="Created" class="whitespace-nowrap text-right text-ink-faint" data-ts="{{ts}}">{{ts}}</td>
          <td data-th="" class="text-right"><div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
            {{! Restore stops the server and replaces its data - it must not scan
                identically to the harmless Download beside it. }}
            <button class="btn btn-ghost btn-sm text-warn" data-backup-restore data-tip="Stops the server and restores this archive. Start it again when the restore finishes.">{{{icon 'undo-2' 'size-3.5'}}} Restore</button>
            <a class="btn btn-ghost btn-sm" href="/api/backups/{{id}}/download" data-tip="Download archive" aria-label="Download {{file}}">{{{icon 'download' 'size-3.5'}}}</a>
            <button class="btn btn-ghost btn-sm" data-backup-rename data-tip="Rename archive" aria-label="Rename {{file}}">{{{icon 'square-pen' 'size-3.5'}}}</button>
            <button class="btn btn-ghost btn-sm text-danger" data-backup-delete data-tip="Delete ({{bytes size}} freed)" aria-label="Delete {{file}}">{{{icon 'trash-2' 'size-3.5'}}}</button>
          </div></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
  {{> empty-state iconName='archive' title='No Backups Yet' message='Use Back Up Now for the first one. Scheduled and pre-update backups also collect here automatically.'}}
{{/if}}
</div>
<script type="module" src="/js/pages/server-backups.js"></script>
