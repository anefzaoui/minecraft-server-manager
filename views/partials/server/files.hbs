<div data-files-server="{{server.id}}" data-files-path="{{filePath}}" class="contents">
  <div class="card">
    <div class="flex flex-wrap items-center gap-2 border-b border-line p-3">
      <nav class="flex min-w-0 flex-wrap items-center gap-1 font-mono text-sm text-ink-soft" aria-label="{{t 'files_page.breadcrumb'}}">
        {{#if crumbs.length}}
          <a class="hover:text-link" href="/servers/{{server.id}}/files">data</a>
          {{#each crumbs}}
            <span class="text-ink-faint">/</span>
            {{#if @last}}
              <span class="truncate text-ink">{{name}}</span>
            {{else}}
              <a class="hover:text-link" href="/servers/{{../server.id}}/files?path={{urlq path}}">{{name}}</a>
            {{/if}}
          {{/each}}
        {{else}}
          <span class="text-ink">data</span>
        {{/if}}
      </nav>
      <div class="ml-auto flex flex-wrap gap-2">
        <button class="btn btn-sm" id="files-search" data-tip="{{t 'files_page.find_in_files_tip'}}">{{{icon 'search' 'size-3.5'}}} {{t 'files_page.find_in_files'}}</button>
        <button class="btn btn-sm" id="files-upload">{{{icon 'upload' 'size-3.5'}}} {{t 'files_page.upload'}}</button>
        <button class="btn btn-sm" id="files-mkdir">{{{icon 'folder-plus' 'size-3.5'}}} {{t 'files_page.new_folder'}}</button>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="table-base table-stack" id="files-table">
        <thead><tr><th>{{t 'files_page.th_name'}}</th><th class="text-right">{{t 'files_page.th_size'}}</th><th class="text-right">{{t 'files_page.th_modified'}}</th><th class="text-right">{{t 'files_page.th_actions'}}</th></tr></thead>
        <tbody>
          {{#if filePath}}
            <tr>
              <td data-th="" colspan="4">
                <a class="flex items-center gap-2 text-ink-faint hover:text-link" href="/servers/{{server.id}}/files?path={{urlq parentPath}}">{{{icon 'corner-left-up' 'size-4'}}} ..</a>
              </td>
            </tr>
          {{/if}}
          {{#each files}}
            <tr data-file-row data-path="{{path}}" data-name="{{name}}" data-dir="{{dir}}" data-size="{{size}}">
              {{! w-full + max-w-0 (sm+ only): inside an auto-layout table `truncate` never
                  engages (the column grows to the content) - this cell absorbs
                  the free width and long names actually ellipsize. }}
              <td data-th="" class="sm:w-full sm:max-w-0">
                <div class="flex items-center gap-2">
                  {{#if dir}}
                    {{{icon 'folder' 'size-4 shrink-0 text-warn'}}}
                    <a class="min-w-0 truncate font-medium hover:text-link" href="/servers/{{../server.id}}/files?path={{urlq path}}" title="{{name}}">{{name}}</a>
                  {{else}}
                    {{{icon 'file-text' 'size-4 shrink-0 text-ink-faint'}}}
                    <span class="min-w-0 truncate font-medium" title="{{name}}">{{name}}</span>
                  {{/if}}
                </div>
              </td>
              <td data-th="{{t 'files_page.th_size'}}" class="whitespace-nowrap text-right text-ink-faint">{{bytes size}}</td>
              <td data-th="{{t 'files_page.th_modified'}}" class="whitespace-nowrap text-right text-ink-faint" data-ts="{{mtime}}">{{mtime}}</td>
              <td data-th="" class="text-right"><div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
                {{#unless dir}}
                  <button class="btn btn-ghost btn-sm" data-file-edit data-tip="{{t 'files_page.edit_text_tip'}}">{{{icon 'file-code' 'size-3.5'}}}</button>
                  <button class="btn btn-ghost btn-sm" data-file-download data-tip="{{t 'files_page.download_tip'}}">{{{icon 'download' 'size-3.5'}}}</button>
                {{/unless}}
                {{! Rename/move/copy are rare - an overflow menu keeps rows from
                    forcing horizontal scroll near 1024px. }}
                <button class="btn btn-ghost btn-sm" data-menu="file-menu-{{@index}}" data-tip="{{t 'files_page.more_actions_tip'}}">{{{icon 'ellipsis' 'size-3.5'}}}</button>
                <template id="file-menu-{{@index}}">
                  <button data-file-rename data-path="{{path}}" data-name="{{name}}">{{{icon 'pencil' 'size-3.5'}}} {{t 'files_page.rename'}}</button>
                  <button data-file-move data-path="{{path}}" data-name="{{name}}">{{{icon 'move' 'size-3.5'}}} {{t 'files_page.move_to'}}</button>
                  <button data-file-copy data-path="{{path}}" data-name="{{name}}">{{{icon 'copy' 'size-3.5'}}} {{t 'files_page.copy_to'}}</button>
                </template>
                <button class="btn btn-ghost btn-sm text-danger" data-file-delete data-tip="{{t 'files_page.delete_size_tip' size=(bytes size)}}" aria-label="{{t 'files_page.aria_delete' name=name}}">{{{icon 'trash-2' 'size-3.5'}}}</button>
              </div></td>
            </tr>
          {{else}}
            <tr data-files-empty><td data-th="" colspan="4" class="py-10 text-center text-sm text-ink-faint">
              {{{icon 'folder-open' 'mx-auto size-6'}}}
              <p class="mt-2">{{t 'files_page.folder_empty'}}</p>
            </td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  <p class="help mt-2 max-w-prose">{{t 'files_page.help_note'}}</p>
</div>
<script type="module" src="/js/pages/files.js"></script>
