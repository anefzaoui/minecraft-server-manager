<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h2 class="pixel text-sm text-ink">{{#if headingKey}}{{t headingKey}}{{else}}{{heading}}{{/if}}</h2>
    {{#if subKey}}<p class="mt-2 max-w-prose text-sm text-ink-faint">{{t subKey}}</p>{{else if sub}}<p class="mt-2 max-w-prose text-sm text-ink-faint">{{sub}}</p>{{/if}}
  </div>
  {{#if actionsPartial}}{{> (lookup . 'actionsPartial')}}{{/if}}
</div>
