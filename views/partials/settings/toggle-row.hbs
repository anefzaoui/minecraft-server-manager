{{!-- A settings switch row: text on the left, toggle on the right, the whole
    row is the <label> so tapping the text flips it. Mirrors the boolean row in
    catalog-field.hbs. Params: label, help (optional), inputId, checked (bool). --}}
<label class="flex cursor-pointer items-start justify-between gap-4 py-1">
  <span class="min-w-0">
    <span class="block text-sm font-medium text-ink">{{label}}</span>
    {{#if help}}<span class="mt-1 block max-w-prose text-xs leading-relaxed text-ink-faint">{{help}}</span>{{/if}}
  </span>
  <span class="msm-toggle mt-0.5 shrink-0">
    <input type="checkbox" id="{{inputId}}" {{#if checked}}checked{{/if}}>
    <span></span>
  </span>
</label>
