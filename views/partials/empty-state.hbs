<div class="card grid place-items-center px-6 py-14 text-center">
  <div class="grid size-14 place-items-center rounded-lg bg-inset text-ink-faint">{{{icon (default iconName 'boxes') 'size-7'}}}</div>
  <h3 class="mt-3 font-semibold">{{#if titleKey}}{{t titleKey}}{{else}}{{title}}{{/if}}</h3>
  <p class="mt-1 max-w-sm text-sm text-ink-faint">{{#if messageKey}}{{t messageKey}}{{else}}{{message}}{{/if}}</p>
  {{#if ctaHref}}<a href="{{ctaHref}}" class="btn btn-primary mt-4">{{#if ctaLabelKey}}{{t ctaLabelKey}}{{else}}{{ctaLabel}}{{/if}}</a>
  {{else if ctaId}}<button id="{{ctaId}}" class="btn btn-primary mt-4" type="button">{{#if ctaLabelKey}}{{t ctaLabelKey}}{{else}}{{ctaLabel}}{{/if}}</button>{{/if}}
</div>
