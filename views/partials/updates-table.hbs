{{! One updates table; the Updates page renders it twice (server updates, mod
    updates). Params: rows. Row buttons are wired by public/js/pages/updates.js
    through the data-updates-table hook, so both tables share the handlers. }}
<div class="card overflow-x-auto">
  <table class="table-base table-stack" data-updates-table>
    <thead><tr><th>Server</th><th>Type</th><th>Subject</th><th>Current</th><th>Latest</th><th class="text-right">Actions</th></tr></thead>
    <tbody>
      {{#each rows}}
        <tr data-update-row class="{{#if ignored}}opacity-60{{/if}}" data-server-id="{{serverId}}" data-server-name="{{server}}"
            data-kind="{{kind}}" data-subject-type="{{subjectType}}" data-subject="{{subject}}" data-current="{{current}}" data-latest="{{latest}}"
            {{#if versionId}}data-version-id="{{versionId}}"{{/if}} {{#if contentId}}data-content-id="{{contentId}}"{{/if}}
            {{#if imageUpgrade}}data-image-upgrade="1"{{/if}}
            {{#if targetVersion}}data-target-version="{{targetVersion}}"{{/if}}
            {{#if targetLoaderBuild}}data-target-build="{{targetLoaderBuild}}" data-env-key="{{envKey}}"{{/if}}>
          <td data-th="Server" class="whitespace-nowrap">{{#if serverId}}<a class="text-link hover:underline" href="/servers/{{serverId}}">{{server}}</a>{{else}}<span class="text-ink-faint">{{server}}</span>{{/if}}</td>
          <td data-th="Type"><span class="badge">{{kind}}</span></td>
          {{! w-full + max-w-0 (sm+ only) so long pack/mod names truncate instead of widening the table. }}
          <td data-th="Subject" class="sm:w-full sm:max-w-0"><span class="block truncate font-medium" title="{{subject}}">{{subject}}</span></td>
          <td data-th="Current" class="truncate font-mono text-xs text-ink-faint sm:max-w-40" title="{{current}}">{{current}}</td>
          <td data-th="Latest" class="truncate font-mono text-xs sm:max-w-40 {{#if ignored}}text-ink-faint{{else}}text-warn{{/if}}" title="{{latest}}">
            {{latest}}{{#if ignored}} <span class="badge ml-1 text-ink-faint" data-tip="This update is ignored and won't be offered">ignored</span>{{/if}}
          </td>
          <td data-th="" class="text-right"><div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
            {{#if changelog}}<a class="btn btn-ghost btn-sm" href="{{changelog}}" target="_blank" rel="noopener">{{{icon 'external-link' 'size-3.5'}}} Changelog</a>{{/if}}
            {{#if ignored}}
              <button class="btn btn-ghost btn-sm" data-update-unignore data-tip="Offer {{latest}} again">{{{icon 'bell' 'size-3.5'}}} Un-ignore</button>
            {{else}}
              <button class="btn btn-ghost btn-sm" data-update-ignore data-tip="Stop offering {{latest}} for this subject">{{{icon 'bell-off' 'size-3.5'}}} Ignore</button>
              <button class="btn btn-sm" data-update-upgrade>{{{icon 'circle-arrow-up' 'size-3.5'}}} Upgrade…</button>
            {{/if}}
          </div></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
