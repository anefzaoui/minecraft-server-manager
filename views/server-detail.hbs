{{> server/chrome}}

{{! World controls ride along on every tab as a right rail (stacks below on
    smaller screens) - always within reach while managing players/files/etc. }}
<div class="grid items-start gap-4 {{#if (eq server.runtime 'bedrock')}}xl:grid-cols-1{{else}}xl:grid-cols-[minmax(0,1fr)_300px]{{/if}}">
  <div class="min-w-0">
    {{#if bedrockPacksExperience}}
      {{> server/bedrock-packs}}
    {{else if (and (eq tab 'players') (eq server.runtime 'bedrock'))}}
      {{> server/bedrock-players}}
    {{else}}
      {{> (concat 'server/' tab)}}
    {{/if}}
  </div>
  {{#unless (eq server.runtime 'bedrock')}}
    <aside>
      {{> server/world-controls-rail}}
    </aside>
  {{/unless}}
</div>
