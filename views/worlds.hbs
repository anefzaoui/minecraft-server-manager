{{> page-header headingKey="worlds_page.heading" subKey="worlds_page.sub"}}

<div data-worlds-page class="contents">
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <button class="btn btn-primary" id="world-upload" data-tip="{{t 'worlds_page.upload_world_btn_tip'}}">{{{icon 'upload' 'size-4'}}} {{t 'worlds_page.upload_world'}}</button>
    <button class="btn" id="world-extract" data-tip="{{t 'worlds_page.save_live_tip'}}">{{{icon 'camera' 'size-4'}}} {{t 'worlds_page.save_to_library'}}</button>
  </div>

  {{#if worlds.length}}
  <div class="card overflow-x-auto">
    <table class="table-base table-stack" id="worlds-table">
      <thead><tr><th>{{t 'worlds_page.th_world'}}</th><th>{{t 'worlds_page.th_source'}}</th><th>{{t 'worlds_page.th_compat'}}</th><th class="text-right">{{t 'worlds_page.th_size'}}</th><th class="text-right">{{t 'worlds_page.th_actions'}}</th></tr></thead>
      <tbody>
        {{#each worlds}}
          <tr data-world-row data-id="{{id}}" data-name="{{name}}" data-size="{{size}}">
            <td data-th="" class="sm:w-full sm:max-w-0"><div class="flex items-center gap-2">{{{icon 'earth' 'size-5 shrink-0 text-link'}}}<div class="min-w-0"><div class="truncate font-medium" title="{{name}}">{{name}}</div><div class="truncate text-xs text-ink-faint"><span data-ts="{{created}}">{{created}}</span> · {{hash}}</div></div></div></td>
            <td data-th="{{t 'worlds_page.th_source'}}" class="text-xs text-ink-soft">{{source}}</td>
            <td data-th="{{t 'worlds_page.th_compat'}}">
              {{#if flavor}}
                <span class="chip">{{flavor}}{{#if mcVersion}} {{mcVersion}}{{/if}}</span>
              {{else if mcVersion}}
                <span class="chip">{{mcVersion}}</span>
              {{else}}
                <span class="text-xs text-ink-faint">{{t 'common.unknown'}}</span>
              {{/if}}
            </td>
            <td data-th="{{t 'worlds_page.th_size'}}" class="whitespace-nowrap text-right text-ink-faint">{{bytes size}}</td>
            <td data-th="" class="text-right"><div class="flex flex-wrap gap-1 sm:inline-flex sm:flex-nowrap">
              <button class="btn btn-ghost btn-sm" data-world-install data-tip="{{t 'worlds_page.install_to_tip'}}">{{{icon 'import' 'size-3.5'}}} {{t 'worlds_page.install_to'}}</button>
              <a class="btn btn-ghost btn-sm" href="/api/worlds/{{id}}/download" data-tip="{{t 'worlds_page.download_archive_tip'}}">{{{icon 'download' 'size-3.5'}}}</a>
              <button class="btn btn-ghost btn-sm text-danger" data-world-delete data-tip="{{t 'worlds_page.delete_lib_tip' size=(bytes size)}}" aria-label="{{t 'worlds_page.aria_delete' name=name}}">{{{icon 'trash-2' 'size-3.5'}}}</button>
            </div></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="notice mt-4 max-w-prose text-xs">
    {{{icon 'lightbulb' 'size-4 mt-0.5 shrink-0'}}}
    <div>{{t 'worlds_page.install_notice'}}</div>
  </div>
  {{else}}
    {{> empty-state iconName='earth' titleKey='worlds_page.empty_lib_title' messageKey='worlds_page.empty_lib_message'}}
  {{/if}}

  <div id="msm-server-options" hidden data-options="{{jsonAttr serverOptions}}"></div>
</div>
<script type="module" src="/js/pages/worlds.js"></script>
