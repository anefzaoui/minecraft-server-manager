<div class="mx-auto max-w-3xl" id="wizard" data-suggested-port="{{suggestedPort}}">
  {{> page-header headingKey="wizard.heading" subKey="wizard.sub"}}

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <div class="seg" id="wz-source-tabs" role="tablist" aria-label="{{t 'wizard.tab_vanilla'}}">
      <button class="seg-btn" type="button" role="tab" aria-selected="true" data-source="vanilla">{{t 'wizard.tab_vanilla'}}</button>
      <button class="seg-btn" type="button" role="tab" aria-selected="false" data-source="mods">{{t 'wizard.tab_mods'}}</button>
      <button class="seg-btn" type="button" role="tab" aria-selected="false" data-source="modpack">{{t 'wizard.tab_modpack'}}</button>
      <button class="seg-btn" type="button" role="tab" aria-selected="false" data-source="blueprint">{{t 'wizard.tab_blueprint'}}</button>
    </div>
    <label class="ml-auto flex cursor-pointer items-center gap-2.5 text-sm font-medium" id="wz-detail-toggle">
      {{t 'wizard.advanced_options'}}
      <span class="msm-toggle"><input type="checkbox" id="wz-advanced-switch"><span></span></span>
    </label>
  </div>

  {{! "From mods" source tab - the server's creation hub. Two sub-modes:
      Choose loader (loader-first browser, default) and Auto-detect (the solver). }}
  <div class="mb-4 hidden space-y-3" id="wz-mods-panel">
    <div class="flex flex-wrap items-center gap-2">
      <div class="seg" id="wz-mods-mode" role="tablist" aria-label="{{t 'wizard.mode_choose_loader'}}">
        <button class="seg-btn" type="button" role="tab" aria-selected="true" data-mode="browse">{{t 'wizard.mode_choose_loader'}}</button>
        <button class="seg-btn" type="button" role="tab" aria-selected="false" data-mode="auto">{{t 'wizard.mode_auto_detect'}}</button>
      </div>
    </div>

    {{! ---- Choose-loader browser (default) ---- }}
    <div class="card p-5" id="wz-mods-browse">
      <h3 class="mb-1 font-semibold">{{t 'wizard.build_modded_title'}}</h3>
      {{#if curseforgeEnabled}}
        <p class="help mb-4">{{t 'wizard.build_modded_desc' platforms='Modrinth & CurseForge'}}</p>
      {{else}}
        <p class="help mb-4">{{t 'wizard.build_modded_desc' platforms='Modrinth'}}</p>
      {{/if}}

      <label class="label">{{t 'wizard.mod_loader'}}</label>
      <div class="mb-4 grid grid-cols-2 gap-2 sm:grid-cols-4" id="wz-loaders">
        <button type="button" data-loader="fabric" class="tile p-3" aria-pressed="true">{{{icon 'layers' 'size-5'}}}<span class="text-xs font-semibold">Fabric</span></button>
        <button type="button" data-loader="forge" class="tile p-3" aria-pressed="false">{{{icon 'hammer' 'size-5'}}}<span class="text-xs font-semibold">Forge</span></button>
        <button type="button" data-loader="neoforge" class="tile p-3" aria-pressed="false">{{{icon 'flame' 'size-5'}}}<span class="text-xs font-semibold">NeoForge</span></button>
        <button type="button" data-loader="quilt" class="tile p-3" aria-pressed="false">{{{icon 'grid-2x2' 'size-5'}}}<span class="text-xs font-semibold">Quilt</span></button>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="label" for="wz-mods-mc">{{t 'wizard.mc_version'}}</label>
          <select class="input" id="wz-mods-mc" data-label="{{t 'wizard.mc_version'}}"></select>
        </div>
        <div>
          <label class="label" for="wz-mods-loaderver">{{t 'wizard.loader_build'}}</label>
          <select class="input" id="wz-mods-loaderver" data-label="{{t 'wizard.loader_build'}}"><option value="">{{t 'wizard.latest_recommended'}}</option></select>
          <p class="help">{{t 'wizard.loader_build_help'}}</p>
        </div>
      </div>

      <div class="mt-4">
        <div class="flex flex-wrap items-center gap-2">
          <input class="input min-w-48 flex-1" id="wz-mods-q" placeholder="{{t 'wizard.search_mods_placeholder'}}" autocomplete="off">
          {{#if curseforgeEnabled}}
            <div class="seg" id="wz-mods-platforms" role="group" aria-label="Search platform">
              <button type="button" class="seg-btn" aria-pressed="true" data-platform="modrinth">Modrinth</button>
              <button type="button" class="seg-btn" aria-pressed="false" data-platform="curseforge">CurseForge</button>
            </div>
          {{/if}}
        </div>
        <div class="mt-2 hidden max-h-80 overflow-y-auto rounded-md border border-line" id="wz-mods-results"></div>
      </div>

      <div class="mt-4 hidden" id="wz-mods-selected-wrap">
        <div class="mb-2 flex items-center gap-2">
          <span class="text-sm font-semibold">{{t 'wizard.selected_mods'}}</span>
          <span class="badge" id="wz-mods-count">0</span>
          <span class="ml-auto text-xs text-ink-faint" id="wz-mods-dephint"></span>
        </div>
        <div class="space-y-2" id="wz-mods-selected"></div>
      </div>
    </div>

    {{! ---- Auto-detect (the compatibility solver) ---- }}
    <div class="card p-5 hidden" id="wz-solver">
      <h3 class="mb-1 font-semibold">{{t 'wizard.solver_title'}}</h3>
      {{#if curseforgeEnabled}}
        <p class="help mb-4">{{t 'wizard.solver_desc' platforms='Modrinth & CurseForge'}}</p>
      {{else}}
        <p class="help mb-4">{{t 'wizard.solver_desc' platforms='Modrinth'}}</p>
      {{/if}}
      <div>
        <label class="label" for="wz-solver-q">{{t 'wizard.search_mods_label'}}</label>
        <div class="flex flex-wrap items-center gap-2">
          <input class="input min-w-48 flex-1" id="wz-solver-q" placeholder="{{t 'wizard.search_mods_placeholder'}}" autocomplete="off">
          {{#if curseforgeEnabled}}
            <div class="seg" id="wz-solver-platforms" role="group" aria-label="Search platform">
              <button type="button" class="seg-btn" aria-pressed="true" data-platform="modrinth">Modrinth</button>
              <button type="button" class="seg-btn" aria-pressed="false" data-platform="curseforge">CurseForge</button>
            </div>
          {{/if}}
        </div>
      </div>
      <div class="mt-2 hidden max-h-72 overflow-y-auto rounded-md border border-line" id="wz-solver-results"></div>
      <div class="mt-3 hidden flex-wrap gap-1.5" id="wz-solver-chips"></div>
      <div class="mt-4 flex items-center gap-3">
        <button class="btn btn-primary" id="wz-solver-run" type="button" disabled>{{{icon 'wand-sparkles' 'size-4'}}} {{t 'wizard.solve_compat_btn'}}</button>
        <span class="text-xs text-ink-faint" id="wz-solver-hint">{{t 'wizard.solver_hint'}}</span>
      </div>
      <div class="mt-4 hidden" id="wz-solver-result"></div>
      <input type="hidden" id="wz-solver-mods" value="">
    </div>
  </div>

  {{! U1/U2: "From modpack" source tab - search, pin a version, real one-task install }}
  <div class="card mb-4 hidden p-5" id="wz-modpack">
    <h3 class="mb-1 font-semibold">{{t 'wizard.pick_modpack_title'}}</h3>
    <p class="help mb-4">{{t 'wizard.pick_modpack_desc'}}</p>
    {{! GTNH ships outside Modrinth/CurseForge - a fixed card, not a search result }}
    <div class="mb-4 flex flex-wrap items-center gap-3 rounded-md border border-line p-3" id="wz-gtnh-card">
      <div class="min-w-0 flex-1">
        <div class="font-semibold">{{t 'wizard.gtnh_title'}}</div>
        <div class="text-xs text-ink-faint">{{t 'wizard.gtnh_desc'}}</div>
      </div>
      <button type="button" class="btn shrink-0" id="wz-gtnh-pick">{{t 'wizard.setup_btn'}}</button>
    </div>
    {{! Custom zip — CurseForge modpack export or a hand-assembled zip of jars }}
    <div class="mb-4 flex flex-wrap items-center gap-3 rounded-md border border-line p-3" id="wz-zip-card">
      <div class="min-w-0 flex-1">
        <div class="font-semibold">{{t 'wizard.custom_zip_title'}}</div>
        <div class="text-xs text-ink-faint">{{t 'wizard.custom_zip_desc'}}{{#unless curseforgeEnabled}} ({{t 'wizard.custom_zip_needs_key'}}){{/unless}}.</div>
      </div>
      <button type="button" class="btn shrink-0" id="wz-zip-pick">{{t 'wizard.upload_zip_btn'}}</button>
    </div>
    <div class="mb-4 hidden" id="wz-zip-selected"></div>
    <div class="flex flex-wrap items-center gap-2">
      <input class="input min-w-48 flex-1" id="wz-pack-q" placeholder="{{t 'wizard.search_packs_placeholder'}}" autocomplete="off">
      <div class="seg" id="wz-pack-platforms" role="group" aria-label="Search platform">
        <button type="button" class="seg-btn" aria-pressed="true" data-platform="modrinth">Modrinth</button>
        <button type="button" class="seg-btn" aria-pressed="false" data-platform="curseforge">CurseForge</button>
      </div>
    </div>
    <div class="mt-2 hidden max-h-80 overflow-y-auto rounded-md border border-line" id="wz-pack-results"></div>
    <div class="mt-4 hidden" id="wz-pack-selected">
      <div class="notice notice-ok items-center" id="wz-pack-summary"></div>
      <div class="mt-3 grid items-end gap-4 sm:grid-cols-[1fr_auto]">
        <div>
          <label class="label" for="wz-pack-version">{{t 'wizard.pack_version'}}
            <span class="text-xs font-normal text-ink-faint">{{t 'wizard.always_pinned'}}</span></label>
          <select class="input" id="wz-pack-version" data-label="{{t 'wizard.pack_version'}}"></select>
          <label class="mt-2 hidden items-center gap-2 text-xs text-ink-faint" id="wz-gtnh-beta-row">
            <input type="checkbox" id="wz-gtnh-beta" />
            {{t 'wizard.include_beta'}}
          </label>
        </div>
        <button type="button" class="btn mb-0.5" id="wz-pack-details-btn">{{{icon 'book-open' 'size-4'}}} {{t 'wizard.view_details'}}</button>
      </div>
    </div>
  </div>

  {{! "From blueprint" source tab - identity stays editable, the blueprint owns the rest }}
  <div class="card mb-4 hidden p-5" id="wz-blueprint-panel">
    <h3 class="mb-1 font-semibold">{{t 'wizard.blueprint_title'}}</h3>
    <p class="help mb-4">{{t 'wizard.blueprint_desc'}}</p>
    <label class="label" for="wz-blueprint">{{t 'wizard.blueprint_label'}}</label>
    <select class="input" id="wz-blueprint" data-label="{{t 'wizard.blueprint_label'}}">
      <option value="">{{t 'wizard.choose_blueprint'}}</option>
      {{#each blueprints}}<option value="{{id}}" data-desc="{{notes}}">{{name}}</option>{{/each}}
    </select>
    {{#unless blueprints.length}}
      <p class="help mt-2">{{t 'wizard.no_blueprints_help'}}</p>
    {{/unless}}
  </div>

  <div class="card p-5">
    <h3 class="mb-4 font-semibold">{{t 'wizard.identity_title'}}</h3>
    <div class="grid gap-4 sm:grid-cols-[minmax(14rem,1fr)_auto]">
      <div>
        <label class="label" for="wz-name">{{t 'wizard.server_name'}}</label>
        <input class="input" id="wz-name" placeholder="{{t 'wizard.server_name_placeholder'}}" autocomplete="off">
      </div>
      <div>
        <label class="label">{{t 'wizard.icon_color'}}</label>
        <div class="flex flex-wrap gap-1.5" id="wz-icons">
          <button type="button" data-icon="grass" class="tile size-10 p-1" style="background: #3fa62b" aria-pressed="true"><img src="/icons/servers/grass.svg" alt="Grass" class="size-full rounded-sm"></button>
          <button type="button" data-icon="creeper" class="tile size-10 p-1" style="background: #3fa62b" aria-pressed="false"><img src="/icons/servers/creeper.svg" alt="Creeper" class="size-full rounded-sm"></button>
          <button type="button" data-icon="diamond" class="tile size-10 p-1" style="background: #3fa62b" aria-pressed="false"><img src="/icons/servers/diamond.svg" alt="Diamond" class="size-full rounded-sm"></button>
          <button type="button" data-icon="tnt" class="tile size-10 p-1" style="background: #3fa62b" aria-pressed="false"><img src="/icons/servers/tnt.svg" alt="TNT" class="size-full rounded-sm"></button>
          <button type="button" data-icon="portal" class="tile size-10 p-1" style="background: #3fa62b" aria-pressed="false"><img src="/icons/servers/portal.svg" alt="Portal" class="size-full rounded-sm"></button>
          <button type="button" data-icon="chest" class="tile size-10 p-1" style="background: #3fa62b" aria-pressed="false"><img src="/icons/servers/chest.svg" alt="Chest" class="size-full rounded-sm"></button>
          <button type="button" data-icon="sword" class="tile size-10 p-1" style="background: #3fa62b" aria-pressed="false"><img src="/icons/servers/sword.svg" alt="Sword" class="size-full rounded-sm"></button>
          <button type="button" data-icon="potion" class="tile size-10 p-1" style="background: #3fa62b" aria-pressed="false"><img src="/icons/servers/potion.svg" alt="Potion" class="size-full rounded-sm"></button>
        </div>
      </div>
    </div>
    <div class="mt-3 grid gap-4 sm:grid-cols-[minmax(14rem,1fr)_auto]">
      <div>
        <label class="label" for="wz-desc">{{t 'wizard.description_label'}} <span class="text-xs font-normal text-ink-faint">{{t 'wizard.optional'}}</span></label>
        <input class="input" id="wz-desc" placeholder="{{t 'wizard.description_placeholder'}}">
      </div>
      <div>
        <label class="label">{{t 'wizard.accent_color'}}</label>
        <div class="flex flex-wrap gap-1.5" id="wz-colors">
          <button type="button" data-accent="#3fa62b" class="swatch size-10" style="background:#3fa62b" data-tip="{{t 'colors.grass'}}" aria-pressed="true"></button>
          <button type="button" data-accent="#21a7ab" class="swatch size-10" style="background:#21a7ab" data-tip="{{t 'colors.diamond'}}" aria-pressed="false"></button>
          <button type="button" data-accent="#e5484d" class="swatch size-10" style="background:#e5484d" data-tip="{{t 'colors.redstone'}}" aria-pressed="false"></button>
          <button type="button" data-accent="#e99417" class="swatch size-10" style="background:#e99417" data-tip="{{t 'colors.gold'}}" aria-pressed="false"></button>
          <button type="button" data-accent="#9a5cc6" class="swatch size-10" style="background:#9a5cc6" data-tip="{{t 'colors.amethyst'}}" aria-pressed="false"></button>
        </div>
      </div>
    </div>
  </div>

  <div class="card mt-4 p-5" id="wz-card-flavor">
    <h3 class="mb-4 font-semibold">{{t 'wizard.type_version_title'}}</h3>
    <p class="help mb-3">{{t 'wizard.type_version_help'}}</p>
    <div class="mb-4 grid grid-cols-3 gap-2" id="wz-flavors">
      <button type="button" data-type="VANILLA" class="tile p-3" aria-pressed="true">{{{icon 'box' 'size-5'}}}<span class="text-xs font-semibold">Vanilla</span></button>
      <button type="button" data-type="PAPER" class="tile p-3" aria-pressed="false">{{{icon 'scroll-text' 'size-5'}}}<span class="text-xs font-semibold">Paper</span></button>
      <button type="button" data-type="PURPUR" class="tile p-3" aria-pressed="false">{{{icon 'gem' 'size-5'}}}<span class="text-xs font-semibold">Purpur</span></button>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="label" for="wz-version">{{t 'wizard.mc_version'}}</label>
        <select class="input" id="wz-version" data-label="{{t 'wizard.mc_version'}}">
          <option value="LATEST" selected>LATEST ({{latestRelease}})</option>
          {{#each versions}}<option value="{{id}}"{{#unless (eq type "release")}} data-desc="{{#if (eq type "snapshot")}}Snapshot{{else if (eq type "old_beta")}}Beta{{else}}Alpha{{/if}}"{{/unless}}>{{id}}</option>{{/each}}
        </select>
        <p class="help">{{t 'wizard.versions_help'}}</p>
      </div>
      <div>
        <label class="label" for="wz-port" id="wz-port-label">{{t 'wizard.game_port'}}</label>
        <input class="input max-w-48 font-mono" id="wz-port" value="{{suggestedPort}}" inputmode="numeric">
        <p class="help" id="wz-port-help">{{t 'wizard.game_port_help'}}</p>
      </div>
    </div>
  </div>

  <div class="card mt-4 p-5" id="wz-card-world">
    <h3 class="mb-4 font-semibold">{{t 'wizard.world_rules_title'}}</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="label" for="wz-seed">{{t 'wizard.world_seed'}} <span class="text-xs font-normal text-ink-faint">{{t 'wizard.optional'}}</span></label>
        <input class="input font-mono" id="wz-seed" placeholder="{{t 'wizard.seed_random'}}">
      </div>
      <div>
        <label class="label" for="wz-maxplayers">{{t 'wizard.max_players'}}</label>
        <input class="input max-w-48" id="wz-maxplayers" type="number" inputmode="numeric" value="10" min="1" max="1000">
      </div>
      <div>
        <label class="label" for="wz-difficulty">{{t 'wizard.difficulty'}}</label>
        <select class="input" id="wz-difficulty" data-label="{{t 'wizard.difficulty'}}">
          <option value="peaceful">{{t 'wizard.diff_peaceful'}}</option><option value="easy">{{t 'wizard.diff_easy'}}</option><option value="normal" selected>{{t 'wizard.diff_normal'}}</option><option value="hard">{{t 'wizard.diff_hard'}}</option>
        </select>
      </div>
      <div>
        <label class="label" for="wz-mode">{{t 'wizard.game_mode'}}</label>
        <select class="input" id="wz-mode" data-label="{{t 'wizard.game_mode'}}">
          <option value="survival" selected>{{t 'wizard.mode_survival'}}</option><option value="creative">{{t 'wizard.mode_creative'}}</option><option value="adventure">{{t 'wizard.mode_adventure'}}</option><option value="spectator">{{t 'wizard.mode_spectator'}}</option>
        </select>
      </div>
      <div>
        <label class="label" for="wz-pvp">{{t 'wizard.pvp'}}</label>
        <select class="input" id="wz-pvp" data-label="{{t 'wizard.pvp'}}">
          <option value="true" selected>{{t 'wizard.pvp_on'}}</option><option value="false">{{t 'wizard.pvp_off'}}</option>
        </select>
        <p class="help">{{t 'wizard.pvp_help'}}</p>
      </div>
    </div>
    <div class="mt-4">
      <label class="label" for="wz-motd">{{t 'wizard.motd'}} <span class="text-xs font-normal text-ink-faint">{{t 'wizard.motd_sub'}}</span></label>
      <input class="input font-mono" id="wz-motd" value="&aA Minecraft server">
      <div class="console mt-2 py-2 text-sm" id="wz-motd-preview"></div>
    </div>
  </div>

  <div class="card mt-4 p-5" id="wz-card-resources">
    <h3 class="mb-4 font-semibold">{{t 'wizard.resources_title'}}</h3>
    <div>
      <label class="label">{{t 'wizard.ram_label'}}</label>
      <div class="flex items-center gap-3">
        <input type="range" min="1024" max="16384" step="512" value="{{defaults.heapMb}}" class="msm-range flex-1" id="wz-ram" data-out="wz-ram-out" data-unit=" MB">
        <span class="w-24 text-right font-mono text-sm" id="wz-ram-out">{{defaults.heapMb}} MB</span>
      </div>
      <p class="help">{{t 'wizard.ram_help'}}</p>
    </div>
    <div class="mt-4">
      <label class="label">{{t 'wizard.disk_quota'}}</label>
      <div class="flex items-center gap-3">
        <input type="range" min="0" max="200" step="5" value="{{defaults.diskQuotaGb}}" class="msm-range flex-1" id="wz-quota" data-out="wz-quota-out" data-unit=" GB" data-zero="off">
        <span class="w-24 text-right font-mono text-sm" id="wz-quota-out">{{defaults.diskQuotaGb}} GB</span>
      </div>
    </div>
  </div>

  <div id="wz-advanced" class="mt-4 hidden space-y-3">
    <div class="notice notice-info text-xs">
      {{{icon 'info' 'size-3.5 mt-0.5 shrink-0'}}}
      <div>{{t 'wizard.advanced_notice'}}</div>
    </div>
    {{#each advancedSections}}
      <details class="card group">
        <summary class="flex cursor-pointer items-center gap-2.5 p-4 font-semibold marker:content-none">
          {{{icon icon 'size-4 text-ink-faint'}}} {{label}}
          <span class="badge ml-1">{{fields.length}}</span>
          <span class="ml-auto text-ink-faint transition group-open:rotate-180">{{{icon 'chevron-down' 'size-4'}}}</span>
        </summary>
        <div class="divide-y divide-line/60 border-t border-line px-4 pb-4">
          {{#each fields}}
            {{> catalog-field}}
          {{/each}}
        </div>
      </details>
    {{/each}}
    <details class="card group">
      <summary class="flex cursor-pointer items-center gap-2.5 p-4 font-semibold marker:content-none">
        {{{icon 'terminal' 'size-4 text-ink-faint'}}} {{t 'wizard.extra_env_title'}}
        <span class="ml-auto text-ink-faint transition group-open:rotate-180">{{{icon 'chevron-down' 'size-4'}}}</span>
      </summary>
      <div class="border-t border-line p-4">
        <textarea class="input font-mono text-xs" id="wz-extra-env" rows="4" placeholder="KEY=value&#10;ANOTHER_KEY=value"></textarea>
        <p class="help">{{t 'wizard.extra_env_help'}}</p>
      </div>
    </details>
    {{#if (eq user.role 'admin')}}
    <details class="card group">
      <summary class="flex cursor-pointer items-center gap-2.5 p-4 font-semibold marker:content-none">
        {{{icon 'container' 'size-4 text-ink-faint'}}} {{t 'wizard.advanced_docker_title'}}
        <span class="ml-auto text-ink-faint transition group-open:rotate-180">{{{icon 'chevron-down' 'size-4'}}}</span>
      </summary>
      <div class="space-y-4 border-t border-line p-4">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="wz-docker-name">{{t 'wizard.container_name'}} <span class="text-xs font-normal text-ink-faint">{{t 'wizard.optional'}}</span></label>
            <input class="input font-mono" id="wz-docker-name" placeholder="msm-<auto>" autocomplete="off">
            <p class="help">{{t 'wizard.container_name_help'}}</p>
          </div>
          <div>
            <label class="label" for="wz-docker-network">{{t 'wizard.docker_network'}} <span class="text-xs font-normal text-ink-faint">{{t 'wizard.optional'}}</span></label>
            <select class="input" id="wz-docker-network" data-label="{{t 'wizard.docker_network'}}">
              <option value="">{{t 'wizard.docker_network_default'}}</option>
            </select>
            <p class="help">{{t 'wizard.docker_network_help'}}</p>
          </div>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-sm font-semibold">{{t 'wizard.extra_ports'}}</span>
            <button type="button" class="btn btn-sm" id="wz-docker-port-add">{{{icon 'plus' 'size-3.5'}}} {{t 'wizard.add_port'}}</button>
          </div>
          <div class="space-y-2" id="wz-docker-ports"></div>
          <p class="help">{{t 'wizard.ports_help'}}</p>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-sm font-semibold">{{t 'wizard.extra_binds'}}</span>
            <button type="button" class="btn btn-sm" id="wz-docker-bind-add">{{{icon 'plus' 'size-3.5'}}} {{t 'wizard.add_bind'}}</button>
          </div>
          <div class="space-y-2" id="wz-docker-binds"></div>
          <p class="help">{{t 'wizard.binds_help'}}</p>
        </div>

        <div class="flex justify-end">
          <button type="button" class="btn" id="wz-docker-preview">{{{icon 'file-code' 'size-4'}}} {{t 'wizard.preview_yaml'}}</button>
        </div>
      </div>
    </details>
    {{/if}}
  </div>

  <div class="mt-6 flex items-center justify-between">
    <a href="/" class="btn btn-ghost">{{t 'wizard.cancel'}}</a>
    <button class="btn btn-primary" id="wz-create" type="button">{{{icon 'pickaxe' 'size-4'}}} {{t 'wizard.create_and_start'}}</button>
  </div>
</div>
<script type="module" src="/js/pages/wizard.js"></script>
