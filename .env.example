# Copy to .env and adjust. Every value is optional - the defaults shown work out
# of the box, and a fresh `pnpm start` is secure with no edits at all.

# Root directory for ALL panel-managed state (DB, server data, backups, library…).
DATA_DIR=./data

# Only when the panel itself runs in a container: the ABSOLUTE host path of the
# directory mounted at DATA_DIR. Bind mounts are resolved by the Docker daemon
# against the HOST filesystem, so the panel re-roots every path it hands to
# Docker onto this. Leave blank when running the panel directly on the host.
DATA_DIR_HOST=

# Address the panel uses to reach OTHER containers' host-published ports (e.g.
# BlueMap's live map) - the panel's own 127.0.0.1 is not the host's when the panel runs in a
# container. Leave blank: resolves to 127.0.0.1 on bare
# metal, or host.docker.internal automatically once DATA_DIR_HOST is set
# (needs `extra_hosts: host.docker.internal:host-gateway` - see
# docker-compose.yml). Override only for rootless Docker / a remote daemon.
MAP_PROXY_HOST=

# Web UI bind address and port. The default binds to localhost ONLY (127.0.0.1) -
# the panel is reachable just from this machine. Set PANEL_HOST=0.0.0.0 to reach it
# from your LAN; only put it on the internet behind a reverse proxy with TLS.
PANEL_HOST=127.0.0.1
# 25564 sits just below the game-port range (25565+), so your game instances
# number cleanly upward from 25565 without the panel taking a slot in the middle.
PANEL_PORT=25564

# Signs the session cookie. Leave BLANK to have the panel generate a strong
# random secret on first run and persist it at $DATA_DIR/.session-secret. Set it
# yourself only if you want to control the value (e.g. share one across
# replicas). At-rest encryption of stored API keys / RCON passwords / TOTP
# secrets uses a SEPARATE dedicated key at $DATA_DIR/.secret-key (auto-generated,
# back it up), so rotating SESSION_SECRET no longer invalidates stored secrets.
SESSION_SECRET=

# Set these when running behind a reverse proxy that terminates TLS.
#   TRUST_PROXY:  proxy hops to trust (usually 1), 'loopback', or a comma-list of
#                 proxy IPs - so req.ip (login rate-limiting) sees the real client.
#   COOKIE_SECURE: 'true' to force the Secure cookie flag over HTTPS, or 'auto' to
#                 let the panel decide from X-Forwarded-Proto (needs TRUST_PROXY set).
#   COOKIE_SAMESITE: 'lax' (default), 'strict', or 'none'. Leave blank unless you
#                 know you need it - 'strict' stops the session cookie from being
#                 sent when you open the panel via a link from another site, so it
#                 looks like "remember me" keeps logging you out. 'none' needs
#                 COOKIE_SECURE.
TRUST_PROXY=
COOKIE_SECURE=
COOKIE_SAMESITE=

# Coarse per-client-IP request-rate ceilings (a volume backstop on top of the
# per-account login lockout). Counters are per process and key on req.ip, so
# behind a proxy set TRUST_PROXY too or every client shares one bucket. Leave
# blank for the defaults; set RATE_LIMIT_API_PER_MIN=0 to disable the API
# limiter (e.g. when your reverse proxy already rate-limits).
#   RATE_LIMIT_API_PER_MIN     default 1200   (0 = off)
#   RATE_LIMIT_AUTH_PER_15MIN  default 100    login / 2FA / setup POSTs (0 = off)
RATE_LIMIT_API_PER_MIN=
RATE_LIMIT_AUTH_PER_15MIN=

# Docker endpoint override. Auto-detected per-OS by default (Windows named pipe or
# the unix socket). Set this for rootless Docker, Podman, or a remote daemon, e.g.:
#   unix:///run/user/1000/docker.sock    or    tcp://192.168.1.10:2375
DOCKER_HOST=

# Optional: seed a CurseForge API key on first run (the Settings page can also set
# it). Wrap in single quotes - CF keys often contain $ characters. It is imported
# once into the encrypted store on first boot; you can remove it from here after
# that first run.
CF_API_KEY=

# Docker image repository for Minecraft servers. Override only for a private mirror
# or air-gapped registry; the panel is otherwise an itzg/minecraft-server front-end.
MC_IMAGE_REPO=itzg/minecraft-server

# Starting resource defaults for NEW servers. Leave blank to let the panel pick
# host-aware defaults (a fraction of detected host RAM, falling back to modest
# values). Override if you want a fixed starting point.
DEFAULT_HEAP_MB=
DEFAULT_CONTAINER_MEMORY_MB=
DEFAULT_DISK_QUOTA_GB=

# Port allocation scheme. Game ports are assigned from PORT_GAME_START upward
# (first free); each server's RCON host port is its game port + PORT_RCON_OFFSET;
# Bedrock/Geyser UDP is assigned from PORT_BEDROCK_START upward.
PORT_GAME_START=25565
PORT_RCON_OFFSET=1000
PORT_BEDROCK_START=19132
